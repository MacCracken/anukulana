# @public — anukulana M2: GPT-2 (HuggingFace safetensors) -> rupantara packed layout.
#
# CONVENTION (verified against rosnet linear_fwd): GPT-2 uses Conv1D — weight
# [in, out], y = x @ W — which is EXACTLY rosnet's linear_fwd layout (W[k*N+n],
# y = x@W). So weight copies are DIRECT: no transpose. (nanoGPT transposes only
# because it targets nn.Linear, which is [out, in]; rupantara is Conv1D-native.)
# The one non-trivial remap is the FUSED QKV: GPT-2 packs Q/K/V into one c_attn
# weight [C, 3C] + bias [3C]; rupantara wants separate Wq/Wk/Wv + bq/bk/bv, so we
# column-split. wte/wpe/LN/GELU/tied-head already match rupantara (learned-abs
# positions, tanh-GELU, weight-tied unembed). Params are written through
# rupantara's OWN offset helpers (_ru_o_* / _p_* / _bq..), the layout's single
# source of truth. Full-MHA (nh == nkv, Ckv == C), attn_bias = 1 (GPT-2 has biases).

# decimal itoa into buf; returns digit count.
fn _gpt2_itoa(n, buf): i64 {
    if (n == 0) { store8(buf, 48); return 1; }
    var tmp[24];
    var i = 0;
    while (n > 0) { store8(&tmp + i, (n % 10) + 48); n = n / 10; i = i + 1; }
    var j = 0;
    while (j < i) { store8(buf + j, load8(&tmp + (i - 1 - j))); j = j + 1; }
    return i;
}

# build "h.<L>.<suffix>" (null-terminated) into buf; returns buf.
fn _gpt2_name(buf, L, suffix): i64 {
    var p = 0;
    store8(buf + p, 104); p = p + 1;    # 'h'
    store8(buf + p, 46); p = p + 1;     # '.'
    p = p + _gpt2_itoa(L, buf + p);
    store8(buf + p, 46); p = p + 1;     # '.'
    var s = 0;
    while (load8(suffix + s) != 0) { store8(buf + p, load8(suffix + s)); p = p + 1; s = s + 1; }
    store8(buf + p, 0);
    return buf;
}

# ---- a tensor source: a safetensors reader or a tula reader (1.5.0) ----------
# The GPT-2 mapping reads through these four calls, so a foreign safetensors file
# and anukulana's own converted tula copy (src/convert.cyr) go through the same
# shape checks and the same wideners — which is what makes a converted file load
# bit-identical to the direct import. tula's F32/F16/BF16 payloads are the same
# IEEE little-endian encodings safetensors uses (tula ADR 0005).
# Source kind: a safetensors reader (st_open).
fn GSRC_ST(): i64 { return 0; }
# Source kind: a tula reader (tula_open_mmap / tula_read_file).
fn GSRC_TULA(): i64 { return 1; }
fn _gsrc(kind, r): i64 {
    var s = alloc(16);
    store64(s, kind);
    store64(s + 8, r);
    return s;
}
fn _gs_find(src, name): i64 {
    if (load64(src) == GSRC_TULA()) { return tula_find_name(load64(src + 8), name); }
    return st_find(load64(src + 8), name);
}
fn _gs_ndim(src, e): i64 {
    if (load64(src) == GSRC_TULA()) { return tula_entry_ndim(e); }
    return st_entry_ndim(e);
}
fn _gs_dim(src, e, k): i64 {
    if (load64(src) == GSRC_TULA()) {
        if (k < 0 || k >= tula_entry_ndim(e)) { return 0; }
        return tula_entry_dim(e, k);
    }
    return st_entry_dim(e, k);
}
fn _gs_read(src, e, start, n, dst): i64 {
    if (load64(src) == GSRC_TULA()) { return anuk_tula_read_f64_range(load64(src + 8), e, start, n, dst); }
    return st_read_f64_range(load64(src + 8), e, start, n, dst);
}

# A packed Q8_0 tensor's sidecar (1.6.1): for INT8 codes e (1-D or 2-D), the F16
# tensor named `<e's name>.scale` holding one scale per 32 codes along one axis
# (src/convert.cyr's _cv_gg_q8_pack). Its shape names the axis: [d0 / 32] for a
# vector or [d0 / 32, d1] (axis 0), or [d0, d1 / 32] (axis 1); the two can't
# coincide. Stores the axis in axis_out and returns the sidecar entry, or 0 when
# there is none, it isn't F16, or its shape is neither.
fn _anuk_q8_sidecar(r, e, axis_out): i64 {
    var nm = tula_entry_full_name(r, e);
    var n = strlen(nm);
    var sn = alloc(n + 8);
    memcpy(sn, nm, n);
    memcpy(sn + n, ".scale", 7);
    var s = tula_find_name(r, sn);
    if (s == 0) { return 0; }
    if (tula_entry_dtype(s) != TULA_DT_F16) { return 0; }
    var nd = tula_entry_ndim(e);
    if (tula_entry_ndim(s) != nd) { return 0; }
    var d0 = tula_entry_dim(e, 0);
    store64(axis_out, 0);
    if (nd == 1) {
        if (d0 % 32 == 0 && tula_entry_dim(s, 0) == d0 / 32) { return s; }
        return 0;
    }
    if (nd != 2) { return 0; }
    var d1 = tula_entry_dim(e, 1);
    if (d0 % 32 == 0 && tula_entry_dim(s, 0) == d0 / 32 && tula_entry_dim(s, 1) == d1) { return s; }
    store64(axis_out, 1);
    if (d1 % 32 == 0 && tula_entry_dim(s, 0) == d0 && tula_entry_dim(s, 1) == d1 / 32) { return s; }
    return 0;
}
# elements [start, start + n) of a packed Q8_0 tensor e -> dst: code q times its
# block's f16 scale, the product _gg_deq_q8_0 forms, so the values are exactly the
# GGUF import's. Returns 0, or -1 without a valid sidecar.
fn _anuk_q8_read(r, e, start, n, dst): i64 {
    var axc[8];
    var s = _anuk_q8_sidecar(r, e, &axc);
    if (s == 0) { return 0 - 1; }
    var axis = load64(&axc);
    var codes = tula_entry_data(r, e);
    var sc = tula_entry_data(r, s);
    var d1 = 1;
    if (tula_entry_ndim(e) == 2) { d1 = tula_entry_dim(e, 1); }
    var last = 0 - 1;
    var d = 0;
    var k = 0;
    while (k < n) {
        var f = start + k;
        var i = f / d1;
        var j = f % d1;
        var si = (i / 32) * d1 + j;                  # axis 0 (and a vector, d1 = 1)
        if (axis == 1) { si = i * (d1 / 32) + j / 32; }
        if (si != last) { d = _gg_f16(sc + si * 2); last = si; }
        var q = load8(codes + f);
        if (q >= 128) { q = q - 256; }
        store64(dst + k * 8, f64_mul(f64_from(q), d));
        k = k + 1;
    }
    return 0;
}

# Read elements [start, start + n) of tula entry e into dst as f64 (1.5.0): F64
# copied, F32 / F16 / BF16 widened by the safetensors path's bulk wideners, and
# (1.6.1) INT8 with a `.scale` sidecar decoded as packed Q8_0 (_anuk_q8_read).
# Returns 0, or -1 for a range outside the tensor or a dtype that isn't a float
# weight. The payload's length is the reader's to have checked
# (tula_validate_strict requires it to be exactly the dtype's size for the shape).
fn anuk_tula_read_f64_range(r, e, start, n, dst): i64 {
    var total = tula_entry_nelems(e);
    if (start < 0 || n < 0) { return 0 - 1; }
    if (n > total) { return 0 - 1; }
    if (start > total - n) { return 0 - 1; }
    var dt = tula_entry_dtype(e);
    var src = tula_entry_data(r, e);
    if (dt == TULA_DT_F64) { memcpy(dst, src + start * 8, n * 8); return 0; }
    if (dt == TULA_DT_F32) { _st_widen_f32(src + start * 4, dst, n); return 0; }
    if (dt == TULA_DT_F16) { _st_widen_f16(src + start * 2, dst, n); return 0; }
    if (dt == TULA_DT_BF16) { _st_widen_bf16(src + start * 2, dst, n); return 0; }
    if (dt == TULA_DT_INT8) { return _anuk_q8_read(r, e, start, n, dst); }
    return 0 - 1;
}

# 1 iff entry e has exactly the shape [d0] (d1 == 0) or [d0, d1] (1.2.2). Through
# 1.2.1 only the element count was compared, so a transposed [3C, C] c_attn.weight
# was accepted and split into garbage Q/K/V.
fn _gpt2_shape_ok(src, e, d0, d1): i64 {
    if (d1 == 0) {
        if (_gs_ndim(src, e) != 1) { return 0; }
        if (_gs_dim(src, e, 0) != d0) { return 0; }
        return 1;
    }
    if (_gs_ndim(src, e) != 2) { return 0; }
    if (_gs_dim(src, e, 0) != d0) { return 0; }
    if (_gs_dim(src, e, 1) != d1) { return 0; }
    return 1;
}
# copy tensor `name` of shape [d0] (d1 == 0) or [d0, d1] into dst, widening per
# dtype. returns 0 | -1 missing | -2 shape mismatch | -3 unsupported dtype.
fn _gpt2_copy(src, name, dst, d0, d1): i64 {
    var e = _gs_find(src, name);
    if (e == 0) { return 0 - 1; }
    if (_gpt2_shape_ok(src, e, d0, d1) == 0) { return 0 - 2; }
    var n = d0;
    if (d1 != 0) { n = d0 * d1; }
    if (_gs_read(src, e, 0, n, dst) != 0) { return 0 - 3; }
    return 0;
}
# copy the first `rows` rows of a [rows_max, cols] tensor (wpe [1024, C] -> [T, C]),
# reading only those rows (1.2.2: the whole tensor was widened into a scratch
# buffer sized from the file, then copied). Same return codes as _gpt2_copy.
fn _gpt2_copy_prefix(src, name, dst, rows, cols): i64 {
    var e = _gs_find(src, name);
    if (e == 0) { return 0 - 1; }
    if (_gs_ndim(src, e) != 2) { return 0 - 2; }
    if (_gs_dim(src, e, 1) != cols) { return 0 - 2; }   # the row width must match
    if (_gs_dim(src, e, 0) < rows) { return 0 - 2; }
    if (_gs_read(src, e, 0, rows * cols, dst) != 0) { return 0 - 3; }
    return 0;
}

# Infer V,C,T,NL from tensor shapes (nh is NOT in safetensors -> caller supplies).
# Fills cfg via ru_cfg_init(V,C,T,nh,nh,NL,4C,1). Returns 0 | -1 (missing shapes,
# or a config rupantara's ru_cfg_check rejects: C % nh != 0, a size that wraps, …).
fn anuk_gpt2_infer_cfg(r, cfg, nh): i64 {
    var ew = st_find(r, "wte.weight");
    var ep = st_find(r, "wpe.weight");
    if (ew == 0) { return 0 - 1; }
    if (ep == 0) { return 0 - 1; }
    if (st_entry_ndim(ew) != 2) { return 0 - 1; }
    var V = st_entry_dim(ew, 0);
    var C = st_entry_dim(ew, 1);
    if (st_entry_ndim(ep) != 2) { return 0 - 1; }
    if (st_entry_dim(ep, 1) != C) { return 0 - 1; }       # wpe rows are C wide
    var T = st_entry_dim(ep, 0);
    var namebuf = alloc(64);
    var NL = 0;
    var more = 1;
    while (more == 1) {
        _gpt2_name(namebuf, NL, "ln_1.weight");
        if (st_find(r, namebuf) == 0) { more = 0; }
        else { NL = NL + 1; }
    }
    ru_cfg_init(cfg, V, C, T, nh, nh, NL, 4 * C, 1);
    if (ru_cfg_check(cfg) != RU_OK()) { return 0 - 1; }   # shapes come from the file
    return 0;
}

# Pack an imported GPT-2 checkpoint into rupantara's packed `params` buffer
# (sized ru_params_count(cfg)*8). cfg must be configured (anuk_gpt2_infer_cfg).
# Returns 0, or a negative _gpt2_copy error (missing/mismatched tensor).
fn anuk_gpt2_pack(r, cfg, params): i64 { return _gpt2_pack_src(_gsrc(GSRC_ST(), r), cfg, params); }

# The pack over any tensor source with HF GPT-2's names and shapes (1.5.0: shared by
# the safetensors door and the converted-tula door).
fn _gpt2_pack_src(src, cfg, params): i64 {
    var V = _cfg_V(cfg);
    var C = _cfg_C(cfg);
    var T = _cfg_T(cfg);
    var NL = _cfg_NL(cfg);
    var F = _cfg_F(cfg);
    var rc = _gpt2_copy(src, "wte.weight", _p_tokemb(params), V, C);
    if (rc != 0) { return rc; }
    rc = _gpt2_copy_prefix(src, "wpe.weight", _p_posemb(params, cfg), T, C);
    if (rc != 0) { return rc; }
    var namebuf = alloc(64);
    var L = 0;
    while (L < NL) {
        var pblk = params + _ru_blk_base(cfg, L) * 8;
        rc = _gpt2_copy(src, _gpt2_name(namebuf, L, "ln_1.weight"), pblk + _ru_o_ln1g(cfg) * 8, C, 0);
        if (rc != 0) { return rc; }
        rc = _gpt2_copy(src, _gpt2_name(namebuf, L, "ln_1.bias"), pblk + _ru_o_ln1b(cfg) * 8, C, 0);
        if (rc != 0) { return rc; }
        rc = _gpt2_split_qkv(src, _gpt2_name(namebuf, L, "attn.c_attn.weight"),
          pblk + _ru_o_Wq(cfg) * 8, pblk + _ru_o_Wk(cfg) * 8, pblk + _ru_o_Wv(cfg) * 8, C, C);
        if (rc != 0) { return rc; }
        rc = _gpt2_split_qkv(src, _gpt2_name(namebuf, L, "attn.c_attn.bias"),
          _bq(cfg, pblk), _bk(cfg, pblk), _bv(cfg, pblk), 1, C);
        if (rc != 0) { return rc; }
        # c_proj (Wo, bo)
        rc = _gpt2_copy(src, _gpt2_name(namebuf, L, "attn.c_proj.weight"), pblk + _ru_o_Wo(cfg) * 8, C, C);
        if (rc != 0) { return rc; }
        rc = _gpt2_copy(src, _gpt2_name(namebuf, L, "attn.c_proj.bias"), _bo(cfg, pblk), C, 0);
        if (rc != 0) { return rc; }
        # ln_2
        rc = _gpt2_copy(src, _gpt2_name(namebuf, L, "ln_2.weight"), pblk + _ru_o_ln2g(cfg) * 8, C, 0);
        if (rc != 0) { return rc; }
        rc = _gpt2_copy(src, _gpt2_name(namebuf, L, "ln_2.bias"), pblk + _ru_o_ln2b(cfg) * 8, C, 0);
        if (rc != 0) { return rc; }
        # mlp
        rc = _gpt2_copy(src, _gpt2_name(namebuf, L, "mlp.c_fc.weight"), pblk + _ru_o_Wfc(cfg) * 8, C, F);
        if (rc != 0) { return rc; }
        rc = _gpt2_copy(src, _gpt2_name(namebuf, L, "mlp.c_fc.bias"), pblk + _ru_o_bfc(cfg) * 8, F, 0);
        if (rc != 0) { return rc; }
        rc = _gpt2_copy(src, _gpt2_name(namebuf, L, "mlp.c_proj.weight"), pblk + _ru_o_Wproj(cfg) * 8, F, C);
        if (rc != 0) { return rc; }
        rc = _gpt2_copy(src, _gpt2_name(namebuf, L, "mlp.c_proj.bias"), pblk + _ru_o_bproj(cfg) * 8, C, 0);
        if (rc != 0) { return rc; }
        L = L + 1;
    }
    rc = _gpt2_copy(src, "ln_f.weight", _p_lnfg(params, cfg), C, 0);
    if (rc != 0) { return rc; }
    rc = _gpt2_copy(src, "ln_f.bias", _p_lnfb(params, cfg), C, 0);
    if (rc != 0) { return rc; }
    return 0;
}

# Split a fused Q/K/V tensor straight into its three destinations (1.2.2). rows
# = C for c_attn.weight [C, 3C] (each row's columns [0,C) [C,2C) [2C,3C) go to row
# i of q/k/v, each [C, C]); rows = 1 for c_attn.bias [3C]. Each element is widened
# once, directly into place: bit-identical to the 1.2.1 copy through a [C, 3C]
# scratch, without the scratch or the second pass. Same codes as _gpt2_copy.
fn _gpt2_split_qkv(src, name, q, k, v, rows, C): i64 {
    var e = _gs_find(src, name);
    if (e == 0) { return 0 - 1; }
    var d1 = 3 * C;
    var d0 = rows;
    if (rows == 1) { d0 = 3 * C; d1 = 0; }
    if (_gpt2_shape_ok(src, e, d0, d1) == 0) { return 0 - 2; }
    var i = 0;
    while (i < rows) {
        var base = i * 3 * C;
        if (_gs_read(src, e, base, C, q + i * C * 8) != 0) { return 0 - 3; }
        if (_gs_read(src, e, base + C, C, k + i * C * 8) != 0) { return 0 - 3; }
        if (_gs_read(src, e, base + 2 * C, C, v + i * C * 8) != 0) { return 0 - 3; }
        i = i + 1;
    }
    return 0;
}

# The HF GPT-2 tensor set, in pack order (1.5.0, for the converter): entry i in
# [0, 4 + 12*NL) -> its name in namebuf and its expected dims at dims[0], dims[1]
# (dims[1] = 0 for a 1-D tensor; wpe gets the cfg's T rows). Returns 0, or -1 for
# i out of range.
fn _gpt2_spec(cfg, i, namebuf, dims): i64 {
    var C = _cfg_C(cfg);
    var F = _cfg_F(cfg);
    var NL = _cfg_NL(cfg);
    store64(dims + 8, 0);
    if (i < 0) { return 0 - 1; }
    if (i == 0) { _gpt2_lit(namebuf, "wte.weight"); store64(dims, _cfg_V(cfg)); store64(dims + 8, C); return 0; }
    if (i == 1) { _gpt2_lit(namebuf, "wpe.weight"); store64(dims, _cfg_T(cfg)); store64(dims + 8, C); return 0; }
    var j = i - 2;
    if (j < 12 * NL) {
        var L = j / 12;
        var k = j % 12;
        if (k == 0) { _gpt2_name(namebuf, L, "ln_1.weight"); store64(dims, C); }
        if (k == 1) { _gpt2_name(namebuf, L, "ln_1.bias"); store64(dims, C); }
        if (k == 2) { _gpt2_name(namebuf, L, "attn.c_attn.weight"); store64(dims, C); store64(dims + 8, 3 * C); }
        if (k == 3) { _gpt2_name(namebuf, L, "attn.c_attn.bias"); store64(dims, 3 * C); }
        if (k == 4) { _gpt2_name(namebuf, L, "attn.c_proj.weight"); store64(dims, C); store64(dims + 8, C); }
        if (k == 5) { _gpt2_name(namebuf, L, "attn.c_proj.bias"); store64(dims, C); }
        if (k == 6) { _gpt2_name(namebuf, L, "ln_2.weight"); store64(dims, C); }
        if (k == 7) { _gpt2_name(namebuf, L, "ln_2.bias"); store64(dims, C); }
        if (k == 8) { _gpt2_name(namebuf, L, "mlp.c_fc.weight"); store64(dims, C); store64(dims + 8, F); }
        if (k == 9) { _gpt2_name(namebuf, L, "mlp.c_fc.bias"); store64(dims, F); }
        if (k == 10) { _gpt2_name(namebuf, L, "mlp.c_proj.weight"); store64(dims, F); store64(dims + 8, C); }
        if (k == 11) { _gpt2_name(namebuf, L, "mlp.c_proj.bias"); store64(dims, C); }
        return 0;
    }
    j = j - 12 * NL;
    if (j == 0) { _gpt2_lit(namebuf, "ln_f.weight"); store64(dims, C); return 0; }
    if (j == 1) { _gpt2_lit(namebuf, "ln_f.bias"); store64(dims, C); return 0; }
    return 0 - 1;
}
fn _gpt2_lit(buf, s): i64 {
    var i = 0;
    while (load8(s + i) != 0) { store8(buf + i, load8(s + i)); i = i + 1; }
    store8(buf + i, 0);
    return buf;
}

# One-shot: read a GPT-2 safetensors from `path` (up to maxbytes), infer config
# (heads = nh — NOT in safetensors), OVERRIDE the context to T_run (a short window
# for a run; only pos_emb truncates, blocks are unchanged), and pack a fresh params
# buffer. T_run = 0 keeps the file's own context (1.5.1): one import then serves
# every run length through rupantara's ru_model_fwd_n(_s), with no repack per
# length. Fills cfg (caller's 64B). Returns the params ptr, or 0 on any failure.
fn anuk_gpt2_import(path, nh, T_run, cfg): i64 {
    var r = st_open_mmap(path);              # zero-copy; file is well past the alloc cap
    if (r == 0) { return 0; }
    if (anuk_gpt2_infer_cfg(r, cfg, nh) != 0) { return 0; }
    var Tc = T_run;
    if (T_run == 0) { Tc = _cfg_T(cfg); }   # the file's context (wpe rows)
    ru_cfg_init(cfg, _cfg_V(cfg), _cfg_C(cfg), Tc, nh, nh, _cfg_NL(cfg), _cfg_F(cfg), 1);
    if (ru_cfg_check(cfg) != RU_OK()) { return 0; }       # T_run re-checked
    var np = ru_params_count(cfg);
    var params = mmap_anon(np * 8);          # ~1 GB for GPT-2-small -> bypass ALLOC_MAX
    if (params == 0) { return 0; }
    if (anuk_gpt2_pack(r, cfg, params) != 0) { return 0; }
    return params;
}

# ---- run helpers shared by the CLI and the demos (1.2.2) ---------------------
# The demos' fixed input: tokens[t] = (t * 137 + 11) % V, t in [0, T).
fn _anuk_demo_tokens(T, V): i64 {
    var tokens = alloc(T * 8);
    var i = 0;
    while (i < T) { store64(tokens + i * 8, (i * 137 + 11) % V); i = i + 1; }
    return tokens;
}
# Next-token targets for `tokens`: targets[t] = tokens[t + 1], wrapping at the end.
fn _anuk_demo_targets(tokens, T): i64 {
    var targets = alloc(T * 8);
    var i = 0;
    while (i < T - 1) { store64(targets + i * 8, load64(tokens + (i + 1) * 8)); i = i + 1; }
    store64(targets + (T - 1) * 8, load64(tokens));
    return targets;
}
# The weight drift of params q from a reference p, over n values (1.6.0, for the
# quantized GGUF door). Fills out (3 cells): out[0] the max |p - q| as f64; out[1]
# the relative RMS error sqrt(sum (p - q)^2 / sum p^2) as f64, 0 when p is all
# zero; out[2] the count of NaN in q (they are left out of both sums). Returns 0.
fn anuk_weight_drift(p, q, n, out): i64 {
    var mx = f64_from(0);
    var se = f64_from(0);
    var sp = f64_from(0);
    var nan = 0;
    var i = 0;
    while (i < n) {
        var a = load64(p + i * 8);
        var b = load64(q + i * 8);
        if (f64_eq(b, b) == 0) { nan = nan + 1; }
        else {
            var d = f64_sub(a, b);
            if (f64_lt(d, f64_from(0)) == 1) { d = f64_neg(d); }
            if (f64_gt(d, mx) == 1) { mx = d; }
            se = f64_add(se, f64_mul(d, d));
            sp = f64_add(sp, f64_mul(a, a));
        }
        i = i + 1;
    }
    var rel = f64_from(0);
    if (f64_gt(sp, f64_from(0)) == 1) { rel = f64_sqrt(f64_div(se, sp)); }
    store64(out, mx);
    store64(out + 8, rel);
    store64(out + 16, nan);
    return 0;
}

# How many of the T rows of logits (T x V) have their argmax at targets[t].
fn anuk_argmax_matches(logits, targets, T, V): i64 {
    var m = 0;
    var i = 0;
    while (i < T) {
        if (ru_argmax(logits + i * V * 8, V) == load64(targets + i * 8)) { m = m + 1; }
        i = i + 1;
    }
    return m;
}

# The no-oracle validation `gpt2` and `gpt2-gguf` run: the batch forward over
# tokens[0..T) into Lb (T x V, T = the cfg's window), then the KV-cache decode one
# token at a time, each row compared bit for bit with Lb's. Returns the number of
# logits that differ, or a negative RU_ERR_* code from rupantara.
#
# Allocation-free per token: both forwards run on rupantara's `_s` entries over
# one scratch block, unmapped at the end with the KV cache. Through 1.2.1 the CLI
# decoded with the allocating ru_model_fwd_row, which never frees (rupantara's
# 2026-11-09 audit measured about 107 KB per token at GPT-2 widths), and ignored
# every return code.
fn anuk_decode_check(cfg, params, tokens, Lb): i64 {
    if (cfg == 0) { return RU_ERR_CFG(); }
    return anuk_decode_check_n(cfg, params, tokens, _cfg_T(cfg), Lb);
}

# anuk_decode_check over the first n positions of the window (1 <= n <= T), so a model
# imported at its full context checks a short run without a repack (1.5.1): the batch
# is rupantara's variable-length ru_model_fwd_n_s over tokens[0..n) into Lb (n x V),
# then the cached decode of positions 0..n-1. Returns the differing logits, or a
# negative RU_ERR_* code (RU_ERR_POS for n > T, RU_ERR_ARG for n < 1).
fn anuk_decode_check_n(cfg, params, tokens, n, Lb): i64 {
    if (cfg == 0) { return RU_ERR_CFG(); }
    var T = n;
    var V = _cfg_V(cfg);
    var nsc = ru_model_scratch_count(cfg);
    var ndc = ru_decode_scratch_count(cfg);
    var nkv = ru_decode_kv_count(cfg);
    if (nsc < 0 || ndc < 0 || nkv < 0) { return RU_ERR_CFG(); }
    var ns = nsc;
    if (ndc > ns) { ns = ndc; }
    var scratch = mmap_anon(ns * 8 + 8);         # the batch's, then the decode's
    var kv = mmap_anon(nkv * 8 + 8);
    var row = alloc(V * 8);
    var rc = RU_ERR_ARG();
    if (scratch != 0 && kv != 0 && row != 0) {
        rc = ru_model_fwd_n_s(cfg, params, tokens, n, Lb, 0, scratch);
    }
    var diffs = 0;
    var pos = 0;
    while (rc == RU_OK() && pos < T) {
        rc = ru_model_fwd_row_s(cfg, params, load64(tokens + pos * 8), pos, kv, row, scratch);
        var lrow = Lb + pos * V * 8;
        var v = 0;
        while (v < V) { if (load64(row + v * 8) != load64(lrow + v * 8)) { diffs = diffs + 1; } v = v + 1; }
        pos = pos + 1;
    }
    if (scratch != 0) { cyr_munmap(scratch, ns * 8 + 8); }
    if (kv != 0) { cyr_munmap(kv, nkv * 8 + 8); }
    if (rc != RU_OK()) { return rc; }
    return diffs;
}
