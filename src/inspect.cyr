# @public — anukulana M1: consume tula (weight-file I/O). Open a tula checkpoint,
# enumerate its tensors, and verify/report its signature. This is the Type-3
# importer's first capability — read the SOVEREIGN weight format (tula) before the
# foreign safetensors/GGUF path lands in M2. Untrusted-input safe by delegation:
# tula_read_file fully validates (bomb-guard + tula_validate) before any accessor.

# Write a NUL-terminated string to stdout.
fn _anuk_sput(s): i64 { sys_write(1, s, strlen(s)); return 0; }
# Write a NUL-terminated string to stderr (1.2.2: error messages went to stdout).
fn _anuk_eput(s): i64 { sys_write(2, s, strlen(s)); return 0; }

# The decimal text of n into buf (at least 21 bytes); returns its length. Every
# i64 is handled, INT64_MIN included: digits come from the remainder's magnitude,
# so n is never negated (1.2.2: negating INT64_MIN overflowed and only "-" was
# printed).
fn _anuk_itoa(n, buf): i64 {
    var tmp[24];
    var neg = 0;
    if (n < 0) { neg = 1; }
    var i = 0;
    if (n == 0) { store8(&tmp, 48); i = 1; }
    while (n != 0) {
        var d = n % 10;                      # sign of n, magnitude < 10
        if (d < 0) { d = 0 - d; }
        store8(&tmp + i, d + 48);
        n = n / 10;                          # truncates toward zero
        i = i + 1;
    }
    var p = 0;
    if (neg == 1) { store8(buf, 45); p = 1; }
    var j = 0;
    while (j < i) { store8(buf + p + j, load8(&tmp + (i - 1 - j))); j = j + 1; }
    return p + i;
}

# print an i64 as decimal to stdout, in one write (1.2.2: one write per digit).
fn _anuk_puti(n): i64 {
    var buf[24];
    var len = _anuk_itoa(n, &buf);
    sys_write(1, &buf, len);
    return 0;
}
# print an i64 as decimal to stderr.
fn _anuk_eput_int(n): i64 {
    var buf[24];
    var len = _anuk_itoa(n, &buf);
    sys_write(2, &buf, len);
    return 0;
}

# tula dtype int -> human name (tula has no such helper). F32/F16/BF16 are tula
# 1.3.0's (ADR 0005); through 1.2.1 they printed as "?".
fn _anuk_dtype_name(dt): i64 {
    if (dt == TULA_DT_F64) { return "f64"; }
    if (dt == TULA_DT_INT8) { return "int8"; }
    if (dt == TULA_DT_TERNARY) { return "ternary"; }
    if (dt == TULA_DT_NF4) { return "nf4"; }
    if (dt == TULA_DT_F32) { return "f32"; }
    if (dt == TULA_DT_F16) { return "f16"; }
    if (dt == TULA_DT_BF16) { return "bf16"; }
    return "?";
}

# 1 iff entry e is one of tula's own reserved tables that this reader recognizes:
# the metadata table (__tula.meta__, ADR 0008) or the long-name table
# (__tula.names__, ADR 0004). A tensor that merely has one of those names is
# ordinary (tula's rule), so recognition goes through tula itself.
fn _anuk_is_tula_table(r, e): i64 {
    var nm = tula_entry_name(e);
    if (streq(nm, "__tula.meta__") == 1 && tula_meta_count(r) > 0) { return 1; }
    if (streq(nm, "__tula.names__") == 1 && tula_has_long_names(r) != 0) { return 1; }
    return 0;
}

# enumerate the tensors in an opened+validated tula reader; returns the count.
# Names are printed in full (tula 1.3.0 long names; through 1.2.1 a long name
# printed as its 47-byte in-place key). tula's own tables are not tensors and are
# neither listed nor counted (1.4.0; the metadata table prints separately).
fn anuk_enumerate(r): i64 {
    var total = tula_count(r);
    var n = 0;
    var j = 0;
    while (j < total) { if (_anuk_is_tula_table(r, tula_entry(r, j)) == 0) { n = n + 1; } j = j + 1; }
    _anuk_sput("tensors: "); _anuk_puti(n); _anuk_sput("\n");
    var i = 0;
    while (i < total) {
        var e = tula_entry(r, i);
        if (_anuk_is_tula_table(r, e) == 1) { i = i + 1; continue; }
        _anuk_sput("  ");
        _anuk_sput(tula_entry_full_name(r, e));
        _anuk_sput("  dtype=");
        _anuk_sput(_anuk_dtype_name(tula_entry_dtype(e)));
        _anuk_sput("  shape=[");
        var nd = tula_entry_ndim(e);
        var k = 0;
        while (k < nd) {
            if (k > 0) { _anuk_sput(","); }
            _anuk_puti(tula_entry_dim(e, k));
            k = k + 1;
        }
        _anuk_sput("]  bytes=");
        _anuk_puti(tula_entry_data_len(e));
        _anuk_sput("\n");
        i = i + 1;
    }
    return n;
}

# verify a reader against a 32-byte Ed25519 public key. Returns the TulaSigStatus
# (TULA_SIG_UNSIGNED / TULA_SIG_OK / TULA_SIG_BAD) and prints a line.
fn anuk_verify(r, pk): i64 {
    var st = tula_verify(r, pk);
    if (st == TULA_SIG_OK) { _anuk_sput("signature: OK (Ed25519 verified)\n"); }
    elif (st == TULA_SIG_UNSIGNED) { _anuk_sput("signature: none\n"); }
    else { _anuk_sput("signature: BAD (rejected)\n"); }
    return st;
}

# print the file's metadata table (tula 1.6.0, ADR 0008), one "key = value" per
# pair, in key order. Returns the pair count.
fn anuk_print_meta(r): i64 {
    var n = tula_meta_count(r);
    if (n <= 0) { _anuk_sput("metadata: none\n"); return 0; }
    _anuk_sput("metadata: "); _anuk_puti(n); _anuk_sput("\n");
    var i = 0;
    while (i < n) {
        var k = tula_meta_key(r, i);
        var v = tula_meta_value(r, i);
        if (k != 0 && v != 0) {
            _anuk_sput("  "); _anuk_sput(k); _anuk_sput(" = "); _anuk_sput(v); _anuk_sput("\n");
        }
        i = i + 1;
    }
    return n;
}

# Load a public key for `inspect --pk` (1.4.0): a 32-byte file is the key itself;
# a 64-byte file is a seed||pk secret key (ifran's operator.sk) whose halves must
# agree, and its trailing 32 bytes are used. Returns the 32-byte key or 0.
fn anuk_pk_load(path): i64 {
    var buf = alloc(65);
    var n = file_read_all(path, buf, 65);
    if (n == 32) { return buf; }
    if (n == 64) {
        var sk = anuk_sk_load(path);
        if (sk == 0) { return 0; }
        return sk + 32;
    }
    return 0;
}

# open a tula file + report + enumerate. Returns tensor count, or -1 if the file
# is missing/malformed (tula_read_file returned 0 after full validation).
fn anuk_inspect(path): i64 { return anuk_inspect_pk(path, 0); }

# anuk_inspect, then (pk != 0, a 32-byte Ed25519 public key) verify the
# signature: an unsigned file fails as firmly as a bad signature. Returns the
# tensor count, -1 for a missing/malformed file, -2 for a failed verification
# (1.4.0). Any file size: the file is read into a private mapping sized from its
# header (tula_read_file_into), not the heap, whose one-allocation cap is 2 GiB.
fn anuk_inspect_pk(path, pk): i64 {
    var len = tula_file_len(path);
    var buf = 0;
    var r = 0;
    if (len > 0) { buf = mmap_anon(len); }
    if (buf != 0) { r = tula_read_file_into(path, buf, len); }
    if (r == 0) {
        if (buf != 0) { cyr_munmap(buf, len); }
        _anuk_eput("anukulana: cannot open (missing or malformed): ");
        _anuk_eput(path);
        _anuk_eput("\n");
        return 0 - 1;
    }
    _anuk_sput("tula file: "); _anuk_sput(path); _anuk_sput("\n");
    _anuk_sput("format: v"); _anuk_puti(tula_format_version(r)); _anuk_sput("\n");
    var verified = 1;
    if (pk != 0) {
        if (anuk_verify(r, pk) != TULA_SIG_OK) { verified = 0; }
    } elif (tula_is_signed(r) != 0) {
        _anuk_sput("signature: present (Ed25519) — verify with --pk <key file>\n");
    } else {
        _anuk_sput("signature: none\n");
    }
    anuk_print_meta(r);
    var n = anuk_enumerate(r);
    cyr_munmap(buf, len);
    if (verified == 0) { return 0 - 2; }
    return n;
}
