# anukulana (अनुकूलन — adaptation) — Type-3 pretrained-import reference (binary).
#
# The CLI: `inspect` opens a tula checkpoint; `gpt2*` import a real GPT-2 through
# the foreign safetensors / GGUF doors, run it on rupantara, and adapt it (LoRA,
# QLoRA, signed persistence). See docs/api.md for every command.
#
# Exit codes: 0 success; 1 a failed command or a missing argument; 2 an unknown
# command or option (1.2.2: an unknown command printed the usage and exited 0).
# Results go to stdout, errors to stderr (1.2.2: errors went to stdout).

include "src/lib.cyr"

fn _u(fd, s): i64 { sys_write(fd, s, strlen(s)); return 0; }

# Print the usage text to fd (1 when asked for, 2 after a bad command).
fn usage(fd): i64 {
    _u(fd, "anukulana - sovereign pretrained-import reference\n\n");
    _u(fd, "usage: anukulana <command> [args]\n");
    _u(fd, "  inspect <file.tula> [--pk <key>]      list tensors + metadata; --pk verifies\n");
    _u(fd, "  version               print the packed version int\n");
    _u(fd, "  gpt2 <model.safetensors>              import + run (no-oracle validation)\n");
    _u(fd, "  gpt2-oracle <model.safetensors> <fixture.bin>   HF-fidelity gate\n");
    _u(fd, "  gpt2-lora <model.safetensors>         LoRA head-adapter fine-tune (frozen base)\n");
    _u(fd, "  gpt2-qlora <model.safetensors>        QLoRA: adapter over the NF4-quantized base\n");
    _u(fd, "  gpt2-tula <model> <ckpt.tula> <adapter.tula> [--sk <operator.sk>]\n");
    _u(fd, "                                        signed NF4 + adapter round-trip\n");
    _u(fd, "                                        (--sk: sign with a real 64B operator key\n");
    _u(fd, "                                         — e.g. ifran's ~/.ifran/operator.sk)\n");
    _u(fd, "  gpt2-gguf <model.gguf>                import via GGUF + run (batch==decode gate)\n");
    _u(fd, "  gpt2-cross <model.safetensors> <model.gguf>   cross-format bit-identity gate\n");
    _u(fd, "  gpt2-qgguf <reference> <quantized.gguf>\n");
    _u(fd, "                                        Q4_0..Q8_0 GGUF: batch==decode gate + drift report\n");
    _u(fd, "  convert <model.{safetensors,gguf}> <out.tula> [--sk <operator.sk>]\n");
    _u(fd, "                                        signed tula copy at source precision (self-checked)\n");
    _u(fd, "  gpt2-load <model.tula> [--pk <key>]   run from a converted file (batch==decode gate)\n");
    _u(fd, "  (all Type-3 charter commands built)\n");
    return 0;
}

# `gpt2` / `gpt2-gguf` after the import: report the model, then run the batch
# forward against the KV-cache incremental decode (they must be bit-identical) on
# a short fixed input. Proves the importer + wideners + mapping on a real model.
# (Exact HF-reference-logit match is the separate `gpt2-oracle` gate.) One copy
# for both doors (1.2.2: two near-identical copies). The model is imported at its
# full context and the check runs the first T_run positions (1.5.1: rupantara 0.6's
# variable-length forward; through 1.5.0 the import repacked for T_run).
fn _anuk_run_check(label, cfg, params, T_run): i64 {
    var V = _cfg_V(cfg);
    # weight sanity: are the widened params finite? (localizes NaN: weights vs forward)
    var np = ru_params_count(cfg);
    var nanp = 0;
    var j = 0;
    while (j < np) { var xx = load64(params + j * 8); if (f64_eq(xx, xx) == 0) { nanp = nanp + 1; } j = j + 1; }
    _anuk_sput("params with NaN: "); _anuk_puti(nanp); _anuk_sput(" / "); _anuk_puti(np); _anuk_sput("\n");
    _anuk_sput("imported GPT-2 ("); _anuk_sput(label); _anuk_sput("): V="); _anuk_puti(V);
    _anuk_sput(" C="); _anuk_puti(_cfg_C(cfg));
    _anuk_sput(" NL="); _anuk_puti(_cfg_NL(cfg));
    _anuk_sput(" heads="); _anuk_puti(_cfg_nh(cfg));
    _anuk_sput(" T_run="); _anuk_puti(T_run);
    _anuk_sput(" (context "); _anuk_puti(_cfg_T(cfg)); _anuk_sput(")\n");
    var tokens = _anuk_demo_tokens(T_run, V);
    var Lb = alloc(T_run * V * 8);
    var diffs = anuk_decode_check_n(cfg, params, tokens, T_run, Lb);
    if (diffs < 0) {
        _anuk_eput("forward rejected the input (rupantara code "); _anuk_eput_int(diffs); _anuk_eput(")\n");
        return 1;
    }
    _anuk_sput("batch forward vs KV-cache decode: logit diffs="); _anuk_puti(diffs); _anuk_sput("\n");
    var last = Lb + (T_run - 1) * V * 8;
    var am = ru_argmax(last, V);
    _anuk_sput("next-token argmax (last pos): id="); _anuk_puti(am); _anuk_sput("\n");
    var mx = load64(last + am * 8);
    if (f64_eq(mx, mx) == 0) {
        # (ganita's f64_tanh used to overflow to NaN here for |x| > ~709; it has
        # saturated since the 6.3.31 pin — issue 2026-07-02 is closed.)
        _anuk_sput("logits: NaN — FAIL (see params with NaN above)\n");
        return 1;
    }
    _anuk_sput("logits finite: OK\n");
    if (diffs == 0) {
        _anuk_sput("RESULT: GPT-2 imported via "); _anuk_sput(label);
        _anuk_sput(" + ran; batch==decode bit-identical\n");
        return 0;
    }
    _anuk_sput("RESULT: ran, but batch != decode — investigate\n");
    return 1;
}

# `gpt2 <model.safetensors>` — import a real GPT-2-small checkpoint (12 heads;
# safetensors doesn't carry them) and run the batch-vs-decode check.
fn _gpt2_run(path): i64 {
    var cfg = alloc(64);
    var params = anuk_gpt2_import(path, 12, 0, cfg);       # mmap (past alloc cap); full context
    if (params == 0) { _anuk_eput("gpt2: import failed (open / infer / pack)\n"); return 1; }
    return _anuk_run_check("safetensors", cfg, params, 8);
}

# `gpt2-gguf <model.gguf>` — the same check through the GGUF door (KV-driven
# config, blk.N.* mapping, transpose-back).
fn _ggpt2_run(path): i64 {
    var cfg = alloc(64);
    var params = anuk_ggpt2_import(path, 0, cfg);           # full context
    if (params == 0) { _anuk_eput("gpt2-gguf: import failed (open / infer / pack)\n"); return 1; }
    return _anuk_run_check("GGUF", cfg, params, 8);
}

# `gpt2-cross <model.safetensors> <model.gguf>` — THE cross-format gate: the
# same checkpoint imported through both foreign doors must land on IDENTICAL
# packed params (both fp32 sources widen deterministically) and hence identical
# logits. Any orientation/naming/widening slip in either mapping shows here. Both
# import at the file's full context (1.5.1), so the params check covers every
# position row, and the logits run the first T_run positions (ru_model_fwd_n).
fn _gpt2_cross(st_path, gg_path): i64 {
    var cfgA = alloc(64);
    var T_run = 8;
    var pA = anuk_gpt2_import(st_path, 12, 0, cfgA);
    if (pA == 0) { _anuk_eput("gpt2-cross: safetensors import failed\n"); return 1; }
    var cfgB = alloc(64);
    var pB = anuk_ggpt2_import(gg_path, 0, cfgB);
    if (pB == 0) { _anuk_eput("gpt2-cross: gguf import failed\n"); return 1; }
    # every field (1.2.2: nh and T weren't compared, so a GGUF with other heads
    # passed the params check and only failed later, on logits)
    var k = 0;
    while (k < 8) {
        if (load64(cfgA + k * 8) != load64(cfgB + k * 8)) {
            _anuk_eput("gpt2-cross: config mismatch at field "); _anuk_eput_int(k); _anuk_eput("\n");
            return 1;
        }
        k = k + 1;
    }
    var np = ru_params_count(cfgA);
    var pdiffs = 0;
    var i = 0;
    while (i < np) { if (load64(pA + i * 8) != load64(pB + i * 8)) { pdiffs = pdiffs + 1; } i = i + 1; }
    _anuk_sput("packed params: "); _anuk_puti(np);
    _anuk_sput(" total, diffs="); _anuk_puti(pdiffs); _anuk_sput("\n");
    var V = _cfg_V(cfgA);
    var tokens = _anuk_demo_tokens(T_run, V);
    var LA = alloc(T_run * V * 8);
    var LB = alloc(T_run * V * 8);
    var ra = ru_model_fwd_n(cfgA, pA, tokens, T_run, LA, 0);
    var rb = ru_model_fwd_n(cfgB, pB, tokens, T_run, LB, 0);
    if (ra != RU_OK() || rb != RU_OK()) {
        _anuk_eput("gpt2-cross: forward rejected the input\n");
        return 1;
    }
    var ldiffs = 0;
    i = 0;
    while (i < T_run * V) { if (load64(LA + i * 8) != load64(LB + i * 8)) { ldiffs = ldiffs + 1; } i = i + 1; }
    _anuk_sput("logits ("); _anuk_puti(T_run * V);
    _anuk_sput("): diffs="); _anuk_puti(ldiffs); _anuk_sput("\n");
    if (pdiffs == 0 && ldiffs == 0) {
        _anuk_sput("RESULT: cross-format BIT-IDENTICAL (safetensors == GGUF)\n");
        return 0;
    }
    _anuk_sput("RESULT: cross-format mismatch — investigate\n");
    return 1;
}

# `gpt2-qgguf <reference> <quantized.gguf>` (1.6.0): a llama.cpp-quantized GPT-2
# against the unquantized import of the same checkpoint (the reference: HF
# safetensors, heads from a config.json beside it, or an F32 / F16 GGUF).
#   Gates: both import at the full context with the same config; the quantized file
#   holds at least one block-typed tensor; its import is NaN-free; its batch ==
#   decode is bit-identical; and its weights are closer to the reference than zero
#   is (relative RMS error < 1; scrambled codes land near sqrt 2).
#   Reported, not gated (as gpt2-qlora reports NF4): the tensor types, the weight
#   error, the logit drift and the argmax agreement over T_run = 8 positions.
fn _anuk_qgguf(ref_path, q_path): i64 {
    var r = gg_open_mmap(q_path);
    if (r == 0) { _anuk_eput("gpt2-qgguf: cannot open the quantized GGUF\n"); return 1; }
    var counts = alloc(32 * 8);                 # per ggml type id (gg_open admits < 32)
    var i = 0;
    while (i < 32) { store64(counts + i * 8, 0); i = i + 1; }
    var nq = 0;
    i = 0;
    while (i < gg_count(r)) {
        var t = gg_entry_gtype(gg_entry(r, i));
        store64(counts + t * 8, load64(counts + t * 8) + 1);
        nq = nq + gg_type_is_quant(t);
        i = i + 1;
    }
    _anuk_sput("quantized GGUF: "); _anuk_puti(gg_count(r)); _anuk_sput(" tensors:");
    var t2 = 0;
    while (t2 < 32) {
        if (load64(counts + t2 * 8) > 0) {
            _anuk_sput(" "); _anuk_sput(gg_type_name(t2)); _anuk_sput(" x"); _anuk_puti(load64(counts + t2 * 8));
        }
        t2 = t2 + 1;
    }
    _anuk_sput("\n");
    cyr_munmap(load64(r), load64(r + 8));
    if (nq == 0) { _anuk_eput("gpt2-qgguf: no block-typed tensor (use gpt2-gguf or gpt2-cross)\n"); return 1; }
    var cfgQ = alloc(64);
    var pQ = anuk_ggpt2_import(q_path, 0, cfgQ);
    if (pQ == 0) { _anuk_eput("gpt2-qgguf: quantized import failed (open / infer / pack)\n"); return 1; }
    var head = alloc(16);
    var hn = file_read_all(ref_path, head, 16);
    if (hn <= 0) { _anuk_eput("gpt2-qgguf: cannot read "); _anuk_eput(ref_path); _anuk_eput("\n"); return 1; }
    var cfgR = alloc(64);
    var pR = 0;
    if (streq(_nfs_sniff(head, hn), "gguf") == 1) {
        _anuk_sput("reference: GGUF\n");
        pR = anuk_ggpt2_import(ref_path, 0, cfgR);
    } else {
        var nh = anuk_hf_n_head(_cv_hf_config(ref_path), 12);
        _anuk_sput("reference: safetensors, heads "); _anuk_puti(nh); _anuk_sput("\n");
        pR = anuk_gpt2_import(ref_path, nh, 0, cfgR);
    }
    if (pR == 0) { _anuk_eput("gpt2-qgguf: reference import failed\n"); return 1; }
    var k = 0;
    while (k < 8) {
        if (load64(cfgR + k * 8) != load64(cfgQ + k * 8)) {
            _anuk_eput("gpt2-qgguf: config mismatch at field "); _anuk_eput_int(k); _anuk_eput("\n");
            return 1;
        }
        k = k + 1;
    }
    var np = ru_params_count(cfgQ);
    var wd = alloc(24);
    anuk_weight_drift(pR, pQ, np, wd);
    _anuk_sput("weights vs reference: params "); _anuk_puti(np);
    _anuk_sput(", max |dW| "); fmt_float(load64(wd), 6);
    _anuk_sput(", relative RMS "); fmt_float(load64(wd + 8), 6);
    _anuk_sput(", NaN "); _anuk_puti(load64(wd + 16)); _anuk_sput("\n");
    var T_run = 8;
    var V = _cfg_V(cfgQ);
    var tokens = _anuk_demo_tokens(T_run, V);
    var LQ = alloc(T_run * V * 8);
    var diffs = anuk_decode_check_n(cfgQ, pQ, tokens, T_run, LQ);
    if (diffs < 0) {
        _anuk_eput("forward rejected the input (rupantara code "); _anuk_eput_int(diffs); _anuk_eput(")\n");
        return 1;
    }
    _anuk_sput("batch forward vs KV-cache decode (quantized): logit diffs="); _anuk_puti(diffs); _anuk_sput("\n");
    var LR = alloc(T_run * V * 8);
    if (ru_model_fwd_n(cfgR, pR, tokens, T_run, LR, 0) != RU_OK()) {
        _anuk_eput("gpt2-qgguf: reference forward rejected the input\n");
        return 1;
    }
    var lmax = f64_from(0);
    var lnan = 0;
    i = 0;
    while (i < T_run * V) {
        var lq = load64(LQ + i * 8);
        if (f64_eq(lq, lq) == 0) { lnan = lnan + 1; }
        else {
            var d = f64_sub(load64(LR + i * 8), lq);
            if (f64_lt(d, f64_from(0)) == 1) { d = f64_neg(d); }
            if (f64_gt(d, lmax) == 1) { lmax = d; }
        }
        i = i + 1;
    }
    var agree = 0;
    i = 0;
    while (i < T_run) {
        if (ru_argmax(LQ + i * V * 8, V) == ru_argmax(LR + i * V * 8, V)) { agree = agree + 1; }
        i = i + 1;
    }
    _anuk_sput("logits vs reference (T_run=8): maxabs "); fmt_float(lmax, 4);
    _anuk_sput(", NaN "); _anuk_puti(lnan);
    _anuk_sput(", argmax agreement "); _anuk_puti(agree); _anuk_sput("/8\n");
    var ok = 1;
    if (load64(wd + 16) != 0 || lnan != 0) { _anuk_sput("FAIL: NaN in the quantized import or its logits\n"); ok = 0; }
    if (diffs != 0) { _anuk_sput("FAIL: batch != decode on the quantized import\n"); ok = 0; }
    if (f64_lt(load64(wd + 8), f64_from(1)) == 0) {
        _anuk_sput("FAIL: relative RMS error >= 1 (no closer to the reference than zero)\n");
        ok = 0;
    }
    if (ok == 1) {
        _anuk_sput("RESULT: quantized GGUF imported + ran; batch==decode bit-identical; drift reported\n");
        return 0;
    }
    return 1;
}

# The signing key for convert: the operator key at sk_path, or the demo key when
# sk_path is 0. Writes the 64-byte sk into sk_out's cell and pk (sk + 32) into
# pk_out's. Returns 0, or -1 for an unusable key file.
fn _anuk_signing_key(sk_path, sk_out, pk_out): i64 {
    if (sk_path != 0) {
        var sk = anuk_sk_load(sk_path);
        if (sk == 0) { return 0 - 1; }
        store64(sk_out, sk);
        store64(pk_out, sk + 32);
        _anuk_sput("signing with operator key: "); _anuk_sput(sk_path); _anuk_sput("\n");
        return 0;
    }
    var dsk = alloc(64);
    var dpk = alloc(32);
    anuk_demo_keypair(dsk, dpk);
    store64(sk_out, dsk);
    store64(pk_out, dpk);
    _anuk_sput("signing with the demo key (integrity only; pass --sk for an operator key)\n");
    return 0;
}

# `convert <model.{safetensors,gguf}> <out.tula> [--sk <operator.sk>]` (1.5.0): write
# the model as a signed tula file at its source precision, then reload that file
# and require its packed params bit-identical to a direct import of the source.
fn _anuk_convert(src, out, sk_path): i64 {
    var skc = alloc(8);
    var pkc = alloc(8);
    if (_anuk_signing_key(sk_path, skc, pkc) != 0) {
        _anuk_eput("convert: cannot use operator key (need exactly 64 B, seed||pk): ");
        _anuk_eput(sk_path); _anuk_eput("\n");
        return 1;
    }
    var head = alloc(16);
    var hn = file_read_all(src, head, 16);
    if (hn <= 0) { _anuk_eput("convert: cannot read "); _anuk_eput(src); _anuk_eput("\n"); return 1; }
    var gguf = streq(_nfs_sniff(head, hn), "gguf");
    var nh = 0;
    var rc = 0;
    var dq = 0;                                     # the source's block types (1.6.0)
    if (gguf == 1) {
        var gr = gg_open_mmap(src);
        if (gr != 0) {
            var gi = 0;
            while (gi < gg_count(gr)) {
                var gt = gg_entry_gtype(gg_entry(gr, gi));
                if (gg_type_is_quant(gt) == 1) { dq = dq | (1 << gt); }
                gi = gi + 1;
            }
            cyr_munmap(load64(gr), load64(gr + 8));
        }
        _anuk_sput("source: GGUF");
        if (dq != 0) {
            _anuk_sput(", block types "); _anuk_sput(_cv_quant_list(dq)); _anuk_sput(" dequantized exactly to F32");
        }
        _anuk_sput("\n");
        rc = anuk_convert_gguf(src, out, load64(skc));
    } else {
        var hf = _cv_hf_config(src);
        nh = anuk_hf_n_head(hf, 12);
        _anuk_sput("source: safetensors, heads "); _anuk_puti(nh);
        if (hf != 0) { _anuk_sput(" (config.json n_head)\n"); } else { _anuk_sput(" (no config.json: GPT-2's 12)\n"); }
        rc = anuk_convert_safetensors(src, nh, out, load64(skc));
    }
    if (rc != 0) { _anuk_eput("convert: failed (a tensor missing or misshapen, or the write failed)\n"); return 1; }
    _anuk_sput("converted: "); _anuk_sput(out); _anuk_sput("\n");
    # self-check: the converted file loads onto exactly the directly imported params,
    # both at the full context (1.5.1: every position row compared; it was 8)
    var T_run = 0;
    var cfgA = alloc(64);
    var pA = 0;
    if (gguf == 1) { pA = anuk_ggpt2_import(src, T_run, cfgA); } else { pA = anuk_gpt2_import(src, nh, T_run, cfgA); }
    var cfgB = alloc(64);
    var pB = anuk_tula_import(out, load64(pkc), T_run, cfgB);
    if (pA == 0 || pB == 0) { _anuk_eput("convert: self-check import failed\n"); return 1; }
    var k = 0;
    while (k < 8) {
        if (load64(cfgA + k * 8) != load64(cfgB + k * 8)) {
            _anuk_eput("convert: config mismatch at field "); _anuk_eput_int(k); _anuk_eput("\n");
            return 1;
        }
        k = k + 1;
    }
    var np = ru_params_count(cfgA);
    var diffs = 0;
    var i = 0;
    while (i < np) { if (load64(pA + i * 8) != load64(pB + i * 8)) { diffs = diffs + 1; } i = i + 1; }
    _anuk_sput("reloaded vs direct import: params "); _anuk_puti(np);
    _anuk_sput(", diffs="); _anuk_puti(diffs); _anuk_sput("\n");
    if (diffs == 0) {
        if (dq != 0) {
            _anuk_sput("RESULT: converted (block types as their exact F32 values), signed; ");
        } else {
            _anuk_sput("RESULT: converted at source precision, signed; ");
        }
        _anuk_sput("reload BIT-IDENTICAL to the direct import\n");
        return 0;
    }
    _anuk_sput("RESULT: convert mismatch — investigate\n");
    return 1;
}

# `gpt2-load <model.tula> [--pk <key file>]` (1.5.0): import a converted file
# (signature verified) and run the batch-vs-decode check.
fn _anuk_load_run(path, pk_path): i64 {
    var pk = 0;
    if (pk_path != 0) {
        pk = anuk_pk_load(pk_path);
        if (pk == 0) {
            _anuk_eput("gpt2-load: --pk: not a 32-byte public key or a consistent 64-byte seed||pk\n");
            return 1;
        }
    } else {
        var dsk = alloc(64);
        pk = alloc(32);
        anuk_demo_keypair(dsk, pk);
        _anuk_sput("verifying with the demo key (pass --pk for an operator key)\n");
    }
    var cfg = alloc(64);
    var params = anuk_tula_import(path, pk, 0, cfg);       # full context
    if (params == 0) { _anuk_eput("gpt2-load: import failed\n"); return 1; }
    return _anuk_run_check("converted tula", cfg, params, 8);
}

# 1 iff the command has at least `n` argv entries; otherwise prints `msg` to
# stderr and returns 0.
fn _need(n, msg): i64 {
    if (argc() >= n) { return 1; }
    _anuk_eput(msg);
    return 0;
}

# Dispatch argv(1) to a command; returns the process exit code.
fn main(): i64 {
    alloc_init();
    args_init();
    if (argc() < 2) { usage(1); return 0; }
    var cmd = argv(1);
    if (streq(cmd, "help") == 1 || streq(cmd, "--help") == 1 || streq(cmd, "-h") == 1) { usage(1); return 0; }
    if (streq(cmd, "inspect") == 1) {
        if (_need(3, "anukulana: inspect needs a <file.tula> [--pk <key file>]\n") == 0) { return 1; }
        var pk = 0;
        if (argc() >= 4) {
            if (streq(argv(3), "--pk") == 0 || argc() > 5) {
                _anuk_eput("anukulana: inspect: unknown option (only --pk <key file>)\n");
                return 2;
            }
            if (_need(5, "anukulana: --pk needs a <key file> (32-byte public key or 64-byte seed||pk)\n") == 0) {
                return 1;
            }
            pk = anuk_pk_load(argv(4));
            if (pk == 0) {
                _anuk_eput("anukulana: --pk: not a 32-byte public key or a consistent 64-byte seed||pk: ");
                _anuk_eput(argv(4)); _anuk_eput("\n");
                return 1;
            }
        }
        if (anuk_inspect_pk(argv(2), pk) < 0) { return 1; }
        return 0;
    }
    if (streq(cmd, "version") == 1) {
        _anuk_puti(anukulana_version());
        _anuk_sput("\n");
        return 0;
    }
    if (streq(cmd, "gpt2") == 1) {
        if (_need(3, "anukulana: gpt2 needs a <model.safetensors>\n") == 0) { return 1; }
        return _gpt2_run(argv(2));
    }
    if (streq(cmd, "gpt2-oracle") == 1) {
        if (_need(4, "anukulana: gpt2-oracle needs <model.safetensors> <fixture.bin>\n") == 0) { return 1; }
        return anuk_gpt2_oracle(argv(2), argv(3));
    }
    if (streq(cmd, "gpt2-lora") == 1) {
        if (_need(3, "anukulana: gpt2-lora needs a <model.safetensors>\n") == 0) { return 1; }
        return anuk_gpt2_lora(argv(2));
    }
    if (streq(cmd, "gpt2-qlora") == 1) {
        if (_need(3, "anukulana: gpt2-qlora needs a <model.safetensors>\n") == 0) { return 1; }
        return anuk_gpt2_qlora(argv(2));
    }
    if (streq(cmd, "gpt2-gguf") == 1) {
        if (_need(3, "anukulana: gpt2-gguf needs a <model.gguf>\n") == 0) { return 1; }
        return _ggpt2_run(argv(2));
    }
    if (streq(cmd, "gpt2-cross") == 1) {
        if (_need(4, "anukulana: gpt2-cross needs <model.safetensors> <model.gguf>\n") == 0) { return 1; }
        return _gpt2_cross(argv(2), argv(3));
    }
    if (streq(cmd, "gpt2-qgguf") == 1) {
        if (_need(4, "anukulana: gpt2-qgguf needs <reference model> <quantized.gguf>\n") == 0) { return 1; }
        return _anuk_qgguf(argv(2), argv(3));
    }
    if (streq(cmd, "convert") == 1) {
        if (_need(4, "anukulana: convert needs <model.{safetensors,gguf}> <out.tula> [--sk <key>]\n") == 0) {
            return 1;
        }
        var csk = 0;
        if (argc() >= 5) {
            if (streq(argv(4), "--sk") == 0 || argc() > 6) {
                _anuk_eput("anukulana: convert: unknown option (only --sk <operator.sk>)\n");
                return 2;
            }
            if (_need(6, "anukulana: --sk needs a <operator.sk> path\n") == 0) { return 1; }
            csk = argv(5);
        }
        return _anuk_convert(argv(2), argv(3), csk);
    }
    if (streq(cmd, "gpt2-load") == 1) {
        if (_need(3, "anukulana: gpt2-load needs a <model.tula> [--pk <key file>]\n") == 0) { return 1; }
        var lpk = 0;
        if (argc() >= 4) {
            if (streq(argv(3), "--pk") == 0 || argc() > 5) {
                _anuk_eput("anukulana: gpt2-load: unknown option (only --pk <key file>)\n");
                return 2;
            }
            if (_need(5, "anukulana: --pk needs a <key file>\n") == 0) { return 1; }
            lpk = argv(4);
        }
        return _anuk_load_run(argv(2), lpk);
    }
    if (streq(cmd, "gpt2-tula") == 1) {
        var e1 = "anukulana: gpt2-tula needs <model.safetensors> <ckpt.tula> <adapter.tula>";
        if (argc() < 5) { _anuk_eput(e1); _anuk_eput(" [--sk <key>]\n"); return 1; }
        var sk_path = 0;
        if (argc() >= 6) {
            # 1.2.2: anything but `--sk <path>` here was silently ignored
            if (streq(argv(5), "--sk") == 0 || argc() > 7) {
                _anuk_eput("anukulana: gpt2-tula: unknown option (only --sk <operator.sk>)\n");
                return 2;
            }
            if (_need(7, "anukulana: --sk needs a <operator.sk> path\n") == 0) { return 1; }
            sk_path = argv(6);
        }
        return anuk_gpt2_tula(argv(2), argv(3), argv(4), sk_path);
    }
    _anuk_eput("anukulana: unknown command: "); _anuk_eput(cmd); _anuk_eput("\n\n");
    usage(2);
    return 2;
}

var exit_code = main();
sys_exit(exit_code);
