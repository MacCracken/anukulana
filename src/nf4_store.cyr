# @public — M4 tail: NF4-checkpoint + LoRA-adapter persistence via tula.
#
# The "quantize once, ship the 62 MB artifact" step: the NF4-quantized base and
# the trained adapter each serialize to a sigil-signed `.tula` file (tula's
# frozen v1 format — TULA_DT_NF4 codes + the ADR-0002 "<name>.scale" sidecar
# convention, here double-quantized as INT8 codes + F64 superblock maxes).
# tula owns the codec + container; sigil owns the crypto; this module only
# assembles tensors and names. Round-trips are gated BIT-IDENTICAL (quantized
# data is discrete — nothing may drift on disk).
#
# Checkpoint layout (names ≤ 47 chars):
#   "cfg"                 F64  [8]    V,C,T,nh,nkv,NL,F,attn_bias — as f64_from ints
#   "base.nf4"            NF4  [np]   packed codes (2/byte)
#   "base.nf4.scale.q8"   INT8 [nb]   double-quantized per-block scales (0..127)
#   "base.nf4.scale.sup"  F64  [nsb]  per-superblock scale absmax
#   (1.4.0) metadata: anukulana.kind = "nf4-checkpoint", .version, .layout,
#   .config (JSON), .nf4, and with anuk_nf4_save_src .source.{name,bytes,format,sha256}
# Adapter layout:
#   "lora.A"    F64 [C,r]   ·   "lora.B"    F64 [r,V]   ·
#   "lora.meta" F64 [2] = (s, r)
#   (1.4.0) metadata: anukulana.kind = "lora-adapter", .version, .adapter (JSON),
#   and with anuk_adapter_save_src .base.{name,bytes,format,sha256}
#
# Loading (1.2.2): a file is accepted only if it passes tula's strict validator
# (every payload exactly its dtype x shape, no duplicate names, canonical layout),
# its Ed25519 signature verifies, and every tensor read has exactly the dtype and
# shape above. Through 1.2.1 only the dims of some tensors were compared, so a
# signed file with a 1-element "lora.meta", an INT8 "lora.A" or a short
# "base.nf4.scale.sup" was read past its payload.

fn _nfs_shp1(a): i64 { var s = alloc(8); store64(s, a); return s; }
fn _nfs_shp2(a, b): i64 { var s = alloc(16); store64(s, a); store64(s + 8, b); return s; }

# The entry `name` if it has exactly `dtype` and shape [d0] (d1 < 0) or [d0, d1];
# d0 < 0 accepts any length for a rank-1 tensor. Otherwise 0. Looked up by full
# name (1.4.0, tula_find_name), so it can never match a long-named entry's key.
fn _nfs_tensor(r, name, dtype, d0, d1): i64 {
    var e = tula_find_name(r, name);
    if (e == 0) { return 0; }
    if (tula_entry_dtype(e) != dtype) { return 0; }
    if (d1 < 0) {
        if (tula_entry_ndim(e) != 1) { return 0; }
        if (d0 >= 0) { if (tula_entry_dim(e, 0) != d0) { return 0; } }
        return e;
    }
    if (tula_entry_ndim(e) != 2) { return 0; }
    if (tula_entry_dim(e, 0) != d0) { return 0; }
    if (tula_entry_dim(e, 1) != d1) { return 0; }
    return e;
}

# Open-time checks shared by both loaders: strict structure, then the signature.
# Returns 0 when the reader may be used, else -1 (with a message).
fn _nfs_check(r, pk, who): i64 {
    if (tula_validate_strict(r, tula_total_len(r)) != TULA_OK) {
        _anuk_eput(who); _anuk_eput(": strict validation failed\n");
        return 0 - 1;
    }
    # tula_verify_required (1.4.0): an unsigned file is rejected as firmly as a
    # bad signature (the earlier `!= TULA_SIG_OK` check did the same, implicitly)
    if (tula_verify_required(r, pk) != TULA_OK) {
        _anuk_eput(who); _anuk_eput(": signature REJECTED\n");
        return 0 - 1;
    }
    return 0;
}

# ---- signed file metadata (1.4.0; tula 1.6.0, ADR 0008) ----------------------
# Every file anukulana writes carries `anukulana.*` keys in tula's metadata
# table, signed with the tensors: what it is, which anukulana wrote it, the
# packed layout and its config, and (the _src savers) the file it came from with
# its SHA-256. Values are derived from the inputs only — no timestamps — so a
# file stays a pure function of what was saved, as tula intends. Readers keep
# using the "cfg" tensor; the metadata describes, it doesn't steer.

# "major.minor.patch" of anukulana_version().
fn _nfs_version_str(): i64 {
    var v = anukulana_version();
    var sb = str_builder_new();
    str_builder_add_int(sb, v / 10000);
    str_builder_add_cstr(sb, ".");
    str_builder_add_int(sb, (v / 100) % 100);
    str_builder_add_cstr(sb, ".");
    str_builder_add_int(sb, v % 100);
    return str_cstr(str_builder_build(sb));
}

fn _nfs_json_int(sb, key, v, first): i64 {
    if (first == 0) { str_builder_add_cstr(sb, ","); }
    str_builder_add_cstr(sb, "\"");
    str_builder_add_cstr(sb, key);
    str_builder_add_cstr(sb, "\":");
    str_builder_add_int(sb, v);
    return 0;
}

# The config as one-line JSON: {"V":…,"C":…,"T":…,"nh":…,"nkv":…,"NL":…,"F":…,"attn_bias":…}.
fn _nfs_cfg_json(cfg): i64 {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{");
    _nfs_json_int(sb, "V", _cfg_V(cfg), 1);
    _nfs_json_int(sb, "C", _cfg_C(cfg), 0);
    _nfs_json_int(sb, "T", _cfg_T(cfg), 0);
    _nfs_json_int(sb, "nh", _cfg_nh(cfg), 0);
    _nfs_json_int(sb, "nkv", _cfg_nkv(cfg), 0);
    _nfs_json_int(sb, "NL", _cfg_NL(cfg), 0);
    _nfs_json_int(sb, "F", _cfg_F(cfg), 0);
    _nfs_json_int(sb, "attn_bias", _cfg_bias(cfg), 0);
    str_builder_add_cstr(sb, "}");
    return str_cstr(str_builder_build(sb));
}

# The keys every anukulana file carries. Returns 0, or a TULA_ERR_* code.
fn _nfs_common_meta(b, kind): i64 {
    var rc = tula_builder_set_meta(b, "anukulana.kind", kind);
    if (rc == 0) { rc = tula_builder_set_meta(b, "anukulana.version", _nfs_version_str()); }
    return rc;
}

# What a file at the start of `addr` (size bytes) looks like: "gguf", "tula",
# "safetensors" (a u64 header length that fits, then '{'), or "unknown".
fn _nfs_sniff(addr, size): i64 {
    if (size >= 4) { if ((load32(addr) & 0xFFFFFFFF) == 0x46554747) { return "gguf"; } }
    if (size >= 8) {
        if (load64(addr) == TULA_MAGIC) { return "tula"; }
        var hlen = load64(addr);
        if (size > 8 && hlen > 0 && hlen <= size - 8) { if (load8(addr + 8) == 123) { return "safetensors"; } }
    }
    return "unknown";
}

# Record the file at `path` as <prefix>.name (its basename), <prefix>.bytes,
# <prefix>.format and <prefix>.sha256. The file is mapped read-only and hashed
# with sigil's SHA-256 (about 1.7 s for a 548 MB checkpoint). Returns 0 or -1.
fn _nfs_file_meta(b, prefix, path): i64 {
    var fd = file_open(path, 0, 0);
    if (fd < 0) { return 0 - 1; }
    var size = xlseek(fd, 0, 2);
    if (size <= 0) { file_close(fd); return 0 - 1; }
    var addr = mmap_file_ro(fd, size);
    file_close(fd);
    if (addr == 0) { return 0 - 1; }
    var digest = sha256_hex(addr, size);
    var format = _nfs_sniff(addr, size);
    cyr_munmap(addr, size);
    var base = path;
    var i = 0;
    while (load8(path + i) != 0) { if (load8(path + i) == 47) { base = path + i + 1; } i = i + 1; }
    var nb = str_builder_new();
    str_builder_add_int(nb, size);
    var rc = _nfs_meta_kv(b, prefix, ".name", base);
    if (rc == 0) { rc = _nfs_meta_kv(b, prefix, ".bytes", str_cstr(str_builder_build(nb))); }
    if (rc == 0) { rc = _nfs_meta_kv(b, prefix, ".format", format); }
    if (rc == 0) { rc = _nfs_meta_kv(b, prefix, ".sha256", digest); }
    if (rc != 0) { return 0 - 1; }
    return 0;
}
fn _nfs_meta_kv(b, prefix, suffix, value): i64 {
    var kb = str_builder_new();
    str_builder_add_cstr(kb, prefix);
    str_builder_add_cstr(kb, suffix);
    return tula_builder_set_meta(b, str_cstr(str_builder_build(kb)), value);
}

# ---- save the NF4-quantized base as a signed .tula --------------------------
# Quantizes params(np f64) through the FULL pipeline (tula NF4 pack -> local
# double-quant) and writes a signed checkpoint. Returns 0, or -1 on any failure
# (1.2.2: including a cfg rupantara rejects). The quantization buffers are
# unmapped before returning. 1.4.0: the file also carries the metadata above
# (kind "nf4-checkpoint", version, layout, config, the NF4 parameters); see
# anuk_nf4_save_src to record the source model too.
fn anuk_nf4_save(path, cfg, params, sk): i64 { return anuk_nf4_save_src(path, cfg, params, sk, 0); }

# anuk_nf4_save, also recording the model file the params were imported from
# (`src_path`; 0 for none) as anukulana.source.{name,bytes,format,sha256}
# (1.4.0). Every tensor goes through tula's checked add, and the file is
# streamed to disk and signed by tula's crash-safe writer (no 2 GiB cap).
fn anuk_nf4_save_src(path, cfg, params, sk, src_path): i64 {
    if (ru_cfg_check(cfg) != RU_OK()) { return 0 - 1; }
    var np = ru_params_count(cfg);
    var bs = NF4_BS();
    var nb = tula_nf4_blocks(np, bs);
    var nsb = (nb + NF4_SBS() - 1) / NF4_SBS();
    var nbytes = tula_nf4_bytes(np);
    var nibbles = mmap_anon(nbytes);
    var scales = mmap_anon(nb * 8);
    var q8 = mmap_anon(nb);
    var rc = 0 - 1;
    if (nibbles != 0 && scales != 0 && q8 != 0) {
        tula_nf4_pack(params, np, bs, scales, nibbles);
        var supers = t_alloc(nsb);
        nf4_dq_pack(scales, nb, q8, supers);
        var cfgv = t_alloc(8);
        store64(cfgv + 0 * 8, f64_from(_cfg_V(cfg)));
        store64(cfgv + 1 * 8, f64_from(_cfg_C(cfg)));
        store64(cfgv + 2 * 8, f64_from(_cfg_T(cfg)));
        store64(cfgv + 3 * 8, f64_from(_cfg_nh(cfg)));
        store64(cfgv + 4 * 8, f64_from(_cfg_nkv(cfg)));
        store64(cfgv + 5 * 8, f64_from(_cfg_NL(cfg)));
        store64(cfgv + 6 * 8, f64_from(_cfg_F(cfg)));
        store64(cfgv + 7 * 8, f64_from(_cfg_bias(cfg)));
        var b = tula_builder_new();
        # checked adds (1.4.0): a bad shape or name fails here instead of being
        # truncated, and every return is checked (through 1.3.0 none was)
        var e = tula_builder_add_checked(b, "cfg", TULA_DT_F64, _nfs_shp1(8), 1, cfgv, 64);
        if (e == 0) { e = tula_builder_add_checked(b, "base.nf4", TULA_DT_NF4, _nfs_shp1(np), 1, nibbles, nbytes); }
        if (e == 0) { e = tula_builder_add_checked(b, "base.nf4.scale.q8", TULA_DT_INT8, _nfs_shp1(nb), 1, q8, nb); }
        if (e == 0) {
            e = tula_builder_add_checked(b, "base.nf4.scale.sup", TULA_DT_F64, _nfs_shp1(nsb), 1, supers, nsb * 8);
        }
        if (e == 0) { e = _nfs_common_meta(b, "nf4-checkpoint"); }
        if (e == 0) { e = tula_builder_set_meta(b, "anukulana.layout", "rupantara-gpt2"); }
        if (e == 0) { e = tula_builder_set_meta(b, "anukulana.config", _nfs_cfg_json(cfg)); }
        if (e == 0) {
            e = tula_builder_set_meta(b, "anukulana.nf4",
              "{\"block\":64,\"superblock\":256,\"scales\":\"int8 codes + f64 superblock absmax\"}");
        }
        if (e == 0 && src_path != 0) { e = _nfs_file_meta(b, "anukulana.source", src_path); }
        # streamed and signed by tula (1.4.0): no in-memory copy of the file, so no
        # 2 GiB cap, and crash-safe (built in a temp, renamed into place)
        if (e == 0) { if (tula_builder_write_file_signed(b, path, sk) > 0) { rc = 0; } }
    }
    if (nibbles != 0) { cyr_munmap(nibbles, nbytes); }
    if (scales != 0) { cyr_munmap(scales, nb * 8); }
    if (q8 != 0) { cyr_munmap(q8, nb); }
    return rc;
}

# ---- load + verify an NF4 checkpoint -----------------------------------------
# Opens (validated, strict), verifies the Ed25519 signature against pk (REJECTS
# unsigned or bad — the trust boundary), reconstructs cfg, and dequantizes the
# base into a fresh mmap_anon f64 buffer. Returns the params ptr, or 0 on any
# failure. The file's mapping is released before returning (1.2.2: it was kept
# for the life of the process).
fn anuk_nf4_load(path, pk, cfg_out): i64 {
    var r = tula_open_mmap(path);
    if (r == 0) { _anuk_eput("nf4-load: open/validate failed\n"); return 0; }
    var params = _nfs_load_base(r, pk, cfg_out);
    tula_close_mmap(r);
    return params;
}

fn _nfs_load_base(r, pk, cfg_out): i64 {
    if (_nfs_check(r, pk, "nf4-load") != 0) { return 0; }
    var ec = _nfs_tensor(r, "cfg", TULA_DT_F64, 8, 0 - 1);
    if (ec == 0) { _anuk_eput("nf4-load: no F64 [8] cfg tensor\n"); return 0; }
    var cv = tula_entry_data(r, ec);
    ru_cfg_init(cfg_out, f64_to(load64(cv)), f64_to(load64(cv + 8)), f64_to(load64(cv + 16)),
      f64_to(load64(cv + 24)), f64_to(load64(cv + 32)), f64_to(load64(cv + 40)),
      f64_to(load64(cv + 48)), f64_to(load64(cv + 56)));
    # Reject a cfg rupantara can't represent before anything is sized from it. From
    # rupantara 0.5.2 ru_params_count returns RU_ERR_CFG (-1) for one, so the np
    # check below would also catch it; this names the fault and doesn't lean on
    # that. Through 0.5.1, nh = 0 here divided by zero inside ru_params_count.
    if (ru_cfg_check(cfg_out) != RU_OK()) { _anuk_eput("nf4-load: bad cfg\n"); return 0; }
    var np = ru_params_count(cfg_out);
    var nb = tula_nf4_blocks(np, NF4_BS());
    var nsb = (nb + NF4_SBS() - 1) / NF4_SBS();
    var eb = _nfs_tensor(r, "base.nf4", TULA_DT_NF4, np, 0 - 1);
    var eq = _nfs_tensor(r, "base.nf4.scale.q8", TULA_DT_INT8, nb, 0 - 1);
    var es = _nfs_tensor(r, "base.nf4.scale.sup", TULA_DT_F64, nsb, 0 - 1);
    if (eb == 0 || eq == 0 || es == 0) {
        _anuk_eput("nf4-load: base tensors missing or not the cfg's dtype/shape\n");
        return 0;
    }
    var scales = mmap_anon(nb * 8);
    if (scales == 0) { return 0; }
    nf4_dq_unpack(tula_entry_data(r, eq), tula_entry_data(r, es), nb, scales);
    var params = mmap_anon(np * 8);
    if (params != 0) { tula_nf4_unpack(tula_entry_data(r, eb), scales, np, NF4_BS(), params); }
    cyr_munmap(scales, nb * 8);
    return params;
}

# ---- adapter save / load ------------------------------------------------------
# Write the adapter (A [C,r], B [r,V], meta (s, r)) as a signed .tula. Returns 0
# or -1. 1.4.0: checked adds, tula's streaming signed writer, and metadata (kind
# "lora-adapter", version, the adapter's shape); see anuk_adapter_save_src.
fn anuk_adapter_save(path, A, B, C, r, V, s, sk): i64 {
    return anuk_adapter_save_src(path, A, B, C, r, V, s, sk, 0);
}

# anuk_adapter_save, also recording the checkpoint the adapter was trained over
# (`base_path`; 0 for none) as anukulana.base.{name,bytes,format,sha256} (1.4.0),
# which ties the adapter to the exact base it adapts.
fn anuk_adapter_save_src(path, A, B, C, r, V, s, sk, base_path): i64 {
    var meta = t_alloc(2);
    store64(meta, s);
    store64(meta + 8, f64_from(r));
    var b = tula_builder_new();
    var e = tula_builder_add_checked(b, "lora.A", TULA_DT_F64, _nfs_shp2(C, r), 2, A, C * r * 8);
    if (e == 0) { e = tula_builder_add_checked(b, "lora.B", TULA_DT_F64, _nfs_shp2(r, V), 2, B, r * V * 8); }
    if (e == 0) { e = tula_builder_add_checked(b, "lora.meta", TULA_DT_F64, _nfs_shp1(2), 1, meta, 16); }
    if (e == 0) { e = _nfs_common_meta(b, "lora-adapter"); }
    if (e == 0) {
        var sb = str_builder_new();
        str_builder_add_cstr(sb, "{");
        _nfs_json_int(sb, "C", C, 1);
        _nfs_json_int(sb, "r", r, 0);
        _nfs_json_int(sb, "V", V, 0);
        str_builder_add_cstr(sb, ",\"target\":\"lm_head\"}");
        e = tula_builder_set_meta(b, "anukulana.adapter", str_cstr(str_builder_build(sb)));
    }
    if (e == 0 && base_path != 0) { e = _nfs_file_meta(b, "anukulana.base", base_path); }
    if (e != 0) { return 0 - 1; }
    if (tula_builder_write_file_signed(b, path, sk) <= 0) { return 0 - 1; }
    return 0;
}

# Loads + verifies an adapter; writes A/B into caller buffers (sized C*r / r*V)
# and returns the packed (s in out_s[0], r in out_s[1] as f64 bits). 0 = ok, -1 =
# fail: unsigned / bad signature, not strictly valid, a tensor missing or not
# exactly F64 of the expected shape, or a meta r that isn't the caller's r.
fn anuk_adapter_load(path, pk, A_out, B_out, C, r, V, out_s): i64 {
    var rd = tula_read_file(path);
    if (rd == 0) { _anuk_eput("adapter-load: open/validate failed\n"); return 0 - 1; }
    if (_nfs_check(rd, pk, "adapter-load") != 0) { return 0 - 1; }
    var ea = _nfs_tensor(rd, "lora.A", TULA_DT_F64, C, r);
    var eb = _nfs_tensor(rd, "lora.B", TULA_DT_F64, r, V);
    var em = _nfs_tensor(rd, "lora.meta", TULA_DT_F64, 2, 0 - 1);
    if (ea == 0 || eb == 0 || em == 0) {
        _anuk_eput("adapter-load: tensors missing or not the expected dtype/shape\n");
        return 0 - 1;
    }
    var mv = tula_entry_data(rd, em);
    if (f64_to(load64(mv + 8)) != r) { _anuk_eput("adapter-load: meta rank mismatch\n"); return 0 - 1; }
    t_copy(A_out, tula_entry_data(rd, ea), C * r);
    t_copy(B_out, tula_entry_data(rd, eb), r * V);
    store64(out_s, load64(mv));
    store64(out_s + 8, load64(mv + 8));
    return 0;
}

# ---- the demo signing key (1.5.0: shared by gpt2-tula and convert) -----------
# The deterministic keypair the demos sign with when no --sk is given. Its seed is
# in this source, so its signatures prove a file is intact, never who wrote it:
# for authenticity pass a real operator key (--sk).
fn anuk_demo_keypair(sk, pk): i64 {
    var seed = alloc(32);
    var i = 0;
    while (i < 32) { store8(seed + i, (i * 7 + 41) & 0xFF); i = i + 1; }
    ed25519_keypair(seed, sk, pk);
    return 0;
}

# ---- operator-key loading (ifran Lane 2) --------------------------------------
# Load a 64 B Ed25519 secret key file — sigil's `ed25519_keypair` sk layout
# (seed||pk), which is exactly what ifran writes as `~/.ifran/operator.sk`.
# The public key is the trailing 32 bytes (`sk + 32`). Returns sk ptr | 0. Key
# management stays the caller's per tula's charter — this just lets the caller
# BE the operator instead of an ephemeral demo key.
#
# 1.2.2: the file must be exactly 64 bytes (a longer one — a PEM file, say — was
# accepted and its first 64 bytes used), and its trailing 32 bytes must be the
# public key derived from its seed. A file whose halves disagree used to load,
# then sign with a key no verifier would accept.
fn anuk_sk_load(path): i64 {
    var sk = alloc(65);
    if (file_read_all(path, sk, 65) != 64) { return 0; }
    var sk2 = alloc(64);
    var pk2 = alloc(32);
    ed25519_keypair(sk, sk2, pk2);
    var ok = memeq(pk2, sk + 32, 32);
    memset(sk2, 0, 64);                      # a copy of the secret: don't leave it behind
    if (ok != 1) { memset(sk, 0, 65); return 0; }
    return sk;
}
