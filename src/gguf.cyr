# @public — GGUF parser (the SECOND foreign source, post-1.0 headline).
# llama.cpp's format: little-endian, versions 2/3 —
#
#   u32 magic "GGUF" (0x46554747) | u32 version | u64 n_tensors | u64 n_kv
#   n_kv × KV:      string key (u64 len + bytes) | u32 vtype | value
#   n_tensors × TI: string name | u32 n_dims | u64 dims[n_dims] (ne-order:
#                   dims[0] = INNERMOST/fastest) | u32 ggml_type | u64 offset
#                   (relative to the ALIGNED data section)
#   data section:   starts at align(header_end, alignment); each tensor at its
#                   aligned offset. alignment = KV "general.alignment" (u32,
#                   default 32).
#
# UNTRUSTED INPUT — the audit's standing guidance applies throughout: every
# length/offset checked wrap-safe BEFORE use, allocations sized from foreign
# data null-checked, malformed/truncated/overrun → clean 0 (fuzz-gated in
# tests/tcyr/fuzz.tcyr, same cut). Value types are SKIPPED structurally when
# not consumed (arrays included), so unknown metadata never breaks the walk —
# but an UNKNOWN vtype id is a hard reject (its size is unknowable).
#
# Supported tensor dtypes: F32 (0) and F16 (1), widened to f64 by the same
# IEEE-754 wideners the safetensors path uses; (1.6.0) llama.cpp's legacy block
# types Q4_0 (2), Q4_1 (3), Q5_0 (6), Q5_1 (7) and Q8_0 (8); and (1.6.1) its
# K-quants Q2_K (10) through Q6_K (14). Each is dequantized to exactly the values
# ggml's own f32 dequantization gives (see the decoders below). gg_open rejects
# every other type id (Q8_K, the IQ and TQ types, MXFP4, BF16, ...).
#
# Reader record (heap): +0 buf | +8 len | +16 data_start | +24 count
#   +32 entries (count × 128: name_ptr name_len ndim dims[4] gtype off nbytes)
#   | +40 kv_count | +48 kv_index (kv_count × 32: key_ptr key_len vtype val_off)

# The GGUF magic: the bytes "GGUF" read as a little-endian u32.
fn GGUF_MAGIC(): i64 { return 0x46554747; }
# Cap on one tensor's element count (2^29, about 2 GB of F32).
fn GG_MAX_ELEMS(): i64 { return 536870912; }

# ---- little-endian readers (bounds are the CALLER's duty inside the parser) --
fn _gg_u32(buf, off): i64 { return load32(buf + off) & 0xFFFFFFFF; }
fn _gg_u64(buf, off): i64 { return load64(buf + off); }

# value-type byte sizes; -1 = variable (string/array), -2 = unknown
fn _gg_vtype_size(t): i64 {
    if (t == 0) { return 1; }     # u8
    if (t == 1) { return 1; }     # i8
    if (t == 2) { return 2; }     # u16
    if (t == 3) { return 2; }     # i16
    if (t == 4) { return 4; }     # u32
    if (t == 5) { return 4; }     # i32
    if (t == 6) { return 4; }     # f32
    if (t == 7) { return 1; }     # bool
    if (t == 8) { return 0 - 1; } # string
    if (t == 9) { return 0 - 1; } # array
    if (t == 10) { return 8; }    # u64
    if (t == 11) { return 8; }    # i64
    if (t == 12) { return 8; }    # f64
    return 0 - 2;
}

# skip one value of type t at off; returns the new offset, or -1 on breach.
# len-guarded at every read (wrap-safe: all quantities checked before adding).
fn _gg_skip_value(buf, len, off, t): i64 {
    var sz = _gg_vtype_size(t);
    if (sz == (0 - 2)) { return 0 - 1; }
    if (sz >= 0) {
        if (off > len - sz) { return 0 - 1; }
        return off + sz;
    }
    if (t == 8) {                                    # string: u64 len + bytes
        if (off > len - 8) { return 0 - 1; }
        var sl = _gg_u64(buf, off);
        if (sl < 0) { return 0 - 1; }
        if (sl > len - (off + 8)) { return 0 - 1; }
        return off + 8 + sl;
    }
    # array: u32 elem type + u64 count + elems
    if (off > len - 12) { return 0 - 1; }
    var et = _gg_u32(buf, off);
    var n = _gg_u64(buf, off + 4);
    if (n < 0) { return 0 - 1; }
    var o = off + 12;
    var esz = _gg_vtype_size(et);
    if (esz == (0 - 2)) { return 0 - 1; }
    if (esz > 0) {                                   # fixed-size elems (1/2/4/8 B)
        if (n > (len - o) / esz) { return 0 - 1; }
        return o + n * esz;
    }
    # array of strings/arrays: skip one-by-one (bounded by len each step)
    var i = 0;
    while (i < n) {
        o = _gg_skip_value(buf, len, o, et);
        if (o < 0) { return 0 - 1; }
        i = i + 1;
    }
    return o;
}

# ggml type ids (ggml.h's GGML_TYPE_*) of the supported tensor dtypes.
fn GG_T_F32(): i64 { return 0; }
# GGML_TYPE_F16.
fn GG_T_F16(): i64 { return 1; }
# GGML_TYPE_Q4_0: 32 weights per 18-byte block, y = (q - 8) * d.
fn GG_T_Q4_0(): i64 { return 2; }
# GGML_TYPE_Q4_1: 32 weights per 20-byte block, y = q * d + m.
fn GG_T_Q4_1(): i64 { return 3; }
# GGML_TYPE_Q5_0: 32 weights per 22-byte block, y = (q - 16) * d.
fn GG_T_Q5_0(): i64 { return 6; }
# GGML_TYPE_Q5_1: 32 weights per 24-byte block, y = q * d + m.
fn GG_T_Q5_1(): i64 { return 7; }
# GGML_TYPE_Q8_0: 32 weights per 34-byte block, y = q * d.
fn GG_T_Q8_0(): i64 { return 8; }
# GGML_TYPE_Q2_K: 256 weights per 84-byte superblock, 2-bit codes, 4-bit scales and mins.
fn GG_T_Q2_K(): i64 { return 10; }
# GGML_TYPE_Q3_K: 256 weights per 110-byte superblock, 3-bit codes, 6-bit scales.
fn GG_T_Q3_K(): i64 { return 11; }
# GGML_TYPE_Q4_K: 256 weights per 144-byte superblock, 4-bit codes, 6-bit scales and mins.
fn GG_T_Q4_K(): i64 { return 12; }
# GGML_TYPE_Q5_K: 256 weights per 176-byte superblock, 5-bit codes, 6-bit scales and mins.
fn GG_T_Q5_K(): i64 { return 13; }
# GGML_TYPE_Q6_K: 256 weights per 210-byte superblock, 6-bit codes, 8-bit scales.
fn GG_T_Q6_K(): i64 { return 14; }

# ggml type -> elements per block (1 for F32 / F16); -1 = unsupported
fn _gg_blk_elems(t): i64 {
    if (t == 0 || t == 1) { return 1; }
    if (t == 2 || t == 3 || t == 6 || t == 7 || t == 8) { return 32; }
    if (t >= 10 && t <= 14) { return 256; }                 # the K-quants (Q8_K, 15, is not stored)
    return 0 - 1;
}
# ggml type -> bytes per block; -1 = unsupported
fn _gg_blk_bytes(t): i64 {
    if (t == 0) { return 4; }     # F32
    if (t == 1) { return 2; }     # F16
    if (t == 2) { return 18; }    # Q4_0: f16 d, 16 B of nibbles
    if (t == 3) { return 20; }    # Q4_1: f16 d, f16 m, 16 B of nibbles
    if (t == 6) { return 22; }    # Q5_0: f16 d, u32 high bits, 16 B of nibbles
    if (t == 7) { return 24; }    # Q5_1: f16 d, f16 m, u32 high bits, 16 B of nibbles
    if (t == 8) { return 34; }    # Q8_0: f16 d, 32 int8
    if (t == 10) { return 84; }   # Q2_K: scales[16], qs[64], f16 d, f16 dmin
    if (t == 11) { return 110; }  # Q3_K: hmask[32], qs[64], scales[12], f16 d
    if (t == 12) { return 144; }  # Q4_K: f16 d, f16 dmin, scales[12], qs[128]
    if (t == 13) { return 176; }  # Q5_K: f16 d, f16 dmin, scales[12], qh[32], qs[128]
    if (t == 14) { return 210; }  # Q6_K: ql[128], qh[64], int8 scales[16], f16 d
    return 0 - 1;
}

# The name of a ggml type id ("F32", "Q8_0", ...), or "?" for one gg_open rejects.
fn gg_type_name(t): i64 {
    if (t == 0) { return "F32"; }
    if (t == 1) { return "F16"; }
    if (t == 2) { return "Q4_0"; }
    if (t == 3) { return "Q4_1"; }
    if (t == 6) { return "Q5_0"; }
    if (t == 7) { return "Q5_1"; }
    if (t == 8) { return "Q8_0"; }
    if (t == 10) { return "Q2_K"; }
    if (t == 11) { return "Q3_K"; }
    if (t == 12) { return "Q4_K"; }
    if (t == 13) { return "Q5_K"; }
    if (t == 14) { return "Q6_K"; }
    return "?";
}
# 1 iff t is one of the block (quantized) types gg_open accepts.
fn gg_type_is_quant(t): i64 {
    if (_gg_blk_elems(t) > 1) { return 1; }
    return 0;
}

# ---- entry accessors (entry = 128B) -----------------------------------------
# Number of tensors in reader r.
fn gg_count(r): i64 { return load64(r + 24); }
# Entry record i (0 <= i < gg_count(r)).
fn gg_entry(r, i): i64 { return load64(r + 32) + i * 128; }
# The tensor's name: a pointer into the file, NOT NUL-terminated (see _len).
fn gg_entry_name(e): i64 { return load64(e); }
# Length of the tensor's name in bytes.
fn gg_entry_name_len(e): i64 { return load64(e + 8); }
# The tensor's rank, 1..4.
fn gg_entry_ndim(e): i64 { return load64(e + 16); }
# Dim k in ne-order (0 = innermost), or 0 for k outside [0, ndim).
fn gg_entry_dim(e, k): i64 {
    if (k < 0) { return 0; }
    if (k >= gg_entry_ndim(e)) { return 0; }
    return load64(e + 24 + k * 8);
}
# The tensor's ggml type id: F32, F16 or (1.6.0) one of the five legacy block
# types (GG_T_*); gg_open rejects any other.
fn gg_entry_gtype(e): i64 { return load64(e + 56); }
# The payload's length in bytes, which gg_open checks lies inside the data
# section (1.6.0): nelems x 4 or 2, or blocks x block bytes.
fn gg_entry_nbytes(e): i64 { return load64(e + 72); }
# Element count: the product of the dims. gg_open checks it stays within
# GG_MAX_ELEMS without wrapping.
fn gg_entry_nelems(e): i64 {
    var n = 1;
    var k = 0;
    while (k < gg_entry_ndim(e)) { n = n * load64(e + 24 + k * 8); k = k + 1; }
    return n;
}
# Pointer to the tensor's payload (its extent is validated by gg_open).
fn gg_entry_data(r, e): i64 { return load64(r) + load64(r + 16) + load64(e + 64); }

# Find the first tensor named `name` (a cstring); returns its entry or 0.
fn gg_find(r, name): i64 {
    var nl = strlen(name);
    var i = 0;
    while (i < gg_count(r)) {
        var e = gg_entry(r, i);
        if (gg_entry_name_len(e) == nl) {
            var same = 1;
            var j = 0;
            while (j < nl) {
                if (load8(gg_entry_name(e) + j) != load8(name + j)) { same = 0; j = nl; }
                j = j + 1;
            }
            if (same == 1) { return e; }
        }
        i = i + 1;
    }
    return 0;
}

# ---- KV metadata lookups ------------------------------------------------------
fn _gg_kv(r, i): i64 { return load64(r + 48) + i * 32; }
fn _gg_kv_count(r): i64 { return load64(r + 40); }

fn _gg_kv_find(r, key): i64 {
    var kl = strlen(key);
    var i = 0;
    while (i < _gg_kv_count(r)) {
        var kv = _gg_kv(r, i);
        if (load64(kv + 8) == kl) {
            var same = 1;
            var j = 0;
            while (j < kl) {
                if (load8(load64(kv) + j) != load8(key + j)) { same = 0; j = kl; }
                j = j + 1;
            }
            if (same == 1) { return kv; }
        }
        i = i + 1;
    }
    return 0;
}

# read an integer-valued KV (u8..u64/i64/bool) by key; `found` (i64 cell) set
# 1/0. Returns the value (0 when absent). Each value is read at its own width
# (1.2.2: a u16/i16 was read with a 4-byte load, 2 bytes past a value that ends
# the buffer) and the signed types i8/i16/i32 are sign-extended (they read as
# unsigned through 1.2.1, so i32 -1 came back as 4294967295).
fn gg_kv_int(r, key, found): i64 {
    store64(found, 0);
    var kv = _gg_kv_find(r, key);
    if (kv == 0) { return 0; }
    var t = load64(kv + 16);
    var buf = load64(r);
    var off = load64(kv + 24);
    var v = 0;
    if (t == 0) { v = load8(buf + off); }
    elif (t == 1) {
        v = load8(buf + off);
        if (v >= 128) { v = v - 256; }
    }
    elif (t == 2) { v = load8(buf + off) | (load8(buf + off + 1) << 8); }
    elif (t == 3) {
        v = load8(buf + off) | (load8(buf + off + 1) << 8);
        if (v >= 32768) { v = v - 65536; }
    }
    elif (t == 4) { v = _gg_u32(buf, off); }
    elif (t == 5) {
        v = _gg_u32(buf, off);
        if (v >= 2147483648) { v = v - 4294967296; }
    }
    elif (t == 7) { v = load8(buf + off); }
    elif (t == 10) { v = _gg_u64(buf, off); }
    elif (t == 11) { v = _gg_u64(buf, off); }
    else { return 0; }
    store64(found, 1);
    return v;
}

# read a string KV: returns ptr into buf, length via out_len; 0 = absent/not-string
fn gg_kv_str(r, key, out_len): i64 {
    var kv = _gg_kv_find(r, key);
    if (kv == 0) { return 0; }
    if (load64(kv + 16) != 8) { return 0; }
    var buf = load64(r);
    var off = load64(kv + 24);
    store64(out_len, _gg_u64(buf, off));
    return buf + off + 8;
}

# ---- open (untrusted) ---------------------------------------------------------
# Returns a reader, or 0 on any structural breach.
fn gg_open(buf, len): i64 {
    if (len < 24) { return 0; }
    if (_gg_u32(buf, 0) != GGUF_MAGIC()) { return 0; }
    var version = _gg_u32(buf, 4);
    if (version < 2) { return 0; }
    if (version > 3) { return 0; }
    var n_tensors = _gg_u64(buf, 8);
    var n_kv = _gg_u64(buf, 16);
    if (n_tensors < 0) { return 0; }
    if (n_tensors > 65536) { return 0; }             # sanity cap (GPT-2 has 148)
    if (n_kv < 0) { return 0; }
    if (n_kv > 65536) { return 0; }
    var kv_index = alloc(n_kv * 32 + 8);
    if (kv_index == 0) { return 0; }
    var off = 24;
    var alignment = 32;
    var i = 0;
    while (i < n_kv) {
        # key string
        if (off > len - 8) { return 0; }
        var kl = _gg_u64(buf, off);
        if (kl < 0) { return 0; }
        if (kl > len - (off + 8)) { return 0; }
        var kptr = buf + off + 8;
        off = off + 8 + kl;
        # value type + value
        if (off > len - 4) { return 0; }
        var vt = _gg_u32(buf, off);
        off = off + 4;
        var kv = kv_index + i * 32;
        store64(kv, kptr);
        store64(kv + 8, kl);
        store64(kv + 16, vt);
        store64(kv + 24, off);
        off = _gg_skip_value(buf, len, off, vt);
        if (off < 0) { return 0; }
        i = i + 1;
    }
    var entries = alloc(n_tensors * 128 + 8);
    if (entries == 0) { return 0; }
    i = 0;
    while (i < n_tensors) {
        var e = entries + i * 128;
        if (off > len - 8) { return 0; }
        var nl = _gg_u64(buf, off);
        if (nl < 0) { return 0; }
        if (nl > 256) { return 0; }                  # tensor names are short
        if (nl > len - (off + 8)) { return 0; }
        store64(e, buf + off + 8);
        store64(e + 8, nl);
        off = off + 8 + nl;
        if (off > len - 4) { return 0; }
        var nd = _gg_u32(buf, off);
        off = off + 4;
        if (nd < 1) { return 0; }
        if (nd > 4) { return 0; }
        store64(e + 16, nd);
        var k = 0;
        while (k < nd) {
            if (off > len - 8) { return 0; }
            var d = _gg_u64(buf, off);
            if (d < 1) { return 0; }
            if (d > 1073741824) { return 0; }        # 2^30 per-dim sanity cap
            store64(e + 24 + k * 8, d);
            off = off + 8;
            k = k + 1;
        }
        if (off > len - 12) { return 0; }
        store64(e + 56, _gg_u32(buf, off));          # ggml_type
        store64(e + 64, _gg_u64(buf, off + 4));      # data offset (validated below)
        off = off + 12;
        i = i + 1;
    }
    # alignment (default 32; KV overrides) — must be a power of two 8..65536
    var r = alloc(64);
    if (r == 0) { return 0; }
    store64(r, buf);
    store64(r + 8, len);
    store64(r + 24, n_tensors);
    store64(r + 32, entries);
    store64(r + 40, n_kv);
    store64(r + 48, kv_index);
    var fnd = alloc(8);
    var av = gg_kv_int(r, "general.alignment", fnd);
    if (load64(fnd) == 1) { alignment = av; }
    if (alignment < 8) { return 0; }
    if (alignment > 65536) { return 0; }
    if ((alignment & (alignment - 1)) != 0) { return 0; }
    var data_start = off + (alignment - (off % alignment)) % alignment;
    if (data_start > len) { return 0; }
    store64(r + 16, data_start);
    var data_len = len - data_start;
    # validate every tensor's extent within the data section
    i = 0;
    while (i < n_tensors) {
        var e2 = entries + i * 128;
        var be = _gg_blk_elems(load64(e2 + 56));
        if (be < 0) { return 0; }                    # unknown or K-quant dtype
        # a block never straddles two rows (ggml's rule): ne0 is whole blocks
        if (load64(e2 + 24) % be != 0) { return 0; }
        # element count, checked at every step: 4 dims of up to 2^30 can multiply
        # past 2^64 (dims [4,27905,429509837,384773] wrapped to 4 through 1.2.1)
        var ne = 1;
        var k2 = 0;
        while (k2 < load64(e2 + 16)) {
            var d2 = load64(e2 + 24 + k2 * 8);
            if (ne > GG_MAX_ELEMS() / d2) { return 0; }   # d2 >= 1 (checked above)
            ne = ne * d2;
            k2 = k2 + 1;
        }
        var nb = (ne / be) * _gg_blk_bytes(load64(e2 + 56));   # <= 2^29 x 4: no wrap
        var o2 = load64(e2 + 64);
        if (o2 < 0) { return 0; }
        if (o2 > data_len) { return 0; }
        if (nb > data_len - o2) { return 0; }
        store64(e2 + 72, nb);
        i = i + 1;
    }
    return r;
}

# ---- the legacy block types (1.6.0) ---------------------------------------------
# ggml-quants.c's dequantize_row_*, one 32-weight block at a time. Every block opens
# with an f16 scale d; the _1 types follow it with an f16 minimum m. The 4-bit codes
# are packed two per byte: byte j holds weight j in its low nibble and weight j + 16
# in its high one. Q5_* keep each code's fifth bit in a little-endian u32 qh: bit j
# for weight j and bit j + 16 for weight j + 16.
#
#   Q8_0  y = q * d          (q an int8)
#   Q4_0  y = (q - 8) * d    Q5_0  y = (q - 16) * d
#   Q4_1  y = q * d + m      Q5_1  y = q * d + m
#
# The values are exactly ggml's, which computes in f32. A product q * d is exact in
# f32 (an 11-bit f16 significand times a code of at most 8 bits) and in f64: the _0
# types need no rounding step. Adding m rounds in f32, so the _1 types round the
# f64 sum to f32 (f32_from); one f64 rounding then one f32 rounding equals ggml's
# single f32 rounding because 53 >= 2 * 24 + 2. Held by tests/tcyr/gguf.tcyr against
# gguf-py's dequantize (tests/fixtures/gguf_qblocks_v1.gguf).

# the f16 at p as f64
fn _gg_f16(p): i64 { return _st_f16_to_f64(load8(p) | (load8(p + 1) << 8)); }
# x rounded to f32 precision, as f64
fn _gg_f32r(x): i64 { return f32_to(f32_from(x)); }

# one Q8_0 block at blk -> 32 f64 at out
fn _gg_deq_q8_0(blk, out): i64 {
    var d = _gg_f16(blk);
    var j = 0;
    while (j < 32) {
        var q = load8(blk + 2 + j);
        if (q >= 128) { q = q - 256; }
        store64(out + j * 8, f64_mul(f64_from(q), d));
        j = j + 1;
    }
    return 0;
}
# one Q4_0 (t = 2) or Q4_1 (t = 3) block
fn _gg_deq_q4(t, blk, out): i64 {
    var d = _gg_f16(blk);
    if (t == 2) {
        var j = 0;
        while (j < 16) {
            var b = load8(blk + 2 + j);
            store64(out + j * 8, f64_mul(f64_from((b & 15) - 8), d));
            store64(out + (j + 16) * 8, f64_mul(f64_from((b >> 4) - 8), d));
            j = j + 1;
        }
        return 0;
    }
    var m = _gg_f16(blk + 2);
    var k = 0;
    while (k < 16) {
        var c = load8(blk + 4 + k);
        store64(out + k * 8, _gg_f32r(f64_add(f64_mul(f64_from(c & 15), d), m)));
        store64(out + (k + 16) * 8, _gg_f32r(f64_add(f64_mul(f64_from(c >> 4), d), m)));
        k = k + 1;
    }
    return 0;
}
# one Q5_0 (t = 6) or Q5_1 (t = 7) block
fn _gg_deq_q5(t, blk, out): i64 {
    var d = _gg_f16(blk);
    var m = 0;
    var hoff = 2;
    if (t == 7) { m = _gg_f16(blk + 2); hoff = 4; }
    var qh = load32(blk + hoff) & 0xFFFFFFFF;
    var qs = blk + hoff + 4;
    var j = 0;
    while (j < 16) {
        var b = load8(qs + j);
        var x0 = (b & 15) | (((qh >> j) & 1) << 4);
        var x1 = (b >> 4) | (((qh >> (j + 16)) & 1) << 4);
        if (t == 6) {
            store64(out + j * 8, f64_mul(f64_from(x0 - 16), d));
            store64(out + (j + 16) * 8, f64_mul(f64_from(x1 - 16), d));
        } else {
            store64(out + j * 8, _gg_f32r(f64_add(f64_mul(f64_from(x0), d), m)));
            store64(out + (j + 16) * 8, _gg_f32r(f64_add(f64_mul(f64_from(x1), d), m)));
        }
        j = j + 1;
    }
    return 0;
}
# ---- the K-quants (256-weight superblocks) ---------------------------------------
# ggml-quants.c's dequantize_row_q{2,3,4,5,6}_K, one superblock at a time, in the
# same loop order. Each superblock has an f16 scale d (and, for Q2_K / Q4_K / Q5_K,
# an f16 dmin) that scales 16 or 8 small sub-block scales (and mins).
#
#   Q2_K  16 x 16 weights   y = (d * sc) * q - dmin * m      q 2-bit, sc / m 4-bit
#   Q3_K  16 x 16 weights   y = (d * (s - 32)) * q           q 3-bit signed, s 6-bit
#   Q4_K   8 x 32 weights   y = (d * sc) * q - dmin * m      q 4-bit, sc / m 6-bit
#   Q5_K   8 x 32 weights   y = (d * sc) * q - dmin * m      q 5-bit, sc / m 6-bit
#   Q6_K  16 x 16 weights   y = (d * s) * q                  q 6-bit signed, s int8
#
# As for the legacy types the values are ggml's f32 ones. Every product here is
# exact in f32 (at most 11 + 7 + 5 significant bits), and so in f64. Q3_K and
# Q6_K need nothing more. In the other three, subtracting dmin * m rounds in f32,
# so that difference is rounded to f32 (_gg_f32r), as for Q4_1.

# one Q2_K superblock (84 B) -> 256 f64
fn _gg_deq_q2_k(blk, out): i64 {
    var d = _gg_f16(blk + 80);
    var dmin = _gg_f16(blk + 82);
    var y = 0;
    var is = 0;
    var n = 0;
    while (n < 2) {
        var q = blk + 16 + n * 32;
        var j = 0;
        while (j < 4) {
            var h = 0;
            while (h < 2) {
                var sc = load8(blk + is);
                var dl = f64_mul(d, f64_from(sc & 15));
                var ml = f64_mul(dmin, f64_from(sc >> 4));
                var l = 0;
                while (l < 16) {
                    var c = (load8(q + h * 16 + l) >> (2 * j)) & 3;
                    store64(out + y * 8, _gg_f32r(f64_sub(f64_mul(dl, f64_from(c)), ml)));
                    y = y + 1;
                    l = l + 1;
                }
                is = is + 1;
                h = h + 1;
            }
            j = j + 1;
        }
        n = n + 1;
    }
    return 0;
}
# Q3_K's 6-bit scale k (0..15) from the 12 packed scale bytes at sb, less 32: the low
# four bits are a nibble of bytes 0..7, the top two a 2-bit field of bytes 8..11
fn _gg_q3_scale(sb, k): i64 {
    var lo = 0;
    if (k < 8) { lo = load8(sb + k) & 15; } else { lo = load8(sb + k - 8) >> 4; }
    var hi = (load8(sb + 8 + (k % 4)) >> (2 * (k / 4))) & 3;
    return (lo | (hi << 4)) - 32;
}
# one Q3_K superblock (110 B) -> 256 f64. A code is 2 low bits from qs and a high bit
# from hmask; a clear high bit subtracts 4.
fn _gg_deq_q3_k(blk, out): i64 {
    var d = _gg_f16(blk + 108);
    var y = 0;
    var is = 0;
    var n = 0;
    while (n < 2) {
        var q = blk + 32 + n * 32;
        var j = 0;
        while (j < 4) {
            var mbit = n * 4 + j;
            var h = 0;
            while (h < 2) {
                var dl = f64_mul(d, f64_from(_gg_q3_scale(blk + 96, is)));
                var l = 0;
                while (l < 16) {
                    var c = (load8(q + h * 16 + l) >> (2 * j)) & 3;
                    if (((load8(blk + h * 16 + l) >> mbit) & 1) == 0) { c = c - 4; }
                    store64(out + y * 8, f64_mul(dl, f64_from(c)));
                    y = y + 1;
                    l = l + 1;
                }
                is = is + 1;
                h = h + 1;
            }
            j = j + 1;
        }
        n = n + 1;
    }
    return 0;
}
# Q4_K / Q5_K's 6-bit scale (out[0]) and min (out[1]) of sub-block j (0..7), from
# the 12 scale bytes at sb (ggml's get_scale_min_k4)
fn _gg_k4_sm(sb, j, out): i64 {
    if (j < 4) {
        store64(out, load8(sb + j) & 63);
        store64(out + 8, load8(sb + j + 4) & 63);
        return 0;
    }
    store64(out, (load8(sb + j + 4) & 15) | ((load8(sb + j - 4) >> 6) << 4));
    store64(out + 8, (load8(sb + j + 4) >> 4) | ((load8(sb + j) >> 6) << 4));
    return 0;
}
# one Q4_K (t = 12, 144 B) or Q5_K (t = 13, 176 B) superblock -> 256 f64. Q5_K adds a
# fifth bit from qh: bit 2c (low nibbles) or 2c + 1 (high) of qh[l], for chunk c.
fn _gg_deq_q45_k(t, blk, out): i64 {
    var d = _gg_f16(blk);
    var dmin = _gg_f16(blk + 2);
    var qh = blk + 16;
    var qs = blk + 16;
    if (t == 13) { qs = blk + 48; }
    var sm[16];
    var c = 0;
    while (c < 4) {
        _gg_k4_sm(blk + 4, 2 * c, &sm);
        var d1 = f64_mul(d, f64_from(load64(&sm)));
        var m1 = f64_mul(dmin, f64_from(load64(&sm + 8)));
        _gg_k4_sm(blk + 4, 2 * c + 1, &sm);
        var d2 = f64_mul(d, f64_from(load64(&sm)));
        var m2 = f64_mul(dmin, f64_from(load64(&sm + 8)));
        var q = qs + c * 32;
        var l = 0;
        while (l < 32) {
            var b = load8(q + l);
            var lo = b & 15;
            var hi = b >> 4;
            if (t == 13) {
                lo = lo + (((load8(qh + l) >> (2 * c)) & 1) << 4);
                hi = hi + (((load8(qh + l) >> (2 * c + 1)) & 1) << 4);
            }
            store64(out + (c * 64 + l) * 8, _gg_f32r(f64_sub(f64_mul(d1, f64_from(lo)), m1)));
            store64(out + (c * 64 + 32 + l) * 8, _gg_f32r(f64_sub(f64_mul(d2, f64_from(hi)), m2)));
            l = l + 1;
        }
        c = c + 1;
    }
    return 0;
}
# Q6_K's int8 scale k of the 16 at sc, times d
fn _gg_q6_ds(d, sc, k): i64 {
    var s = load8(sc + k);
    if (s >= 128) { s = s - 256; }
    return f64_mul(d, f64_from(s));
}
# one Q6_K superblock (210 B) -> 256 f64. A code is 4 low bits from ql and 2 high
# bits from qh, less 32.
fn _gg_deq_q6_k(blk, out): i64 {
    var d = _gg_f16(blk + 208);
    var dsv[128];                                    # d * s for the 16 scales, once
    var k = 0;
    while (k < 16) { store64(&dsv + k * 8, _gg_q6_ds(d, blk + 192, k)); k = k + 1; }
    var n = 0;
    while (n < 2) {
        var ql = blk + n * 64;
        var qh = blk + 128 + n * 32;
        var ds = &dsv + n * 64;
        var y = out + n * 128 * 8;
        var l = 0;
        while (l < 32) {
            var is = l / 16;
            var h = load8(qh + l);
            var a = load8(ql + l);
            var b = load8(ql + l + 32);
            var q1 = ((a & 15) | ((h & 3) << 4)) - 32;
            var q2 = ((b & 15) | (((h >> 2) & 3) << 4)) - 32;
            var q3 = ((a >> 4) | (((h >> 4) & 3) << 4)) - 32;
            var q4 = ((b >> 4) | (((h >> 6) & 3) << 4)) - 32;
            store64(y + l * 8, f64_mul(load64(ds + is * 8), f64_from(q1)));
            store64(y + (l + 32) * 8, f64_mul(load64(ds + (is + 2) * 8), f64_from(q2)));
            store64(y + (l + 64) * 8, f64_mul(load64(ds + (is + 4) * 8), f64_from(q3)));
            store64(y + (l + 96) * 8, f64_mul(load64(ds + (is + 6) * 8), f64_from(q4)));
            l = l + 1;
        }
        n = n + 1;
    }
    return 0;
}

# one block of type t (a supported block type) at blk -> its 32 or 256 f64 at out
fn _gg_deq_block(t, blk, out): i64 {
    if (t == 8) { return _gg_deq_q8_0(blk, out); }
    if (t == 2 || t == 3) { return _gg_deq_q4(t, blk, out); }
    if (t == 6 || t == 7) { return _gg_deq_q5(t, blk, out); }
    if (t == 10) { return _gg_deq_q2_k(blk, out); }
    if (t == 11) { return _gg_deq_q3_k(blk, out); }
    if (t == 14) { return _gg_deq_q6_k(blk, out); }
    return _gg_deq_q45_k(t, blk, out);
}
# elements [start, start + n) of a block-typed payload p -> dst. Whole blocks
# decode straight into dst; a range that starts or ends inside a block decodes
# that block into a local buffer and copies its part. Only blocks the range
# touches are read.
fn _gg_read_blocks(t, p, start, n, dst): i64 {
    var bb = _gg_blk_bytes(t);
    var be = _gg_blk_elems(t);
    var tmp[2048];
    var b = start / be;
    var skip = start % be;
    var done = 0;
    while (done < n) {
        var take = be - skip;
        if (take > n - done) { take = n - done; }
        if (take == be) {
            _gg_deq_block(t, p + b * bb, dst + done * 8);
        } else {
            _gg_deq_block(t, p + b * bb, &tmp);
            memcpy(dst + done * 8, &tmp + skip * 8, take * 8);
        }
        done = done + take;
        skip = 0;
        b = b + 1;
    }
    return 0;
}

# Read elements [start, start + n) of tensor e (flat, ne-order) into dst[0..n) as
# f64 (1.2.2). F32 / F16 use the safetensors path's bulk wideners (bit-identical
# to the per-element ones; F16 is byte-composed, so the last element never reads
# past the payload). The block types (1.6.0) take any range, block-aligned or not,
# and give ggml's dequantized values. Returns n, or -1 for a range outside the
# tensor or an unsupported dtype.
fn gg_read_f64_range(r, e, start, n, dst): i64 {
    var total = gg_entry_nelems(e);
    if (start < 0) { return 0 - 1; }
    if (n < 0) { return 0 - 1; }
    if (n > total) { return 0 - 1; }
    if (start > total - n) { return 0 - 1; }
    var p = gg_entry_data(r, e);
    var t = gg_entry_gtype(e);
    if (t == 0) { _st_widen_f32(p + start * 4, dst, n); return n; }
    if (t == 1) { _st_widen_f16(p + start * 2, dst, n); return n; }
    if (gg_type_is_quant(t) == 1) { _gg_read_blocks(t, p, start, n, dst); return n; }
    return 0 - 1;
}
# Read the whole tensor into dst (gg_entry_nelems f64). Returns the element
# count, or -1 for an unsupported dtype.
fn gg_read_f64(r, e, dst): i64 { return gg_read_f64_range(r, e, 0, gg_entry_nelems(e), dst); }

# mmap a GGUF file read-only (zero-copy, past the alloc cap) and open it. The
# mapping is unmapped again if the file is rejected (1.2.2).
fn gg_open_mmap(path): i64 {
    var fd = file_open(path, 0, 0);
    if (fd < 0) { return 0; }
    var size = xlseek(fd, 0, 2);
    if (size <= 24) { file_close(fd); return 0; }
    var addr = mmap_file_ro(fd, size);
    file_close(fd);
    if (addr == 0) { return 0; }
    var r = gg_open(addr, size);
    if (r == 0) { cyr_munmap(addr, size); }
    return r;
}
