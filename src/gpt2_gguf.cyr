# @public — GPT-2 from GGUF: map a llama.cpp-converted GPT-2 checkpoint onto
# rupantara's packed layout (the GGUF sibling of src/gpt2.cyr).
#
# llama.cpp tensor names (gguf-py MODEL_ARCH.GPT2): token_embd, position_embd,
# output_norm, and per block `blk.N.{attn_norm, attn_qkv, attn_output,
# ffn_norm, ffn_up, ffn_down}` (.weight/.bias).
#
# ORIENTATION (the load-bearing detail): ggml stores 2D weights ROW-MAJOR
# [out, in] (ne0 = in = innermost) — llama.cpp's converter transposes HF
# Conv1D's [in, out] on the way in. rosnet's `linear_fwd` is y = x·W with
# W[in, out], so this mapping TRANSPOSES each 2D weight back. Embeddings
# (token/position) are (rows, C) row-major on both sides — no transpose —
# and widen STRAIGHT into the params buffer (token_embd is 309 MB as f64,
# past the alloc cap; no scratch). Norms/biases are 1D — direct.
#
# Config from KV metadata: gpt2.embedding_length (C), gpt2.block_count (NL),
# gpt2.attention.head_count (nh), gpt2.feed_forward_length (F; absent → 4C);
# V from token_embd's outer dim. `general.architecture` must be "gpt2".

# Build "blk.<L>.<suffix>" (NUL-terminated) into buf (at least 96 bytes), or
# into a fresh buffer when buf is 0. Returns the name. (1.2.2: through 1.2.1
# every call built a new string, 13 per layer.)
fn _ggpt2_name(buf, L, suffix): i64 {
    if (buf == 0) { buf = alloc(96); }
    store8(buf, 98); store8(buf + 1, 108); store8(buf + 2, 107); store8(buf + 3, 46);   # "blk."
    var p = 4 + _gpt2_itoa(L, buf + 4);
    store8(buf + p, 46);                                    # '.'
    p = p + 1;
    var s = 0;
    while (load8(suffix + s) != 0) { store8(buf + p, load8(suffix + s)); p = p + 1; s = s + 1; }
    store8(buf + p, 0);
    return buf;
}

# read a 1D tensor (norms/biases) of exactly [n] directly into dst
fn _ggpt2_vec(r, name, dst, n): i64 {
    var e = gg_find(r, name);
    if (e == 0) { return 0 - 1; }
    if (gg_entry_ndim(e) != 1) { return 0 - 1; }
    if (gg_entry_dim(e, 0) != n) { return 0 - 1; }
    if (gg_read_f64(r, e, dst) != n) { return 0 - 1; }
    return 0;
}

# read the fused qkv bias, exactly [3C], straight into bq / bk / bv
fn _ggpt2_qkv_bias(r, name, bq, bk, bv, C): i64 {
    var e = gg_find(r, name);
    if (e == 0) { return 0 - 1; }
    if (gg_entry_ndim(e) != 1) { return 0 - 1; }
    if (gg_entry_dim(e, 0) != 3 * C) { return 0 - 1; }
    if (gg_read_f64_range(r, e, 0, C, bq) != C) { return 0 - 1; }
    if (gg_read_f64_range(r, e, C, C, bk) != C) { return 0 - 1; }
    if (gg_read_f64_range(r, e, 2 * C, C, bv) != C) { return 0 - 1; }
    return 0;
}

# read a ggml [out, in] 2D weight whose shape is exactly ne = [insz, outs] and
# write its out-rows [obase, obase + osz) TRANSPOSED into dst[insz, osz]
# (row-major); obase/osz select a third of the fused qkv. `rowbuf` holds one
# widened source row (insz f64).
#
# 1.2.2: through 1.2.1 this widened the WHOLE source tensor into a scratch sized
# for the largest expected weight (F * C), checking only that `outs` was large
# enough. A tensor with more out-rows than F wrote past the end of the scratch
# (a GGUF with F + 4096 qkv rows crashed with SIGSEGV), and qkv was widened three
# times. Now the shape is exact and each element is widened once: one source row
# into rowbuf, then scattered into its column. Bit-identical to the 1.2.1 copy.
fn _ggpt2_mat_t(r, name, dst, insz, osz, obase, outs, rowbuf): i64 {
    var e = gg_find(r, name);
    if (e == 0) { return 0 - 1; }
    if (gg_entry_ndim(e) != 2) { return 0 - 1; }
    if (gg_entry_dim(e, 0) != insz) { return 0 - 1; }        # ne0 = in (innermost)
    if (gg_entry_dim(e, 1) != outs) { return 0 - 1; }        # exactly the expected rows
    if (obase + osz > outs) { return 0 - 1; }
    var o = 0;
    while (o < osz) {
        if (gg_read_f64_range(r, e, (obase + o) * insz, insz, rowbuf) != insz) { return 0 - 1; }
        var i = 0;
        while (i < insz) {
            store64(dst + (i * osz + o) * 8, load64(rowbuf + i * 8));
            i = i + 1;
        }
        o = o + 1;
    }
    return 0;
}

# infer cfg from GGUF KV metadata (mirrors anuk_gpt2_infer_cfg). Returns 0 | -1.
fn anuk_ggpt2_infer_cfg(r, cfg, T_run): i64 {
    var lenp = alloc(8);
    var arch = gg_kv_str(r, "general.architecture", lenp);
    if (arch == 0) { return 0 - 1; }
    if (load64(lenp) != 4) { return 0 - 1; }
    if (load8(arch) != 103) { return 0 - 1; }                # 'g'
    if (load8(arch + 1) != 112) { return 0 - 1; }            # 'p'
    if (load8(arch + 2) != 116) { return 0 - 1; }            # 't'
    if (load8(arch + 3) != 50) { return 0 - 1; }             # '2'
    var fnd = alloc(8);
    var C = gg_kv_int(r, "gpt2.embedding_length", fnd);
    if (load64(fnd) == 0) { return 0 - 1; }
    var NL = gg_kv_int(r, "gpt2.block_count", fnd);
    if (load64(fnd) == 0) { return 0 - 1; }
    var nh = gg_kv_int(r, "gpt2.attention.head_count", fnd);
    if (load64(fnd) == 0) { return 0 - 1; }
    var F = gg_kv_int(r, "gpt2.feed_forward_length", fnd);
    if (load64(fnd) == 0) { F = 4 * C; }
    var te = gg_find(r, "token_embd.weight");
    if (te == 0) { return 0 - 1; }
    if (gg_entry_ndim(te) != 2) { return 0 - 1; }
    if (gg_entry_dim(te, 0) != C) { return 0 - 1; }
    var V = gg_entry_dim(te, 1);
    ru_cfg_init(cfg, V, C, T_run, nh, nh, NL, F, 1);
    # head_count / block_count / feed_forward_length are raw KV values from the
    # file: head_count = 0 used to reach C / nh inside ru_params_count.
    if (ru_cfg_check(cfg) != RU_OK()) { return 0 - 1; }
    return 0;
}

# pack the GGUF checkpoint onto rupantara's layout. Returns 0 | -1.
fn anuk_ggpt2_pack(r, cfg, params): i64 {
    var V = _cfg_V(cfg);
    var C = _cfg_C(cfg);
    var T = _cfg_T(cfg);
    var NL = _cfg_NL(cfg);
    var F = _cfg_F(cfg);
    # embeddings: widen straight into params (no transpose, no scratch)
    var te = gg_find(r, "token_embd.weight");
    if (te == 0) { return 0 - 1; }
    if (gg_entry_ndim(te) != 2) { return 0 - 1; }
    if (gg_entry_dim(te, 0) != C) { return 0 - 1; }
    if (gg_entry_dim(te, 1) != V) { return 0 - 1; }
    if (gg_read_f64(r, te, _p_tokemb(params)) != V * C) { return 0 - 1; }
    var pe = gg_find(r, "position_embd.weight");
    if (pe == 0) { return 0 - 1; }
    if (gg_entry_ndim(pe) != 2) { return 0 - 1; }
    if (gg_entry_dim(pe, 0) != C) { return 0 - 1; }
    if (gg_entry_dim(pe, 1) < T) { return 0 - 1; }
    # the first T rows are the first T*C elements
    if (gg_read_f64_range(r, pe, 0, T * C, _p_posemb(params, cfg)) != T * C) { return 0 - 1; }
    var rowbuf = t_alloc(C + F);                             # one widened source row
    var namebuf = alloc(96);
    var L = 0;
    while (L < NL) {
        var pblk = params + _ru_blk_base(cfg, L) * 8;
        var ln1g = _ggpt2_name(namebuf, L, "attn_norm.weight");
        if (_ggpt2_vec(r, ln1g, pblk + _ru_o_ln1g(cfg) * 8, C) != 0) { return 0 - 1; }
        var ln1b = _ggpt2_name(namebuf, L, "attn_norm.bias");
        if (_ggpt2_vec(r, ln1b, pblk + _ru_o_ln1b(cfg) * 8, C) != 0) { return 0 - 1; }
        # fused qkv ne = [C, 3C] -> Wq/Wk/Wv [C, C] (transpose + out-range split)
        var qkvw = _ggpt2_name(namebuf, L, "attn_qkv.weight");
        if (_ggpt2_mat_t(r, qkvw, pblk + _ru_o_Wq(cfg) * 8, C, C, 0, 3 * C, rowbuf) != 0) { return 0 - 1; }
        if (_ggpt2_mat_t(r, qkvw, pblk + _ru_o_Wk(cfg) * 8, C, C, C, 3 * C, rowbuf) != 0) { return 0 - 1; }
        if (_ggpt2_mat_t(r, qkvw, pblk + _ru_o_Wv(cfg) * 8, C, C, 2 * C, 3 * C, rowbuf) != 0) { return 0 - 1; }
        var qkvb = _ggpt2_name(namebuf, L, "attn_qkv.bias");
        if (_ggpt2_qkv_bias(r, qkvb, _bq(cfg, pblk), _bk(cfg, pblk), _bv(cfg, pblk), C) != 0) { return 0 - 1; }
        var wo = _ggpt2_name(namebuf, L, "attn_output.weight");
        if (_ggpt2_mat_t(r, wo, pblk + _ru_o_Wo(cfg) * 8, C, C, 0, C, rowbuf) != 0) { return 0 - 1; }
        var bo = _ggpt2_name(namebuf, L, "attn_output.bias");
        if (_ggpt2_vec(r, bo, _bo(cfg, pblk), C) != 0) { return 0 - 1; }
        var ln2g = _ggpt2_name(namebuf, L, "ffn_norm.weight");
        if (_ggpt2_vec(r, ln2g, pblk + _ru_o_ln2g(cfg) * 8, C) != 0) { return 0 - 1; }
        var ln2b = _ggpt2_name(namebuf, L, "ffn_norm.bias");
        if (_ggpt2_vec(r, ln2b, pblk + _ru_o_ln2b(cfg) * 8, C) != 0) { return 0 - 1; }
        var wfc = _ggpt2_name(namebuf, L, "ffn_up.weight");
        if (_ggpt2_mat_t(r, wfc, pblk + _ru_o_Wfc(cfg) * 8, C, F, 0, F, rowbuf) != 0) { return 0 - 1; }
        var bfc = _ggpt2_name(namebuf, L, "ffn_up.bias");
        if (_ggpt2_vec(r, bfc, pblk + _ru_o_bfc(cfg) * 8, F) != 0) { return 0 - 1; }
        var wpr = _ggpt2_name(namebuf, L, "ffn_down.weight");
        if (_ggpt2_mat_t(r, wpr, pblk + _ru_o_Wproj(cfg) * 8, F, C, 0, C, rowbuf) != 0) { return 0 - 1; }
        var bpr = _ggpt2_name(namebuf, L, "ffn_down.bias");
        if (_ggpt2_vec(r, bpr, pblk + _ru_o_bproj(cfg) * 8, C) != 0) { return 0 - 1; }
        L = L + 1;
    }
    if (_ggpt2_vec(r, "output_norm.weight", _p_lnfg(params, cfg), C) != 0) { return 0 - 1; }
    if (_ggpt2_vec(r, "output_norm.bias", _p_lnfb(params, cfg), C) != 0) { return 0 - 1; }
    return 0;
}

# One-shot: mmap a GGUF, infer config (context overridden to T_run), pack a
# fresh params buffer. Returns the params ptr, or 0.
fn anuk_ggpt2_import(path, T_run, cfg): i64 {
    var r = gg_open_mmap(path);
    if (r == 0) { return 0; }
    if (anuk_ggpt2_infer_cfg(r, cfg, T_run) != 0) { return 0; }
    var np = ru_params_count(cfg);
    var params = mmap_anon(np * 8);
    if (params == 0) { return 0; }
    if (anuk_ggpt2_pack(r, cfg, params) != 0) { return 0; }
    return params;
}
