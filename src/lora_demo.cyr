# @public — M3 demo: `gpt2-lora <model.safetensors>` — LoRA head-adapter
# fine-tune over the FROZEN imported GPT-2.
#
# Bite-1 scope (the shallowest honest gradient path): the adapter sits on the
# LM HEAD — logits = f·tok_embᵀ + s·(f·A)·B — where f is the final-LN output of
# the frozen forward. dL/dlogits comes straight from softmax-xent, so the
# gradient path into A,B is EXACTLY the plan's "two rosnet.linear_bwd passes,
# no new gradient op": no transformer backward chain is needed (per-layer
# adapters need one — that chain is attn11's territory: the roadmap's Standing
# decisions).
# Because ONLY the adapter trains, f and the base logits are computed ONCE and
# every step is head-sized (fast), while the 124M base params stay bit-frozen.
#
# The head is weight-tied (tok_emb) — the adapter therefore stays UNMERGED
# (merging would also rewrite the input embedding; lora_merge is for untied
# matrices, proven in tests/tcyr/lora.tcyr).
#
# Objective: memorize the next-token map of the fixed input sequence
# (targets[t] = tokens[t+1], wrap at the end) — a mapping base GPT-2 does NOT
# predict, so adaptation is measurable: xent descends and the greedy argmax
# flips to the targets, while (a) the base params' checksum is unchanged and
# (b) adapter-off logits stay bit-identical (the fidelity gate still holds).

fn _lora_xor_checksum(p, n): i64 {
    var h = 0;
    var i = 0;
    while (i < n) { h = h ^ load64(p + i * 8); i = i + 1; }
    return h;
}

# ---- the head adapter shared by gpt2-lora / gpt2-qlora / gpt2-tula (1.2.2) ----
# One copy of what the three demos each held through 1.2.1: the adapter A (C, r)
# and B (r, V), its forward/backward scratch and Adam state, and the 800-step
# training loop. Same operations in the same order as each 1.2.1 copy, so the
# trained adapter is bit-identical (tests/tcyr/lora.tcyr holds it to a verbatim
# copy of the old loop).
#
# Record (i64 slots): T C V r | A B | u t y probs dy dA dB dys du dxs | mA vA mB vB
fn _had(ad, k): i64 { return load64(ad + k * 8); }

# A new adapter for T rows of C features onto V logits at rank r: A ~ N(0, 0.02²)
# from tyche seeded with 20260704, B = 0 (so it starts as an exact no-op).
fn _anuk_head_adapter_new(T, C, V, r): i64 {
    var ad = alloc(20 * 8);
    store64(ad, T); store64(ad + 8, C); store64(ad + 16, V); store64(ad + 24, r);
    rng_seed(20260704);
    var A = t_alloc(C * r);
    var B = t_alloc(r * V);
    lora_init(A, B, C, r, V, f64_div(f64_from(2), f64_from(100)));   # std 0.02
    store64(ad + 4 * 8, A);
    store64(ad + 5 * 8, B);
    store64(ad + 6 * 8, t_alloc(T * r));     # u
    store64(ad + 7 * 8, t_alloc(T * V));     # t
    store64(ad + 8 * 8, t_alloc(T * V));     # y
    store64(ad + 9 * 8, t_alloc(T * V));     # probs
    store64(ad + 10 * 8, t_alloc(T * V));    # dy
    store64(ad + 11 * 8, t_alloc(C * r));    # dA
    store64(ad + 12 * 8, t_alloc(r * V));    # dB
    store64(ad + 13 * 8, t_alloc(T * V));    # dys
    store64(ad + 14 * 8, t_alloc(T * r));    # du
    store64(ad + 15 * 8, t_alloc(T * C));    # dxs
    store64(ad + 16 * 8, t_alloc(C * r));    # mA
    store64(ad + 17 * 8, t_alloc(C * r));    # vA
    store64(ad + 18 * 8, t_alloc(r * V));    # mB
    store64(ad + 19 * 8, t_alloc(r * V));    # vB
    return ad;
}
# The adapter's A (C, r).
fn _anuk_head_adapter_a(ad): i64 { return _had(ad, 4); }
# The adapter's B (r, V).
fn _anuk_head_adapter_b(ad): i64 { return _had(ad, 5); }

# y = base + s·(f·A)·B into the adapter's y buffer, for any A, B of its shape
# (the reload check runs a loaded pair). Returns y (T x V).
fn _anuk_head_adapter_fwd_with(ad, f, base, A, B, s): i64 {
    var T = _had(ad, 0); var C = _had(ad, 1); var V = _had(ad, 2); var r = _had(ad, 3);
    var y = _had(ad, 8);
    t_copy(y, base, T * V);
    lora_fwd(f, A, B, _had(ad, 6), _had(ad, 7), y, T, C, r, V, s);
    return y;
}
# The same with the adapter's own A, B.
fn _anuk_head_adapter_fwd(ad, f, base, s): i64 {
    return _anuk_head_adapter_fwd_with(ad, f, base, _had(ad, 4), _had(ad, 5), s);
}

# Train `steps` Adam steps (lr) of softmax cross-entropy toward targets, the base
# logits fixed. Prints the loss every `every` steps when every > 0. Stores the
# step-0 loss at loss0_out; returns the last step's loss.
fn _anuk_head_adapter_train(ad, f, base, targets, s, steps, lr, every, loss0_out): i64 {
    var T = _had(ad, 0); var C = _had(ad, 1); var V = _had(ad, 2); var r = _had(ad, 3);
    var A = _had(ad, 4); var B = _had(ad, 5);
    var u = _had(ad, 6); var y = _had(ad, 8); var probs = _had(ad, 9); var dy = _had(ad, 10);
    var dA = _had(ad, 11); var dB = _had(ad, 12);
    var loss = f64_from(0);
    var step = 0;
    while (step < steps) {
        _anuk_head_adapter_fwd(ad, f, base, s);
        loss = lora_xent_loss(y, probs, targets, T, V);
        if (step == 0) { store64(loss0_out, loss); }
        if (every > 0 && (step % every) == 0) {
            _anuk_sput("  step "); _anuk_puti(step);
            _anuk_sput(" loss "); fmt_float(loss, 4); _anuk_sput("\n");
        }
        lora_xent_bwd(probs, targets, dy, T, V);
        t_zero(dA, C * r);
        t_zero(dB, r * V);
        lora_bwd(f, u, A, B, dy, dA, dB, _had(ad, 13), _had(ad, 14), _had(ad, 15), T, C, r, V, s);
        lora_adam(A, dA, _had(ad, 16), _had(ad, 17), C * r, lr, step + 1);
        lora_adam(B, dB, _had(ad, 18), _had(ad, 19), r * V, lr, step + 1);
        step = step + 1;
    }
    return loss;
}

# Frozen forward, once: run embed -> NL blocks -> final LN over `tokens` and
# return f(T,C) — the features the head adapter trains over. Pure composition of
# rupantara's public ops (allocates its own scratch; fine for a once-per-run
# call). Shared by gpt2-lora and gpt2-qlora.
fn anuk_frozen_features(cfg, params, tokens, T): i64 {
    # these are rupantara's leaf kernels, which take dims on trust: check once
    # (1.2.2; every caller passes an already-checked cfg)
    if (ru_cfg_check(cfg) != RU_OK()) { return 0; }
    var C = _cfg_C(cfg);
    var NL = _cfg_NL(cfg);
    var TC = T * C;
    var TF = T * _cfg_F(cfg);
    var xb = t_alloc(TC);
    var a = t_alloc(TC);
    var attn_out = t_alloc(TC);
    var bsc = t_alloc(TC);
    var mlp_out = t_alloc(TC);
    var fc = t_alloc(TF);
    var gg = t_alloc(TF);
    var m1 = t_alloc(T); var r1 = t_alloc(T);
    var m2 = t_alloc(T); var r2 = t_alloc(T);
    var arena = t_alloc(ru_attn_arena_size(T, C, _cfg_nh(cfg), _cfg_nkv(cfg)));
    var f = t_alloc(TC);
    var meanf = t_alloc(T); var rstdf = t_alloc(T);
    ru_embed_fwd(tokens, _p_tokemb(params), _p_posemb(params, cfg), xb, T, C);
    var L = 0;
    while (L < NL) {
        var pblk = params + _ru_blk_base(cfg, L) * 8;
        ru_block_fwd(cfg, pblk, xb, xb, a, attn_out, bsc, mlp_out, fc, gg, m1, r1, m2, r2, arena);
        L = L + 1;
    }
    ru_ln_fwd(xb, _p_lnfg(params, cfg), _p_lnfb(params, cfg), f, meanf, rstdf, T, C);
    return f;
}

# `gpt2-lora <model.safetensors>`: train the head adapter over the frozen f64
# import. Returns 0 on PASS, 1 otherwise.
fn anuk_gpt2_lora(path): i64 {
    var cfg = alloc(64);
    var T = 8;
    var params = anuk_gpt2_import(path, 12, T, cfg);
    if (params == 0) { _anuk_eput("lora: import failed (open / infer / pack)\n"); return 1; }
    var V = _cfg_V(cfg);
    var C = _cfg_C(cfg);
    var NL = _cfg_NL(cfg);
    var np = ru_params_count(cfg);
    var ck0 = _lora_xor_checksum(params, np);
    _anuk_sput("lora: model V="); _anuk_puti(V);
    _anuk_sput(" C="); _anuk_puti(C);
    _anuk_sput(" NL="); _anuk_puti(NL);
    _anuk_sput(" T="); _anuk_puti(T); _anuk_sput("\n");

    # fixed input (the gpt2 command's pattern) + next-token targets
    var tokens = _anuk_demo_tokens(T, V);
    var targets = _anuk_demo_targets(tokens, T);

    # ---- frozen forward, ONCE: f = final-LN output; base logits = head(f) ----
    var f = anuk_frozen_features(cfg, params, tokens, T);
    var base_logits = t_alloc(T * V);
    ru_head_fwd(f, _p_tokemb(params), base_logits, T, C, V);

    # baseline: how many positions does the FROZEN model already predict?
    var match0 = anuk_argmax_matches(base_logits, targets, T, V);

    # ---- the adapter: A(C,r) gaussian, B(r,V) zero; s = alpha/r ---------------
    var r = 8;
    var s = f64_from(2);                                  # alpha = 16, r = 8
    var ad = _anuk_head_adapter_new(T, C, V, r);

    # adapter-off sanity: B=0 => logits bit-identical to base
    var y = _anuk_head_adapter_fwd(ad, f, base_logits, s);
    var offdiffs = 0;
    var i = 0;
    while (i < T * V) { if (load64(y + i * 8) != load64(base_logits + i * 8)) { offdiffs = offdiffs + 1; } i = i + 1; }
    _anuk_sput("adapter-off logits vs base: diffs="); _anuk_puti(offdiffs); _anuk_sput("\n");

    # ---- train: Adam on A,B only (f + base logits are fixed) ------------------
    # (plain SGD diverges here — the real f carries massive-activation outlier
    # dims; see lora_adam's header)
    var steps = 800;
    var lr = f64_div(f64_from(1), f64_from(100));         # 1e-2 (Adam)
    var loss0p = alloc(8);
    var loss = _anuk_head_adapter_train(ad, f, base_logits, targets, s, steps, lr, 200, loss0p);
    var loss0 = load64(loss0p);
    _anuk_sput("xent loss: step0 "); fmt_float(loss0, 4);
    _anuk_sput(" -> step"); _anuk_puti(steps);
    _anuk_sput(" "); fmt_float(loss, 4); _anuk_sput("\n");

    # ---- after: greedy argmax vs targets --------------------------------------
    y = _anuk_head_adapter_fwd(ad, f, base_logits, s);
    var match1 = anuk_argmax_matches(y, targets, T, V);
    var ck1 = _lora_xor_checksum(params, np);
    _anuk_sput("greedy argmax == target: base "); _anuk_puti(match0);
    _anuk_sput("/"); _anuk_puti(T);
    _anuk_sput(" -> adapted "); _anuk_puti(match1);
    _anuk_sput("/"); _anuk_puti(T); _anuk_sput("\n");
    _anuk_sput("base params xor-checksum unchanged: ");
    if (ck0 == ck1) { _anuk_sput("yes\n"); } else { _anuk_sput("NO\n"); }

    var ok = 1;
    if (offdiffs != 0) { ok = 0; }
    if (f64_lt(loss, loss0) == 0) { ok = 0; }
    if (match1 <= match0) { ok = 0; }
    if (match1 < T) { ok = 0; }
    if (ck0 != ck1) { ok = 0; }
    if (ok == 1) {
        _anuk_sput("RESULT: LoRA head-adapter fine-tune PASS (adapts to ");
        _anuk_puti(match1); _anuk_sput("/"); _anuk_puti(T);
        _anuk_sput("; base frozen bit-identical)\n");
        return 0;
    }
    _anuk_sput("RESULT: LoRA fine-tune FAIL\n");
    return 1;
}
