# tests/tcyr/gguf.tcyr — GGUF import: parser + GPT-2 mapping round-trip.
#
# Mirrors gpt2.tcyr's self-contained pattern: build a model in rupantara's
# packed layout, EXPORT it as a llama.cpp-shaped GGUF (blk.N.* names, ggml
# [out, in] row-major weights — i.e. the writer TRANSPOSES, fused qkv, F32
# data, ne-order dims with dims[0] innermost), then IMPORT via
# anuk_ggpt2_infer_cfg + anuk_ggpt2_pack and assert (a) packed params
# bit-identical and (b) ru_model_fwd logits bit-identical.
#
# Seed values are chosen EXACT in f32 (small ints over a power-of-two
# denominator), so f64 -> f32 -> f64 is lossless and the bit-identity gates are
# legitimate. A minimal-file test also covers the F16 widen path, KV lookups
# (incl. non-default alignment + structurally-skipped array/string values) and
# directed structural rejects; the mutation/truncation sweep lives in
# tests/tcyr/fuzz.tcyr.
include "src/lib.cyr"
include "lib/assert.cyr"

include "tests/common.cyr"

# ---- minimal-file test: KVs, F32 + F16 widen, directed rejects ---------------
fn test_gguf_minimal(): i64 {
    var a = t_alloc(3);
    tset(a, 0, f64_div(f64_from(3), f64_from(2)));       # 1.5
    tset(a, 1, f64_div(f64_from(0 - 9), f64_from(4)));   # -2.25
    tset(a, 2, f64_from(7));
    var b = t_alloc(4);
    tset(b, 0, f64_div(f64_from(1), f64_from(2)));
    tset(b, 1, f64_from(0 - 1));
    tset(b, 2, f64_from(2));
    tset(b, 3, f64_div(f64_from(0 - 1), f64_from(4)));
    var w = _ggw_new();
    _ggw_add(w, "t.f32", a, 3, 0, 1, 0);
    _ggw_add(w, "t.f16", b, 2, 2, 2, 1);
    var lenp = alloc(8);
    var buf = _ggw_finish(w, 0, 64, 0, lenp);            # non-default alignment
    var len = load64(lenp);

    var r = gg_open(buf, len);
    assert_nonnull(r, "gg_open accepts the valid file");
    assert_eq(gg_count(r), 2, "two tensors");
    var e = gg_find(r, "t.f32");
    assert_nonnull(e, "gg_find t.f32");
    assert_eq(gg_entry_ndim(e), 1, "t.f32 ndim");
    assert_eq(gg_entry_nelems(e), 3, "t.f32 nelems");
    var out = t_alloc(3);
    assert_eq(gg_read_f64(r, e, out), 3, "t.f32 read");
    assert_eq(load64(out), load64(a), "f32 widen exact [0]");
    assert_eq(load64(out + 8), load64(a + 8), "f32 widen exact [1]");
    assert_eq(load64(out + 16), load64(a + 16), "f32 widen exact [2]");
    var e2 = gg_find(r, "t.f16");
    assert_nonnull(e2, "gg_find t.f16");
    assert_eq(gg_entry_dim(e2, 0), 2, "t.f16 ne0");
    assert_eq(gg_entry_dim(e2, 1), 2, "t.f16 ne1");
    var out2 = t_alloc(4);
    assert_eq(gg_read_f64(r, e2, out2), 4, "t.f16 read");
    var k = 0;
    var f16ok = 1;
    while (k < 4) {
        if (load64(out2 + k * 8) != load64(b + k * 8)) { f16ok = 0; }
        k = k + 1;
    }
    assert_eq(f16ok, 1, "f16 widen exact");
    assert_eq(gg_find(r, "t.absent"), 0, "absent tensor -> 0");
    # KV surface
    var fnd = alloc(8);
    assert_eq(gg_kv_int(r, "general.alignment", fnd), 64, "alignment KV read");
    assert_eq(load64(fnd), 1, "alignment KV found");
    gg_kv_int(r, "no.such.key", fnd);
    assert_eq(load64(fnd), 0, "absent KV -> found=0");
    var slen = alloc(8);
    var sp = gg_kv_str(r, "general.architecture", slen);
    assert_nonnull(sp, "arch KV string");
    assert_eq(load64(slen), 4, "arch KV len");
    assert_eq(load8(sp + 3), 50, "arch KV ends in '2'");
    assert_eq(gg_kv_str(r, "general.alignment", slen), 0, "int KV via str -> 0");
    # directed structural rejects (byte-level; fuzz.tcyr does the sweep)
    assert_eq(gg_open(buf, 10), 0, "truncated header rejected");
    store8(buf + 0, 88);
    assert_eq(gg_open(buf, len), 0, "bad magic rejected");
    store8(buf + 0, 71);                                 # 'G' restored
    store8(buf + 4, 1);
    assert_eq(gg_open(buf, len), 0, "version 1 rejected");
    store8(buf + 4, 3);
    assert_nonnull(gg_open(buf, len), "restored file accepted again");
    return 0;
}

# f32-EXACT fill: small ints over 32 (lossless through the f32 narrow/widen)
fn _fill32(p, n, seed): i64 {
    var i = 0;
    while (i < n) {
        var m = ((i * 131 + seed * 17 + 7) % 101) - 50;
        store64(p + i * 8, f64_div(f64_from(m), f64_from(32)));
        i = i + 1;
    }
    return 0;
}

fn test_gguf_gpt2_roundtrip(): i64 {
    var V = 13; var C = 8; var T = 6; var nh = 2; var NL = 2;
    var cfg = alloc(64);
    ru_cfg_init(cfg, V, C, T, nh, nh, NL, 4 * C, 1);
    var np = ru_params_count(cfg);
    var P = t_alloc(np);
    _fill32(P, np, 3);
    var lenp = alloc(8);
    var buf = _export_gguf(cfg, P, lenp);
    var r = gg_open(buf, load64(lenp));
    assert_nonnull(r, "gg_open parsed the exported GPT-2 GGUF");
    assert_eq(gg_count(r), 4 + 12 * NL, "tensor count");
    var cfg2 = alloc(64);
    assert_eq(anuk_ggpt2_infer_cfg(r, cfg2, T), 0, "ggpt2 infer_cfg ok");
    assert_eq(_cfg_V(cfg2), V, "inferred V");
    assert_eq(_cfg_C(cfg2), C, "inferred C");
    assert_eq(_cfg_T(cfg2), T, "inferred T");
    assert_eq(_cfg_NL(cfg2), NL, "inferred NL");
    assert_eq(_cfg_F(cfg2), 4 * C, "inferred F");
    assert_eq(ru_params_count(cfg2), np, "inferred params count matches");
    var P2 = t_alloc(np);
    assert_eq(anuk_ggpt2_pack(r, cfg2, P2), 0, "anuk_ggpt2_pack ok");
    var diffs = 0;
    var i = 0;
    while (i < np) {
        if (load64(P2 + i * 8) != load64(P + i * 8)) { diffs = diffs + 1; }
        i = i + 1;
    }
    assert_eq(diffs, 0, "imported params bit-identical to the original");
    var tokens = alloc(T * 8);
    var t = 0;
    while (t < T) { store64(tokens + t * 8, (t * 5 + 2) % V); t = t + 1; }
    var L1 = t_alloc(T * V);
    var L2 = t_alloc(T * V);
    ru_model_fwd(cfg, P, tokens, L1, 0);
    ru_model_fwd(cfg2, P2, tokens, L2, 0);
    var ldiff = 0;
    i = 0;
    while (i < T * V) {
        if (load64(L1 + i * 8) != load64(L2 + i * 8)) { ldiff = ldiff + 1; }
        i = i + 1;
    }
    assert_eq(ldiff, 0, "GGUF-imported model logits bit-identical");
    return 0;
}

# overwrite the u32 value of KV `key` in a serialized GGUF: the key is written as
# u64 len + bytes, then a u32 vtype, then the u32 value. Returns 0 | -1 (absent).
fn _patch_kv_u32(buf, len, key, v): i64 {
    var kl = strlen(key);
    var p = 0;
    while (p + kl + 8 <= len) {
        if (memeq(buf + p, key, kl) == 1) {
            var offp = alloc(8);
            store64(offp, p + kl + 4);
            _ggw_u32(buf, offp, v);
            return 0;
        }
        p = p + 1;
    }
    return 0 - 1;
}

# 1.2.1: head_count is a raw KV value from the file. 0 used to reach C / nh inside
# ru_params_count (a divide by zero); now ru_cfg_check refuses it at inference.
fn test_gguf_hostile_head_count(): i64 {
    var V = 13; var C = 8; var T = 6; var nh = 2; var NL = 2;
    var cfg = alloc(64);
    ru_cfg_init(cfg, V, C, T, nh, nh, NL, 4 * C, 1);
    var np = ru_params_count(cfg);
    var P = t_alloc(np);
    _fill32(P, np, 5);
    var lenp = alloc(8);
    var buf = _export_gguf(cfg, P, lenp);
    var len = load64(lenp);
    var cfg2 = alloc(64);
    assert_eq(_patch_kv_u32(buf, len, "gpt2.attention.head_count", 0), 0, "head_count patched to 0");
    var r = gg_open(buf, len);
    assert_nonnull(r, "gg_open still parses (head_count is just a KV)");
    assert_eq(anuk_ggpt2_infer_cfg(r, cfg2, T), 0 - 1, "head_count = 0 rejected");
    assert_eq(_patch_kv_u32(buf, len, "gpt2.attention.head_count", 3), 0, "head_count patched to 3");
    r = gg_open(buf, len);
    assert_eq(anuk_ggpt2_infer_cfg(r, cfg2, T), 0 - 1, "head_count not dividing C rejected");
    return 0;
}

# a 1-layer GPT-2 GGUF whose attn_qkv.weight has `qkv_rows` output rows (3C is
# right); every other tensor has its proper shape
fn _gg_model(cfg, qkv_rows, out_len): i64 {
    var V = _cfg_V(cfg); var C = _cfg_C(cfg); var T = _cfg_T(cfg); var F = _cfg_F(cfg);
    var w = _ggw_new();
    _ggw_add(w, "token_embd.weight", t_alloc(V * C), C, V, 2, 0);
    _ggw_add(w, "position_embd.weight", t_alloc(T * C), C, T, 2, 0);
    _ggw_add(w, "blk.0.attn_norm.weight", t_alloc(C), C, 0, 1, 0);
    _ggw_add(w, "blk.0.attn_norm.bias", t_alloc(C), C, 0, 1, 0);
    _ggw_add(w, "blk.0.attn_qkv.weight", t_alloc(qkv_rows * C), C, qkv_rows, 2, 0);
    _ggw_add(w, "blk.0.attn_qkv.bias", t_alloc(3 * C), 3 * C, 0, 1, 0);
    _ggw_add(w, "blk.0.attn_output.weight", t_alloc(C * C), C, C, 2, 0);
    _ggw_add(w, "blk.0.attn_output.bias", t_alloc(C), C, 0, 1, 0);
    _ggw_add(w, "blk.0.ffn_norm.weight", t_alloc(C), C, 0, 1, 0);
    _ggw_add(w, "blk.0.ffn_norm.bias", t_alloc(C), C, 0, 1, 0);
    _ggw_add(w, "blk.0.ffn_up.weight", t_alloc(F * C), C, F, 2, 0);
    _ggw_add(w, "blk.0.ffn_up.bias", t_alloc(F), F, 0, 1, 0);
    _ggw_add(w, "blk.0.ffn_down.weight", t_alloc(F * C), F, C, 2, 0);
    _ggw_add(w, "blk.0.ffn_down.bias", t_alloc(C), C, 0, 1, 0);
    _ggw_add(w, "output_norm.weight", t_alloc(C), C, 0, 1, 0);
    _ggw_add(w, "output_norm.bias", t_alloc(C), C, 0, 1, 0);
    return _ggw_finish(w, cfg, 32, 1, out_len);
}
fn _gg_pack_rc(cfg, qkv_rows): i64 {
    var lp = alloc(8);
    var buf = _gg_model(cfg, qkv_rows, lp);
    var r = gg_open(buf, load64(lp));
    if (r == 0) { return 0 - 9; }
    var cfg2 = alloc(64);
    var rc = anuk_ggpt2_infer_cfg(r, cfg2, _cfg_T(cfg));
    if (rc != 0) { return rc; }
    return anuk_ggpt2_pack(r, cfg2, t_alloc(ru_params_count(cfg2)));
}

# 1.2.2: weights are checked against their exact shape. Through 1.2.1 an attn_qkv
# with more out-rows than F was widened whole into an F*C scratch (SIGSEGV), and
# one with 4C rows was accepted.
fn test_gguf_qkv_shape(): i64 {
    var cfg = alloc(64);
    ru_cfg_init(cfg, 13, 8, 6, 2, 2, 1, 32, 1);
    assert_eq(_gg_pack_rc(cfg, 24), 0, "attn_qkv with 3C rows packs");
    assert_eq(_gg_pack_rc(cfg, 32 + 4096), 0 - 1, "attn_qkv with F + 4096 rows rejected (no overflow)");
    assert_eq(_gg_pack_rc(cfg, 32), 0 - 1, "attn_qkv with 4C rows rejected");
    return 0;
}

# GGUF header + `nkv` KVs + `nt` tensors written by the caller after this
fn _gg_head(buf, offp, nt, nkv): i64 {
    _ggw_u32(buf, offp, GGUF_MAGIC()); _ggw_u32(buf, offp, 3);
    _ggw_u64(buf, offp, nt); _ggw_u64(buf, offp, nkv);
    return 0;
}

# 1.2.2: dims are multiplied with an overflow check
fn test_gguf_dims_wrap(): i64 {
    var buf = alloc(4096);
    var offp = alloc(8); store64(offp, 0);
    _gg_head(buf, offp, 1, 0);
    _ggw_str(buf, offp, "t"); _ggw_u32(buf, offp, 4);
    _ggw_u64(buf, offp, 4); _ggw_u64(buf, offp, 27905);         # 4 * 27905 * 429509837 * 384773
    _ggw_u64(buf, offp, 429509837); _ggw_u64(buf, offp, 384773);   #   = 2^64 + 4
    _ggw_u32(buf, offp, 0); _ggw_u64(buf, offp, 0);
    var off = load64(offp);
    var ds = off + (32 - (off % 32)) % 32;
    assert_eq(gg_open(buf, ds + 16), 0, "4-D dims whose product wraps to 4 rejected");
    return 0;
}

# 1.2.2: KV integers are read at their own width and sign-extended
fn test_gguf_kv_width(): i64 {
    # a buffer ending in a u16 general.alignment, flush against an unmapped page
    var buf = alloc(8192);
    var offp = alloc(8); store64(offp, 0);
    _gg_head(buf, offp, 0, 2);
    _ggw_str(buf, offp, "f"); _ggw_u32(buf, offp, 8);
    var pad = alloc(4096);
    var k = 0;
    while (k < 4020) { store8(pad + k, 120); k = k + 1; }
    store8(pad + 4020, 0);
    _ggw_str(buf, offp, pad);
    _ggw_str(buf, offp, "general.alignment"); _ggw_u32(buf, offp, 2);
    _ggw_u8(buf, offp, 32); _ggw_u8(buf, offp, 0);
    assert_eq(load64(offp), 4096, "the u16 KV ends the 4096-byte buffer");
    var g = mmap_anon(8192);
    cyr_munmap(g + 4096, 4096);
    var j = 0;
    while (j < 4096) { store8(g + j, load8(buf + j)); j = j + 1; }
    var r = gg_open(g, 4096);
    assert_nonnull(r, "a u16 alignment at the very end opens (no 4-byte over-read)");
    var fnd = alloc(8);
    assert_eq(gg_kv_int(r, "general.alignment", fnd), 32, "u16 alignment reads as 32");
    # signed KVs: i8 / i16 / i32 holding -1
    store64(offp, 0);
    _gg_head(buf, offp, 0, 3);
    _ggw_str(buf, offp, "a"); _ggw_u32(buf, offp, 1); _ggw_u8(buf, offp, 255);
    _ggw_str(buf, offp, "b"); _ggw_u32(buf, offp, 3); _ggw_u8(buf, offp, 255); _ggw_u8(buf, offp, 255);
    _ggw_str(buf, offp, "c"); _ggw_u32(buf, offp, 5); _ggw_u32(buf, offp, 4294967295);
    var off = load64(offp);
    while ((off % 32) != 0) { _ggw_u8(buf, offp, 0); off = off + 1; }
    r = gg_open(buf, off);
    assert_nonnull(r, "signed-KV file opens");
    assert_eq(gg_kv_int(r, "a", fnd), 0 - 1, "i8 -1 reads as -1");
    assert_eq(gg_kv_int(r, "b", fnd), 0 - 1, "i16 -1 reads as -1");
    assert_eq(gg_kv_int(r, "c", fnd), 0 - 1, "i32 -1 reads as -1");
    return 0;
}

fn main(): i64 {
    alloc_init();
    test_gguf_minimal();
    test_gguf_gpt2_roundtrip();
    test_gguf_hostile_head_count();
    test_gguf_qkv_shape();
    test_gguf_dims_wrap();
    test_gguf_kv_width();
    return assert_summary();
}

var rc = main();
sys_exit(rc);
