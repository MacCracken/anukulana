# tests/tcyr/gguf.tcyr — GGUF import: parser + GPT-2 mapping round-trip.
#
# Mirrors gpt2.tcyr's self-contained pattern: build a model in rupantara's
# packed layout, EXPORT it as a llama.cpp-shaped GGUF (blk.N.* names, ggml
# [out, in] row-major weights — i.e. the writer TRANSPOSES, fused qkv, F32
# data, ne-order dims with dims[0] innermost), then IMPORT via
# anuk_ggpt2_infer_cfg + anuk_ggpt2_pack and assert (a) packed params
# bit-identical and (b) ru_model_fwd logits bit-identical.
#
# Seed values are chosen EXACT in f32 (small ints over a power-of-two
# denominator), so f64 -> f32 -> f64 is lossless and the bit-identity gates are
# legitimate. A minimal-file test also covers the F16 widen path, KV lookups
# (incl. non-default alignment + structurally-skipped array/string values) and
# directed structural rejects; the mutation/truncation sweep lives in
# tests/tcyr/fuzz.tcyr.
include "src/lib.cyr"
include "lib/assert.cyr"

include "tests/common.cyr"

# ---- minimal-file test: KVs, F32 + F16 widen, directed rejects ---------------
fn test_gguf_minimal(): i64 {
    var a = t_alloc(3);
    tset(a, 0, f64_div(f64_from(3), f64_from(2)));       # 1.5
    tset(a, 1, f64_div(f64_from(0 - 9), f64_from(4)));   # -2.25
    tset(a, 2, f64_from(7));
    var b = t_alloc(4);
    tset(b, 0, f64_div(f64_from(1), f64_from(2)));
    tset(b, 1, f64_from(0 - 1));
    tset(b, 2, f64_from(2));
    tset(b, 3, f64_div(f64_from(0 - 1), f64_from(4)));
    var w = _ggw_new();
    _ggw_add(w, "t.f32", a, 3, 0, 1, 0);
    _ggw_add(w, "t.f16", b, 2, 2, 2, 1);
    var lenp = alloc(8);
    var buf = _ggw_finish(w, 0, 64, 0, lenp);            # non-default alignment
    var len = load64(lenp);

    var r = gg_open(buf, len);
    assert_nonnull(r, "gg_open accepts the valid file");
    assert_eq(gg_count(r), 2, "two tensors");
    var e = gg_find(r, "t.f32");
    assert_nonnull(e, "gg_find t.f32");
    assert_eq(gg_entry_ndim(e), 1, "t.f32 ndim");
    assert_eq(gg_entry_nelems(e), 3, "t.f32 nelems");
    var out = t_alloc(3);
    assert_eq(gg_read_f64(r, e, out), 3, "t.f32 read");
    assert_eq(load64(out), load64(a), "f32 widen exact [0]");
    assert_eq(load64(out + 8), load64(a + 8), "f32 widen exact [1]");
    assert_eq(load64(out + 16), load64(a + 16), "f32 widen exact [2]");
    var e2 = gg_find(r, "t.f16");
    assert_nonnull(e2, "gg_find t.f16");
    assert_eq(gg_entry_dim(e2, 0), 2, "t.f16 ne0");
    assert_eq(gg_entry_dim(e2, 1), 2, "t.f16 ne1");
    var out2 = t_alloc(4);
    assert_eq(gg_read_f64(r, e2, out2), 4, "t.f16 read");
    var k = 0;
    var f16ok = 1;
    while (k < 4) {
        if (load64(out2 + k * 8) != load64(b + k * 8)) { f16ok = 0; }
        k = k + 1;
    }
    assert_eq(f16ok, 1, "f16 widen exact");
    assert_eq(gg_find(r, "t.absent"), 0, "absent tensor -> 0");
    # KV surface
    var fnd = alloc(8);
    assert_eq(gg_kv_int(r, "general.alignment", fnd), 64, "alignment KV read");
    assert_eq(load64(fnd), 1, "alignment KV found");
    gg_kv_int(r, "no.such.key", fnd);
    assert_eq(load64(fnd), 0, "absent KV -> found=0");
    var slen = alloc(8);
    var sp = gg_kv_str(r, "general.architecture", slen);
    assert_nonnull(sp, "arch KV string");
    assert_eq(load64(slen), 4, "arch KV len");
    assert_eq(load8(sp + 3), 50, "arch KV ends in '2'");
    assert_eq(gg_kv_str(r, "general.alignment", slen), 0, "int KV via str -> 0");
    # directed structural rejects (byte-level; fuzz.tcyr does the sweep)
    assert_eq(gg_open(buf, 10), 0, "truncated header rejected");
    store8(buf + 0, 88);
    assert_eq(gg_open(buf, len), 0, "bad magic rejected");
    store8(buf + 0, 71);                                 # 'G' restored
    store8(buf + 4, 1);
    assert_eq(gg_open(buf, len), 0, "version 1 rejected");
    store8(buf + 4, 3);
    assert_nonnull(gg_open(buf, len), "restored file accepted again");
    return 0;
}

# f32-EXACT fill: small ints over 32 (lossless through the f32 narrow/widen)
fn _fill32(p, n, seed): i64 {
    var i = 0;
    while (i < n) {
        var m = ((i * 131 + seed * 17 + 7) % 101) - 50;
        store64(p + i * 8, f64_div(f64_from(m), f64_from(32)));
        i = i + 1;
    }
    return 0;
}

fn test_gguf_gpt2_roundtrip(): i64 {
    var V = 13; var C = 8; var T = 6; var nh = 2; var NL = 2;
    var cfg = alloc(64);
    ru_cfg_init(cfg, V, C, T, nh, nh, NL, 4 * C, 1);
    var np = ru_params_count(cfg);
    var P = t_alloc(np);
    _fill32(P, np, 3);
    var lenp = alloc(8);
    var buf = _export_gguf(cfg, P, lenp);
    var r = gg_open(buf, load64(lenp));
    assert_nonnull(r, "gg_open parsed the exported GPT-2 GGUF");
    assert_eq(gg_count(r), 4 + 12 * NL, "tensor count");
    var cfg2 = alloc(64);
    assert_eq(anuk_ggpt2_infer_cfg(r, cfg2, T), 0, "ggpt2 infer_cfg ok");
    assert_eq(_cfg_V(cfg2), V, "inferred V");
    assert_eq(_cfg_C(cfg2), C, "inferred C");
    assert_eq(_cfg_T(cfg2), T, "inferred T");
    assert_eq(_cfg_NL(cfg2), NL, "inferred NL");
    assert_eq(_cfg_F(cfg2), 4 * C, "inferred F");
    assert_eq(ru_params_count(cfg2), np, "inferred params count matches");
    var P2 = t_alloc(np);
    assert_eq(anuk_ggpt2_pack(r, cfg2, P2), 0, "anuk_ggpt2_pack ok");
    var diffs = 0;
    var i = 0;
    while (i < np) {
        if (load64(P2 + i * 8) != load64(P + i * 8)) { diffs = diffs + 1; }
        i = i + 1;
    }
    assert_eq(diffs, 0, "imported params bit-identical to the original");
    var tokens = alloc(T * 8);
    var t = 0;
    while (t < T) { store64(tokens + t * 8, (t * 5 + 2) % V); t = t + 1; }
    var L1 = t_alloc(T * V);
    var L2 = t_alloc(T * V);
    ru_model_fwd(cfg, P, tokens, L1, 0);
    ru_model_fwd(cfg2, P2, tokens, L2, 0);
    var ldiff = 0;
    i = 0;
    while (i < T * V) {
        if (load64(L1 + i * 8) != load64(L2 + i * 8)) { ldiff = ldiff + 1; }
        i = i + 1;
    }
    assert_eq(ldiff, 0, "GGUF-imported model logits bit-identical");
    return 0;
}

# overwrite the u32 value of KV `key` in a serialized GGUF: the key is written as
# u64 len + bytes, then a u32 vtype, then the u32 value. Returns 0 | -1 (absent).
fn _patch_kv_u32(buf, len, key, v): i64 {
    var kl = strlen(key);
    var p = 0;
    while (p + kl + 8 <= len) {
        if (memeq(buf + p, key, kl) == 1) {
            var offp = alloc(8);
            store64(offp, p + kl + 4);
            _ggw_u32(buf, offp, v);
            return 0;
        }
        p = p + 1;
    }
    return 0 - 1;
}

# 1.2.1: head_count is a raw KV value from the file. 0 used to reach C / nh inside
# ru_params_count (a divide by zero); now ru_cfg_check refuses it at inference.
fn test_gguf_hostile_head_count(): i64 {
    var V = 13; var C = 8; var T = 6; var nh = 2; var NL = 2;
    var cfg = alloc(64);
    ru_cfg_init(cfg, V, C, T, nh, nh, NL, 4 * C, 1);
    var np = ru_params_count(cfg);
    var P = t_alloc(np);
    _fill32(P, np, 5);
    var lenp = alloc(8);
    var buf = _export_gguf(cfg, P, lenp);
    var len = load64(lenp);
    var cfg2 = alloc(64);
    assert_eq(_patch_kv_u32(buf, len, "gpt2.attention.head_count", 0), 0, "head_count patched to 0");
    var r = gg_open(buf, len);
    assert_nonnull(r, "gg_open still parses (head_count is just a KV)");
    assert_eq(anuk_ggpt2_infer_cfg(r, cfg2, T), 0 - 1, "head_count = 0 rejected");
    assert_eq(_patch_kv_u32(buf, len, "gpt2.attention.head_count", 3), 0, "head_count patched to 3");
    r = gg_open(buf, len);
    assert_eq(anuk_ggpt2_infer_cfg(r, cfg2, T), 0 - 1, "head_count not dividing C rejected");
    return 0;
}

# a 1-layer GPT-2 GGUF whose attn_qkv.weight has `qkv_rows` output rows (3C is
# right); every other tensor has its proper shape
fn _gg_model(cfg, qkv_rows, out_len): i64 {
    var V = _cfg_V(cfg); var C = _cfg_C(cfg); var T = _cfg_T(cfg); var F = _cfg_F(cfg);
    var w = _ggw_new();
    _ggw_add(w, "token_embd.weight", t_alloc(V * C), C, V, 2, 0);
    _ggw_add(w, "position_embd.weight", t_alloc(T * C), C, T, 2, 0);
    _ggw_add(w, "blk.0.attn_norm.weight", t_alloc(C), C, 0, 1, 0);
    _ggw_add(w, "blk.0.attn_norm.bias", t_alloc(C), C, 0, 1, 0);
    _ggw_add(w, "blk.0.attn_qkv.weight", t_alloc(qkv_rows * C), C, qkv_rows, 2, 0);
    _ggw_add(w, "blk.0.attn_qkv.bias", t_alloc(3 * C), 3 * C, 0, 1, 0);
    _ggw_add(w, "blk.0.attn_output.weight", t_alloc(C * C), C, C, 2, 0);
    _ggw_add(w, "blk.0.attn_output.bias", t_alloc(C), C, 0, 1, 0);
    _ggw_add(w, "blk.0.ffn_norm.weight", t_alloc(C), C, 0, 1, 0);
    _ggw_add(w, "blk.0.ffn_norm.bias", t_alloc(C), C, 0, 1, 0);
    _ggw_add(w, "blk.0.ffn_up.weight", t_alloc(F * C), C, F, 2, 0);
    _ggw_add(w, "blk.0.ffn_up.bias", t_alloc(F), F, 0, 1, 0);
    _ggw_add(w, "blk.0.ffn_down.weight", t_alloc(F * C), F, C, 2, 0);
    _ggw_add(w, "blk.0.ffn_down.bias", t_alloc(C), C, 0, 1, 0);
    _ggw_add(w, "output_norm.weight", t_alloc(C), C, 0, 1, 0);
    _ggw_add(w, "output_norm.bias", t_alloc(C), C, 0, 1, 0);
    return _ggw_finish(w, cfg, 32, 1, out_len);
}
fn _gg_pack_rc(cfg, qkv_rows): i64 {
    var lp = alloc(8);
    var buf = _gg_model(cfg, qkv_rows, lp);
    var r = gg_open(buf, load64(lp));
    if (r == 0) { return 0 - 9; }
    var cfg2 = alloc(64);
    var rc = anuk_ggpt2_infer_cfg(r, cfg2, _cfg_T(cfg));
    if (rc != 0) { return rc; }
    return anuk_ggpt2_pack(r, cfg2, t_alloc(ru_params_count(cfg2)));
}

# 1.2.2: weights are checked against their exact shape. Through 1.2.1 an attn_qkv
# with more out-rows than F was widened whole into an F*C scratch (SIGSEGV), and
# one with 4C rows was accepted.
fn test_gguf_qkv_shape(): i64 {
    var cfg = alloc(64);
    ru_cfg_init(cfg, 13, 8, 6, 2, 2, 1, 32, 1);
    assert_eq(_gg_pack_rc(cfg, 24), 0, "attn_qkv with 3C rows packs");
    assert_eq(_gg_pack_rc(cfg, 32 + 4096), 0 - 1, "attn_qkv with F + 4096 rows rejected (no overflow)");
    assert_eq(_gg_pack_rc(cfg, 32), 0 - 1, "attn_qkv with 4C rows rejected");
    return 0;
}

# GGUF header + `nkv` KVs + `nt` tensors written by the caller after this
fn _gg_head(buf, offp, nt, nkv): i64 {
    _ggw_u32(buf, offp, GGUF_MAGIC()); _ggw_u32(buf, offp, 3);
    _ggw_u64(buf, offp, nt); _ggw_u64(buf, offp, nkv);
    return 0;
}

# 1.2.2: dims are multiplied with an overflow check
fn test_gguf_dims_wrap(): i64 {
    var buf = alloc(4096);
    var offp = alloc(8); store64(offp, 0);
    _gg_head(buf, offp, 1, 0);
    _ggw_str(buf, offp, "t"); _ggw_u32(buf, offp, 4);
    _ggw_u64(buf, offp, 4); _ggw_u64(buf, offp, 27905);         # 4 * 27905 * 429509837 * 384773
    _ggw_u64(buf, offp, 429509837); _ggw_u64(buf, offp, 384773);   #   = 2^64 + 4
    _ggw_u32(buf, offp, 0); _ggw_u64(buf, offp, 0);
    var off = load64(offp);
    var ds = off + (32 - (off % 32)) % 32;
    assert_eq(gg_open(buf, ds + 16), 0, "4-D dims whose product wraps to 4 rejected");
    return 0;
}

# 1.2.2: KV integers are read at their own width and sign-extended
fn test_gguf_kv_width(): i64 {
    # a buffer ending in a u16 general.alignment, flush against an unmapped page
    var buf = alloc(8192);
    var offp = alloc(8); store64(offp, 0);
    _gg_head(buf, offp, 0, 2);
    _ggw_str(buf, offp, "f"); _ggw_u32(buf, offp, 8);
    var pad = alloc(4096);
    var k = 0;
    while (k < 4020) { store8(pad + k, 120); k = k + 1; }
    store8(pad + 4020, 0);
    _ggw_str(buf, offp, pad);
    _ggw_str(buf, offp, "general.alignment"); _ggw_u32(buf, offp, 2);
    _ggw_u8(buf, offp, 32); _ggw_u8(buf, offp, 0);
    assert_eq(load64(offp), 4096, "the u16 KV ends the 4096-byte buffer");
    var g = mmap_anon(8192);
    cyr_munmap(g + 4096, 4096);
    var j = 0;
    while (j < 4096) { store8(g + j, load8(buf + j)); j = j + 1; }
    var r = gg_open(g, 4096);
    assert_nonnull(r, "a u16 alignment at the very end opens (no 4-byte over-read)");
    var fnd = alloc(8);
    assert_eq(gg_kv_int(r, "general.alignment", fnd), 32, "u16 alignment reads as 32");
    # signed KVs: i8 / i16 / i32 holding -1
    store64(offp, 0);
    _gg_head(buf, offp, 0, 3);
    _ggw_str(buf, offp, "a"); _ggw_u32(buf, offp, 1); _ggw_u8(buf, offp, 255);
    _ggw_str(buf, offp, "b"); _ggw_u32(buf, offp, 3); _ggw_u8(buf, offp, 255); _ggw_u8(buf, offp, 255);
    _ggw_str(buf, offp, "c"); _ggw_u32(buf, offp, 5); _ggw_u32(buf, offp, 4294967295);
    var off = load64(offp);
    while ((off % 32) != 0) { _ggw_u8(buf, offp, 0); off = off + 1; }
    r = gg_open(buf, off);
    assert_nonnull(r, "signed-KV file opens");
    assert_eq(gg_kv_int(r, "a", fnd), 0 - 1, "i8 -1 reads as -1");
    assert_eq(gg_kv_int(r, "b", fnd), 0 - 1, "i16 -1 reads as -1");
    assert_eq(gg_kv_int(r, "c", fnd), 0 - 1, "i32 -1 reads as -1");
    return 0;
}

# ---- 1.6.0: the legacy block types (Q4_0, Q4_1, Q5_0, Q5_1, Q8_0) --------------
fn _is_nan64(b): i64 {
    if (((b >> 52) & 0x7FF) == 0x7FF && (b & 0xFFFFFFFFFFFFF) != 0) { return 1; }
    return 0;
}
fn _is_inf64(b): i64 {
    if (((b >> 52) & 0x7FF) == 0x7FF && (b & 0xFFFFFFFFFFFFF) == 0) { return 1; }
    return 0;
}

# read [start, start + n) of q into c and count its differences from the whole read a
fn _qb_range(r, q, a, c, start, n): i64 {
    if (gg_read_f64_range(r, q, start, n, c) != n) { return n + 1; }
    var bad = 0;
    var i = 0;
    while (i < n) {
        if (load64(c + i * 8) != load64(a + (start + i) * 8)) { bad = bad + 1; }
        i = i + 1;
    }
    return bad;
}

# One type of an oracle fixture: <qn> (ne weights of type gt in blocks of be, random
# bytes) dequantizes to <rn> (gguf-py's dequantize as F32) bit for bit, a NaN
# matching any NaN; and every sub-range, on or off block boundaries, reads the
# same values as the whole tensor.
fn _qb_check(r, qn, rn, gt, bb): i64 { return _qb_check_n(r, qn, rn, gt, bb, 1024, 32); }
fn _qb_check_n(r, qn, rn, gt, bb, ne, be): i64 {
    var q = gg_find(r, qn);
    var f = gg_find(r, rn);
    assert_nonnull(q, "the oracle holds the block tensor");
    assert_nonnull(f, "the oracle holds the reference tensor");
    assert_eq(gg_entry_gtype(q), gt, "the block tensor has its type");
    assert_eq(gg_entry_nelems(q), ne, "4 rows of the fixture's width");
    assert_eq(gg_entry_nbytes(q), (ne / be) * bb, "whole blocks of the type's size");
    var a = t_alloc(ne);
    var b = t_alloc(ne);
    assert_eq(gg_read_f64(r, q, a), ne, "the block tensor reads");
    assert_eq(gg_read_f64(r, f, b), ne, "the reference reads");
    var diffs = 0;
    var nan = 0;
    var inf = 0;
    var i = 0;
    while (i < ne) {
        var x = load64(a + i * 8);
        var y = load64(b + i * 8);
        if (_is_nan64(y) == 1) {
            nan = nan + 1;
            if (_is_nan64(x) == 0) { diffs = diffs + 1; }
        } elif (x != y) { diffs = diffs + 1; }
        if (_is_inf64(y) == 1) { inf = inf + 1; }
        i = i + 1;
    }
    assert_eq(diffs, 0, "the dequantization equals gguf-py's, bit for bit");
    assert_gt(nan, 0, "the oracle reaches NaN");
    assert_gt(inf, 0, "the oracle reaches infinity");
    var c = t_alloc(ne);
    var bad = _qb_range(r, q, a, c, 0, 1);
    bad = bad + _qb_range(r, q, a, c, 5, 27);
    bad = bad + _qb_range(r, q, a, c, 31, 2);
    bad = bad + _qb_range(r, q, a, c, 17, 100);
    bad = bad + _qb_range(r, q, a, c, 33, 991);
    bad = bad + _qb_range(r, q, a, c, 1000, 24);
    bad = bad + _qb_range(r, q, a, c, 1023, 1);
    bad = bad + _qb_range(r, q, a, c, 512, 0);
    bad = bad + _qb_range(r, q, a, c, 256, 512);
    bad = bad + _qb_range(r, q, a, c, ne - 1, 1);
    if (ne > 1024) {                                         # across superblock boundaries
        bad = bad + _qb_range(r, q, a, c, 250, 20);
        bad = bad + _qb_range(r, q, a, c, 255, 2);
        bad = bad + _qb_range(r, q, a, c, 300, 3000);
        bad = bad + _qb_range(r, q, a, c, 1024, 3072);
    }
    assert_eq(bad, 0, "every sub-range reads what the whole read gave");
    assert_eq(gg_read_f64_range(r, q, ne - 24, 25, c), 0 - 1, "a range past the end is refused");
    assert_eq(gg_read_f64_range(r, q, 0 - 1, 1, c), 0 - 1, "a negative start is refused");
    assert_eq(gg_read_f64_range(r, q, 0, ne + 1, c), 0 - 1, "a range longer than the tensor is refused");
    return 0;
}

fn test_gguf_qblocks_oracle(): i64 {
    var r = gg_open_mmap("tests/fixtures/gguf_qblocks_v1.gguf");
    assert_nonnull(r, "the block oracle fixture (gguf-py-written) opens");
    assert_eq(gg_count(r), 10, "five types, a block tensor and a reference each");
    _qb_check(r, "q4_0.q", "q4_0.ref", GG_T_Q4_0(), 18);
    _qb_check(r, "q4_1.q", "q4_1.ref", GG_T_Q4_1(), 20);
    _qb_check(r, "q5_0.q", "q5_0.ref", GG_T_Q5_0(), 22);
    _qb_check(r, "q5_1.q", "q5_1.ref", GG_T_Q5_1(), 24);
    _qb_check(r, "q8_0.q", "q8_0.ref", GG_T_Q8_0(), 34);
    return 0;
}

# 1.6.1: the K-quants against gguf-py (tests/fixtures/gguf_kblocks_v1.gguf: 4 rows of
# 1024 weights, 16 superblocks per type)
fn test_gguf_kblocks_oracle(): i64 {
    var r = gg_open_mmap("tests/fixtures/gguf_kblocks_v1.gguf");
    assert_nonnull(r, "the K-quant oracle fixture (gguf-py-written) opens");
    assert_eq(gg_count(r), 10, "five K-quants, a block tensor and a reference each");
    _qb_check_n(r, "q2_k.q", "q2_k.ref", GG_T_Q2_K(), 84, 4096, 256);
    _qb_check_n(r, "q3_k.q", "q3_k.ref", GG_T_Q3_K(), 110, 4096, 256);
    _qb_check_n(r, "q4_k.q", "q4_k.ref", GG_T_Q4_K(), 144, 4096, 256);
    _qb_check_n(r, "q5_k.q", "q5_k.ref", GG_T_Q5_K(), 176, 4096, 256);
    _qb_check_n(r, "q6_k.q", "q6_k.ref", GG_T_Q6_K(), 210, 4096, 256);
    return 0;
}

# A GPT-2 with token_embd and every block weight in type qt imports through
# anuk_ggpt2_pack to the original params bit for bit, so the mapping's row reads and
# transposes are right over block payloads; the logits match too.
fn _q_roundtrip(qt, lo, hi): i64 { return _q_roundtrip_c(qt, lo, hi, 32, 2); }
# the same at width C over NL blocks (a K-quant row is 256 weights, so C = 256)
fn _q_roundtrip_c(qt, lo, hi, C, NL): i64 {
    var V = 13; var T = 6; var nh = 2;
    var cfg = alloc(64);
    ru_cfg_init(cfg, V, C, T, nh, nh, NL, 4 * C, 1);
    var np = ru_params_count(cfg);
    var P = t_alloc(np);
    _fillq(P, np, qt, lo, hi);
    var lenp = alloc(8);
    var buf = _export_gguf_q(cfg, P, lenp, qt);
    var r = gg_open(buf, load64(lenp));
    assert_nonnull(r, "the quantized GPT-2 GGUF opens");
    assert_eq(gg_entry_gtype(gg_find(r, "token_embd.weight")), qt, "token_embd is in the block type");
    assert_eq(gg_entry_gtype(gg_find(r, "blk.0.ffn_down.weight")), qt, "ffn_down is in the block type");
    assert_eq(gg_entry_gtype(gg_find(r, "blk.0.attn_norm.weight")), GG_T_F32(), "norms stay F32");
    var cfg2 = alloc(64);
    assert_eq(anuk_ggpt2_infer_cfg(r, cfg2, 0), 0, "infer_cfg ok");
    var P2 = t_alloc(np);
    assert_eq(anuk_ggpt2_pack(r, cfg2, P2), 0, "the quantized pack is ok");
    var diffs = 0;
    var i = 0;
    while (i < np) {
        if (load64(P2 + i * 8) != load64(P + i * 8)) { diffs = diffs + 1; }
        i = i + 1;
    }
    assert_eq(diffs, 0, "the quantized import is bit-identical to the original params");
    var tokens = alloc(T * 8);
    var t = 0;
    while (t < T) { store64(tokens + t * 8, (t * 5 + 2) % V); t = t + 1; }
    var L1 = t_alloc(T * V);
    var L2 = t_alloc(T * V);
    ru_model_fwd(cfg, P, tokens, L1, 0);
    ru_model_fwd(cfg2, P2, tokens, L2, 0);
    var ld = 0;
    i = 0;
    while (i < T * V) {
        if (load64(L1 + i * 8) != load64(L2 + i * 8)) { ld = ld + 1; }
        i = i + 1;
    }
    assert_eq(ld, 0, "the quantized import's logits are bit-identical");
    return 0;
}

fn test_gguf_quant_gpt2_roundtrip(): i64 {
    _q_roundtrip(GG_T_Q8_0(), 0 - 50, 50);
    _q_roundtrip(GG_T_Q4_0(), 0 - 8, 7);
    _q_roundtrip(GG_T_Q4_1(), 0 - 8, 7);
    _q_roundtrip(GG_T_Q5_0(), 0 - 16, 15);
    _q_roundtrip(GG_T_Q5_1(), 0 - 16, 15);
    # 1.6.1: the K-quants, at C = 256 (F = 1024)
    _q_roundtrip_c(GG_T_Q2_K(), 0 - 2, 1, 256, 1);
    _q_roundtrip_c(GG_T_Q3_K(), 0 - 4, 3, 256, 1);
    _q_roundtrip_c(GG_T_Q4_K(), 0 - 8, 7, 256, 1);
    _q_roundtrip_c(GG_T_Q5_K(), 0 - 16, 15, 256, 1);
    _q_roundtrip_c(GG_T_Q6_K(), 0 - 32, 31, 256, 1);
    return 0;
}

# a one-tensor GGUF: `name` of type gt, ne = [ne0] or [ne0, ne1], with nraw raw bytes
fn _q_one(gt, ne0, ne1, nraw, lenp): i64 {
    var raw = alloc(nraw + 8);
    var i = 0;
    while (i < nraw) { store8(raw + i, (i * 37 + 11) & 0xFF); i = i + 1; }
    var w = _ggw_new();
    var nd = 1;
    if (ne1 != 0) { nd = 2; }
    _ggw_add_raw(w, "t", raw, ne0, ne1, nd, gt, nraw);
    return _ggw_finish(w, 0, 32, 0, lenp);
}
fn _q_opens(gt, ne0, ne1, nraw): i64 {
    var lenp = alloc(8);
    var buf = _q_one(gt, ne0, ne1, nraw, lenp);
    if (gg_open(buf, load64(lenp)) == 0) { return 0; }
    return 1;
}

fn test_gguf_quant_rejects(): i64 {
    var lenp = alloc(8);
    var buf = _q_one(GG_T_Q8_0(), 64, 0, 68, lenp);
    var r = gg_open(buf, load64(lenp));
    assert_nonnull(r, "a two-block Q8_0 vector opens");
    assert_eq(gg_entry_nbytes(gg_entry(r, 0)), 68, "its payload is 2 x 34 bytes");
    assert(streq(gg_type_name(GG_T_Q8_0()), "Q8_0") == 1, "the type is named");
    assert_eq(_q_opens(GG_T_Q8_0(), 32, 3, 102), 1, "a [32, 3] Q8_0 matrix opens");
    assert_eq(_q_opens(GG_T_Q5_1(), 64, 2, 96), 1, "a [64, 2] Q5_1 matrix opens");
    assert_eq(_q_opens(GG_T_Q8_0(), 48, 0, 68), 0, "a row that isn't whole blocks is rejected");
    assert_eq(_q_opens(GG_T_Q4_0(), 32, 2, 18), 0, "one block of payload for two is rejected");
    assert_eq(_q_opens(GG_T_Q8_0(), 64, 0, 67), 0, "a payload one byte short is rejected");
    assert_eq(_q_opens(GG_T_Q4_1(), 1, 0, 20), 0, "a 1-weight block tensor is rejected");
    # 1.6.1: the K-quants' 256-weight superblocks
    assert_eq(_q_opens(GG_T_Q4_K(), 512, 2, 4 * 144), 1, "a [512, 2] Q4_K matrix opens");
    assert_eq(_q_opens(GG_T_Q6_K(), 256, 0, 210), 1, "a one-superblock Q6_K vector opens");
    assert_eq(_q_opens(GG_T_Q2_K(), 128, 0, 84), 0, "a K-quant row of half a superblock is rejected");
    assert_eq(_q_opens(GG_T_Q3_K(), 768, 0, 3 * 110 - 1), 0, "a K-quant payload one byte short is rejected");
    assert_eq(_q_opens(GG_T_Q5_K(), 32, 0, 176), 0, "a 32-weight row is not a K-quant row");
    # the removed Q4_2 / Q4_3 (4, 5), Q8_1 (9), Q8_K (15) and later ids
    var t = 4;
    var opened = 0;
    while (t < 40) {
        if (gg_type_is_quant(t) == 0) { opened = opened + _q_opens(t, 256, 0, 512); }
        t = t + 1;
    }
    assert_eq(opened, 0, "every other ggml type id is rejected");
    assert_eq(gg_type_is_quant(GG_T_Q3_K()), 1, "Q3_K is a block type");
    assert_eq(gg_type_is_quant(9) + gg_type_is_quant(15), 0, "Q8_1 and Q8_K are not");
    assert(streq(gg_type_name(GG_T_Q5_K()), "Q5_K") == 1, "a K-quant is named");
    assert(streq(gg_type_name(15), "?") == 1, "an unsupported type has no name");
    assert_eq(gg_type_is_quant(GG_T_F16()), 0, "F16 is not a block type");
    return 0;
}

# anuk_weight_drift, gpt2-qgguf's weight measure: exact on small cases
fn test_weight_drift(): i64 {
    var p = t_alloc(4);
    var q = t_alloc(4);
    tset(p, 0, f64_from(3)); tset(p, 1, f64_from(0 - 4)); tset(p, 2, f64_from(0)); tset(p, 3, f64_from(0));
    var out = alloc(24);
    anuk_weight_drift(p, p, 4, out);
    assert_eq(load64(out), f64_from(0), "identical: max 0");
    assert_eq(load64(out + 8), f64_from(0), "identical: relative RMS 0");
    anuk_weight_drift(p, q, 4, out);                       # q all zero
    assert_eq(load64(out), f64_from(4), "against zero: max |dW| = 4");
    assert_eq(load64(out + 8), f64_from(1), "against zero: relative RMS exactly 1");
    tset(q, 0, f64_from(0 - 3)); tset(q, 1, f64_from(4));
    anuk_weight_drift(p, q, 4, out);                       # q = -p
    assert_eq(load64(out + 8), f64_from(2), "q = -p: relative RMS 2");
    tset(q, 2, f64_div(f64_from(0), f64_from(0)));         # a NaN in q
    anuk_weight_drift(p, q, 4, out);
    assert_eq(load64(out + 16), 1, "the NaN is counted");
    assert_eq(load64(out + 8), f64_from(2), "and left out of the sums");
    anuk_weight_drift(q, q, 2, out);
    assert_eq(load64(out + 8), f64_from(0), "a zero-error run over nonzero p");
    return 0;
}

fn main(): i64 {
    alloc_init();
    test_weight_drift();
    test_gguf_qblocks_oracle();
    test_gguf_kblocks_oracle();
    test_gguf_quant_gpt2_roundtrip();
    test_gguf_quant_rejects();
    test_gguf_minimal();
    test_gguf_gpt2_roundtrip();
    test_gguf_hostile_head_count();
    test_gguf_qkv_shape();
    test_gguf_dims_wrap();
    test_gguf_kv_width();
    return assert_summary();
}

var rc = main();
sys_exit(rc);
