# tests/tcyr/gpt2.tcyr — M2 bite 2: GPT-2 -> rupantara mapping, round-trip fidelity.
# Build a model in rupantara's packed layout, EXPORT it as GPT-2-named safetensors
# (bayan builds the JSON header; Q/K/V fused back into c_attn), then IMPORT it back
# via anuk_gpt2_infer_cfg + anuk_gpt2_pack and assert (a) the packed params are
# bit-identical and (b) ru_model_fwd on the imported model == the direct forward.
# Self-contained (no external checkpoint); the real GPT-2-small + HF-reference gate
# is bite 3.
include "src/lib.cyr"
include "lib/assert.cyr"

include "tests/common.cyr"

fn _fill(p, n, seed): i64 {
    var i = 0;
    while (i < n) {
        var m = ((i * 131 + seed * 17 + 7) % 101) - 50;
        store64(p + i * 8, f64_div(f64_from(m), f64_from(37)));
        i = i + 1;
    }
    return 0;
}

fn test_gpt2_roundtrip(): i64 {
    var V = 5; var C = 4; var T = 3; var nh = 2; var NL = 1;
    var cfg = alloc(64);
    ru_cfg_init(cfg, V, C, T, nh, nh, NL, 4 * C, 1);   # bias=1 (GPT-2)
    var np = ru_params_count(cfg);
    var P = alloc(np * 8);
    _fill(P, np, 3);

    # export -> safetensors, import back
    var lenbox = alloc(8);
    var blob = _export_gpt2(cfg, P, lenbox);
    var total = load64(lenbox);
    var r = st_open(blob, total);
    assert(r != 0, "st_open parsed the exported GPT-2 safetensors");

    var cfg2 = alloc(64);
    assert_eq(anuk_gpt2_infer_cfg(r, cfg2, nh), 0, "infer_cfg ok");
    assert_eq(_cfg_V(cfg2), V, "inferred V");
    assert_eq(_cfg_C(cfg2), C, "inferred C");
    assert_eq(_cfg_T(cfg2), T, "inferred T");
    assert_eq(_cfg_NL(cfg2), NL, "inferred NL");
    assert_eq(ru_params_count(cfg2), np, "inferred params count matches");

    var P2 = alloc(np * 8);
    assert_eq(anuk_gpt2_pack(r, cfg2, P2), 0, "anuk_gpt2_pack ok");

    # (a) packed params bit-identical (import inverts export exactly)
    var diffs = 0;
    var i = 0;
    while (i < np) { if (load64(P + i * 8) != load64(P2 + i * 8)) { diffs = diffs + 1; } i = i + 1; }
    assert_eq(diffs, 0, "imported params bit-identical to the original");

    # (b) the imported model RUNS and matches the direct forward bit-for-bit
    var tokens = alloc(T * 8);
    store64(tokens + 0, 1); store64(tokens + 8, 3); store64(tokens + 16, 0);
    var L1 = alloc(T * V * 8);
    var L2 = alloc(T * V * 8);
    ru_model_fwd(cfg, P, tokens, L1, 0);
    ru_model_fwd(cfg2, P2, tokens, L2, 0);
    var ldiff = 0;
    i = 0;
    while (i < T * V) { if (load64(L1 + i * 8) != load64(L2 + i * 8)) { ldiff = ldiff + 1; } i = i + 1; }
    assert_eq(ldiff, 0, "imported model logits bit-identical to the direct forward");

    # (c) 1.2.1: a config rupantara's ru_cfg_check rejects is refused at inference,
    # before ru_params_count (now -1 for it) sizes anything. C = 4 here.
    var cfg3 = alloc(64);
    assert_eq(anuk_gpt2_infer_cfg(r, cfg3, 3), 0 - 1, "nh not dividing C rejected");
    assert_eq(anuk_gpt2_infer_cfg(r, cfg3, 0), 0 - 1, "nh = 0 rejected");
    return 0;
}

# f32-exact fill (small ints over 32): lossless through the F32 narrow/widen
fn _fill32(p, n, seed): i64 {
    var i = 0;
    while (i < n) {
        var m = ((i * 131 + seed * 17 + 7) % 101) - 50;
        store64(p + i * 8, f64_div(f64_from(m), f64_from(32)));
        i = i + 1;
    }
    return 0;
}

# 1.2.2: the real checkpoints are F32 — round-trip through an F32 file (the bulk
# widener, the range reads and the direct qkv split) must be bit-identical too
fn test_gpt2_f32_roundtrip(): i64 {
    var V = 7; var C = 8; var T = 4; var nh = 2; var NL = 2;
    var cfg = alloc(64);
    ru_cfg_init(cfg, V, C, T, nh, nh, NL, 4 * C, 1);
    var np = ru_params_count(cfg);
    var P = alloc(np * 8);
    _fill32(P, np, 5);
    var lenbox = alloc(8);
    var blob = _export_gpt2_dt(cfg, P, lenbox, 1);
    var r = st_open(blob, load64(lenbox));
    assert_nonnull(r, "F32 GPT-2 safetensors opens");
    var cfg2 = alloc(64);
    assert_eq(anuk_gpt2_infer_cfg(r, cfg2, nh), 0, "F32: infer_cfg ok");
    var P2 = alloc(np * 8);
    assert_eq(anuk_gpt2_pack(r, cfg2, P2), 0, "F32: pack ok");
    var diffs = 0;
    var i = 0;
    while (i < np) { if (load64(P + i * 8) != load64(P2 + i * 8)) { diffs = diffs + 1; } i = i + 1; }
    assert_eq(diffs, 0, "F32: imported params bit-identical");

    # the CLI's batch-vs-decode check on the imported model (1.2.2: one shared copy,
    # allocation-free per token, return codes checked)
    var tokens = _anuk_demo_tokens(T, V);
    var Lb = alloc(T * V * 8);
    assert_eq(anuk_decode_check(cfg2, P2, tokens, Lb), 0, "decode == batch, 0 logit diffs");
    var u0 = alloc_used();
    anuk_decode_check(cfg2, P2, tokens, Lb);
    var grew = alloc_used() - u0;
    assert(grew <= V * 8 + 64, "a decode check allocates one logits row, not per-token scratch");
    store64(tokens + 8, V);                            # a token id outside [0, V)
    assert_eq(anuk_decode_check(cfg2, P2, tokens, Lb), RU_ERR_TOKEN(), "bad token -> RU_ERR_TOKEN");
    return 0;
}

# a 1-layer GPT-2 export with one header shape lied about (payload unchanged):
# mode 1 declares c_attn.weight [3C, C] (transposed), mode 2 declares wpe [2T, C/2],
# mode 3 gives mlp.c_fc.weight 2F columns (right rows, too many columns)
fn _export_lie(cfg, P, out_len, mode): i64 {
    var V = _cfg_V(cfg); var C = _cfg_C(cfg); var T = _cfg_T(cfg);
    var F = _cfg_F(cfg);
    var w = _stw_new();
    _stw_add(w, "wte.weight", _p_tokemb(P), _shp2(V, C), 2);
    if (mode == 2) { _stw_add(w, "wpe.weight", _p_posemb(P, cfg), _shp2(2 * T, C / 2), 2); }
    else { _stw_add(w, "wpe.weight", _p_posemb(P, cfg), _shp2(T, C), 2); }
    var pblk = P + _ru_blk_base(cfg, 0) * 8;
    _stw_add(w, _nm(0, "ln_1.weight"), pblk + _ru_o_ln1g(cfg) * 8, _shp1(C), 1);
    _stw_add(w, _nm(0, "ln_1.bias"), pblk + _ru_o_ln1b(cfg) * 8, _shp1(C), 1);
    if (mode == 1) { _stw_add(w, _nm(0, "attn.c_attn.weight"), alloc(3 * C * C * 8), _shp2(3 * C, C), 2); }
    else { _stw_add(w, _nm(0, "attn.c_attn.weight"), alloc(3 * C * C * 8), _shp2(C, 3 * C), 2); }
    _stw_add(w, _nm(0, "attn.c_attn.bias"), alloc(3 * C * 8), _shp1(3 * C), 1);
    _stw_add(w, _nm(0, "attn.c_proj.weight"), pblk + _ru_o_Wo(cfg) * 8, _shp2(C, C), 2);
    _stw_add(w, _nm(0, "attn.c_proj.bias"), _bo(cfg, pblk), _shp1(C), 1);
    _stw_add(w, _nm(0, "ln_2.weight"), pblk + _ru_o_ln2g(cfg) * 8, _shp1(C), 1);
    _stw_add(w, _nm(0, "ln_2.bias"), pblk + _ru_o_ln2b(cfg) * 8, _shp1(C), 1);
    if (mode == 3) { _stw_add(w, _nm(0, "mlp.c_fc.weight"), alloc(2 * F * C * 8), _shp2(C, 2 * F), 2); }
    else { _stw_add(w, _nm(0, "mlp.c_fc.weight"), pblk + _ru_o_Wfc(cfg) * 8, _shp2(C, F), 2); }
    _stw_add(w, _nm(0, "mlp.c_fc.bias"), pblk + _ru_o_bfc(cfg) * 8, _shp1(F), 1);
    _stw_add(w, _nm(0, "mlp.c_proj.weight"), pblk + _ru_o_Wproj(cfg) * 8, _shp2(F, C), 2);
    _stw_add(w, _nm(0, "mlp.c_proj.bias"), pblk + _ru_o_bproj(cfg) * 8, _shp1(C), 1);
    _stw_add(w, "ln_f.weight", _p_lnfg(P, cfg), _shp1(C), 1);
    _stw_add(w, "ln_f.bias", _p_lnfb(P, cfg), _shp1(C), 1);
    return _stw_finish(w, out_len);
}

# 1.2.2: shapes are checked exactly, not just by element count
fn test_gpt2_shape_lies(): i64 {
    var cfg = alloc(64);
    ru_cfg_init(cfg, 5, 4, 3, 2, 2, 1, 16, 1);
    var np = ru_params_count(cfg);
    var P = alloc(np * 8);
    var lp = alloc(8);
    var r = st_open(_export_lie(cfg, P, lp, 1), load64(lp));
    var cfg2 = alloc(64);
    assert_eq(anuk_gpt2_infer_cfg(r, cfg2, 2), 0, "transposed-c_attn file: config still infers");
    assert_eq(anuk_gpt2_pack(r, cfg2, alloc(np * 8)), 0 - 2, "c_attn.weight declared [3C, C] rejected");
    r = st_open(_export_lie(cfg, P, lp, 2), load64(lp));
    assert_eq(anuk_gpt2_infer_cfg(r, cfg2, 2), 0 - 1, "wpe declared [2T, C/2] rejected");
    # right first dim, too many columns: would write past the c_fc slot if read
    r = st_open(_export_lie(cfg, P, lp, 3), load64(lp));
    assert_eq(anuk_gpt2_infer_cfg(r, cfg2, 2), 0, "wide-c_fc file: config still infers");
    assert_eq(anuk_gpt2_pack(r, cfg2, alloc(np * 8)), 0 - 2, "mlp.c_fc.weight [C, 2F] rejected");
    return 0;
}

fn main(): i64 {
    alloc_init();
    test_gpt2_roundtrip();
    test_gpt2_f32_roundtrip();
    test_gpt2_shape_lies();
    return assert_summary();
}

var rc = main();
sys_exit(rc);
