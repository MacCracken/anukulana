# tests/tcyr/nf4_store.tcyr — M4 tail: NF4-checkpoint + adapter persistence,
# toy scale. Gates the round-trip BIT-IDENTICAL and the trust boundary:
#   * save -> load(pk) reproduces the in-memory quantize->dequant EXACTLY
#   * cfg tensor reconstructs
#   * load with the WRONG pk is REJECTED (returns 0)
#   * a tampered payload byte is REJECTED (signature over [0, sig_off))
#   * adapter save -> load round-trips A/B/s bit-identical; wrong pk rejected
include "src/lib.cyr"
include "lib/assert.cyr"

fn _fillp(p, n): i64 {
    var i = 0;
    while (i < n) {
        var q = ((i * 29 + 7) % 23);
        store64(p + i * 8, f64_sub(f64_div(f64_from(q), f64_from(23)), f64_div(f64_from(1), f64_from(2))));
        i = i + 1;
    }
    return 0;
}

fn test_store(): i64 {
    # tiny model cfg: V=11 C=4 T=2 nh=1 nkv=1 NL=1 F=16
    var cfg = alloc(64);
    ru_cfg_init(cfg, 11, 4, 2, 1, 1, 1, 16, 1);
    var np = ru_params_count(cfg);
    var params = t_alloc(np);
    _fillp(params, np);

    var seed = alloc(32);
    var k = 0;
    while (k < 32) { store8(seed + k, (k * 5 + 1) & 0xFF); k = k + 1; }
    var sk = alloc(64);
    var pk = alloc(32);
    ed25519_keypair(seed, sk, pk);

    # ---- checkpoint save -> load -> bit-compare -------------------------------
    var path = "/tmp/anuk_nf4_store_test.tula";
    assert_eq(anuk_nf4_save(path, cfg, params, sk), 0, "checkpoint saved");
    # in-memory reference pipeline
    var bs = NF4_BS();
    var nb = tula_nf4_blocks(np, bs);
    var nibbles = alloc(tula_nf4_bytes(np));
    var scales = t_alloc(nb);
    tula_nf4_pack(params, np, bs, scales, nibbles);
    var q8 = alloc(nb);
    var supers = t_alloc((nb + NF4_SBS() - 1) / NF4_SBS());
    nf4_dq_pack(scales, nb, q8, supers);
    var scales_r = t_alloc(nb);
    nf4_dq_unpack(q8, supers, nb, scales_r);
    var ref_q = t_alloc(np);
    tula_nf4_unpack(nibbles, scales_r, np, bs, ref_q);
    var cfg2 = alloc(64);
    var loaded = anuk_nf4_load(path, pk, cfg2);
    assert_nonnull(loaded, "checkpoint loads with the right pk");
    var diffs = 0;
    var i = 0;
    while (i < np) { if (load64(loaded + i * 8) != load64(ref_q + i * 8)) { diffs = diffs + 1; } i = i + 1; }
    assert_eq(diffs, 0, "loaded base bit-identical to the in-memory pipeline");
    assert_eq(_cfg_V(cfg2), 11, "cfg.V round-trips");
    assert_eq(_cfg_F(cfg2), 16, "cfg.F round-trips");

    # ---- trust boundary: wrong pk / tampered byte -----------------------------
    var pk2 = alloc(32);
    var sk2 = alloc(64);
    var seed2 = alloc(32);
    k = 0;
    while (k < 32) { store8(seed2 + k, (k * 11 + 9) & 0xFF); k = k + 1; }
    ed25519_keypair(seed2, sk2, pk2);
    var cfg3 = alloc(64);
    assert_eq(anuk_nf4_load(path, pk2, cfg3), 0, "wrong pk REJECTED");
    # tamper one payload byte on disk
    var buf = alloc(1024 * 1024);
    var n = file_read_all(path, buf, 1024 * 1024);
    assert_gt(n, 200, "read checkpoint back for tampering");
    store8(buf + n - 100, load8(buf + n - 100) ^ 0x01);
    var tpath = "/tmp/anuk_nf4_store_tampered.tula";
    tula_write_file(tpath, buf, n);
    assert_eq(anuk_nf4_load(tpath, pk, cfg3), 0, "tampered payload REJECTED");

    # ---- adapter round-trip -----------------------------------------------------
    var C = 4;
    var r = 2;
    var V = 11;
    var A = t_alloc(C * r);
    var B = t_alloc(r * V);
    _fillp(A, C * r);
    _fillp(B, r * V);
    var s = f64_div(f64_from(3), f64_from(2));
    var apath = "/tmp/anuk_adapter_store_test.tula";
    assert_eq(anuk_adapter_save(apath, A, B, C, r, V, s, sk), 0, "adapter saved");
    var A2 = t_alloc(C * r);
    var B2 = t_alloc(r * V);
    var meta = t_alloc(2);
    assert_eq(anuk_adapter_load(apath, pk, A2, B2, C, r, V, meta), 0, "adapter loads");
    var ad = 0;
    i = 0;
    while (i < C * r) { if (load64(A2 + i * 8) != load64(A + i * 8)) { ad = ad + 1; } i = i + 1; }
    i = 0;
    while (i < r * V) { if (load64(B2 + i * 8) != load64(B + i * 8)) { ad = ad + 1; } i = i + 1; }
    assert_eq(ad, 0, "adapter A/B bit-identical after round-trip");
    assert(f64_eq(load64(meta), s), "adapter meta s round-trips");
    var badm = alloc(16);
    assert_eq(anuk_adapter_load(apath, pk2, A2, B2, C, r, V, badm), 0 - 1, "adapter wrong pk REJECTED");
    return 0;
}

# ---- operator-key file loading (1.1.1, ifran Lane 2) --------------------------
# anuk_sk_load reads a 64 B seed||pk secret-key file (ifran's operator.sk
# layout); signing with the LOADED key must verify against its embedded pk
# (sk+32), and a different key must still be rejected.
fn test_sk_load(): i64 {
    var seed = alloc(32);
    var k = 0;
    while (k < 32) { store8(seed + k, (k * 11 + 3) & 0xFF); k = k + 1; }
    var sk = alloc(64);
    var pk = alloc(32);
    ed25519_keypair(seed, sk, pk);
    var kpath = "/tmp/anuk_operator_test.sk";
    file_write_all(kpath, sk, 64);

    var lsk = anuk_sk_load(kpath);
    assert_nonnull(lsk, "operator key file loads");
    var diffs = 0;
    var i = 0;
    while (i < 64) { if (load8(lsk + i) != load8(sk + i)) { diffs = diffs + 1; } i = i + 1; }
    assert_eq(diffs, 0, "loaded sk bit-identical to the written one");
    i = 0;
    while (i < 32) { if (load8(lsk + 32 + i) != load8(pk + i)) { diffs = diffs + 1; } i = i + 1; }
    assert_eq(diffs, 0, "embedded pk (sk+32) matches ed25519_keypair's pk");

    assert_eq(anuk_sk_load("/tmp/anuk_no_such_key.sk"), 0, "absent key file -> 0");
    var shortp = "/tmp/anuk_short_key.sk";
    file_write_all(shortp, sk, 32);
    assert_eq(anuk_sk_load(shortp), 0, "short (32 B) key file -> 0");

    # sign a toy checkpoint with the LOADED key; verify via its embedded pk
    var cfg = alloc(64);
    ru_cfg_init(cfg, 11, 4, 2, 1, 1, 1, 16, 1);
    var np = ru_params_count(cfg);
    var params = t_alloc(np);
    _fillp(params, np);
    var path = "/tmp/anuk_nf4_opkey_test.tula";
    assert_eq(anuk_nf4_save(path, cfg, params, lsk), 0, "checkpoint saved with loaded operator key");
    var cfg2 = alloc(64);
    assert_nonnull(anuk_nf4_load(path, lsk + 32, cfg2), "load verifies against embedded pk (sk+32)");
    var seed2 = alloc(32);
    k = 0;
    while (k < 32) { store8(seed2 + k, (k * 13 + 9) & 0xFF); k = k + 1; }
    var sk2 = alloc(64);
    var pk2 = alloc(32);
    ed25519_keypair(seed2, sk2, pk2);
    assert_eq(anuk_nf4_load(path, pk2, cfg2), 0, "different operator key still REJECTED");
    return 0;
}

# 1.2.1: a correctly signed checkpoint whose cfg tensor rupantara rejects (nh = 0)
# is refused, not crashed. It carries well-formed base tensors, so without the
# ru_cfg_check guard the load still reaches ru_params_count(cfg): through
# rupantara 0.5.1 that divided by zero (C / nh); from 0.5.2 it returns -1.
fn test_bad_cfg_rejected(): i64 {
    var seed = alloc(32);
    var k = 0;
    while (k < 32) { store8(seed + k, (k * 3 + 2) & 0xFF); k = k + 1; }
    var sk = alloc(64);
    var pk = alloc(32);
    ed25519_keypair(seed, sk, pk);
    var cfgv = t_alloc(8);
    store64(cfgv + 0 * 8, f64_from(11));   # V
    store64(cfgv + 1 * 8, f64_from(4));    # C
    store64(cfgv + 2 * 8, f64_from(2));    # T
    store64(cfgv + 3 * 8, f64_from(0));    # nh = 0
    store64(cfgv + 4 * 8, f64_from(0));    # nkv = 0
    store64(cfgv + 5 * 8, f64_from(1));    # NL
    store64(cfgv + 6 * 8, f64_from(16));   # F
    store64(cfgv + 7 * 8, f64_from(1));    # attn bias
    var np = 100;                          # zeroed base tensors of consistent sizes
    var nb = tula_nf4_blocks(np, NF4_BS());
    var nsb = (nb + NF4_SBS() - 1) / NF4_SBS();
    var b = tula_builder_new();
    tula_builder_add(b, "cfg", TULA_DT_F64, _nfs_shp1(8), 1, cfgv, 64);
    tula_builder_add(b, "base.nf4", TULA_DT_NF4, _nfs_shp1(np), 1, alloc(tula_nf4_bytes(np)),
      tula_nf4_bytes(np));
    tula_builder_add(b, "base.nf4.scale.q8", TULA_DT_INT8, _nfs_shp1(nb), 1, alloc(nb), nb);
    tula_builder_add(b, "base.nf4.scale.sup", TULA_DT_F64, _nfs_shp1(nsb), 1, t_alloc(nsb), nsb * 8);
    var buf = tula_builder_finish_signed(b, sk);
    assert_nonnull(buf, "bad-cfg checkpoint built and signed");
    var path = "/tmp/anuk_nf4_store_badcfg.tula";
    var total = tula_total_len(buf);
    assert_eq(tula_write_file(path, buf, total), total, "bad-cfg checkpoint written");
    var cfg2 = alloc(64);
    assert_eq(anuk_nf4_load(path, pk, cfg2), 0, "signed checkpoint with nh = 0 REJECTED");
    return 0;
}

fn _mf_keys(sk, pk): i64 {
    var seed = alloc(32);
    var k = 0;
    while (k < 32) { store8(seed + k, (k * 11 + 3) & 0xFF); k = k + 1; }
    ed25519_keypair(seed, sk, pk);
    return 0;
}
fn _mf_write(b, sk, path): i64 {
    var buf = tula_builder_finish_signed(b, sk);
    return tula_write_file(path, buf, tula_total_len(buf));
}
# an adapter file; `mode` breaks one thing (0 = valid)
fn _mf_adapter(sk, path, mode): i64 {
    var C = 4; var r = 2; var V = 3;
    var meta = t_alloc(2);
    store64(meta, f64_from(2));
    store64(meta + 8, f64_from(r));
    if (mode == 4) { store64(meta + 8, f64_from(r + 1)); }   # meta says another rank
    var b = tula_builder_new();
    if (mode == 2) { tula_builder_add(b, "lora.A", TULA_DT_INT8, _nfs_shp2(C, r), 2, alloc(C * r), C * r); }
    else { tula_builder_add(b, "lora.A", TULA_DT_F64, _nfs_shp2(C, r), 2, t_alloc(C * r), C * r * 8); }
    if (mode == 3) { tula_builder_add(b, "lora.A", TULA_DT_F64, _nfs_shp2(C, r), 2, t_alloc(C * r), C * r * 8); }
    tula_builder_add(b, "lora.B", TULA_DT_F64, _nfs_shp2(r, V), 2, t_alloc(r * V), r * V * 8);
    if (mode == 1) { tula_builder_add(b, "lora.meta", TULA_DT_F64, _nfs_shp1(1), 1, meta, 8); }
    else { tula_builder_add(b, "lora.meta", TULA_DT_F64, _nfs_shp1(2), 1, meta, 16); }
    return _mf_write(b, sk, path);
}
# an NF4 checkpoint for a cfg with nb > 256 (two superblocks); `mode` breaks one thing
fn _mf_ckpt(sk, path, mode): i64 {
    var cfg = alloc(64);
    ru_cfg_init(cfg, 600, 32, 2, 1, 1, 1, 128, 1);
    var np = ru_params_count(cfg);
    var nb = tula_nf4_blocks(np, NF4_BS());
    var cfgv = t_alloc(8);
    store64(cfgv, f64_from(600)); store64(cfgv + 8, f64_from(32)); store64(cfgv + 16, f64_from(2));
    store64(cfgv + 24, f64_from(1)); store64(cfgv + 32, f64_from(1)); store64(cfgv + 40, f64_from(1));
    store64(cfgv + 48, f64_from(128)); store64(cfgv + 56, f64_from(1));
    var b = tula_builder_new();
    if (mode == 2) { tula_builder_add(b, "cfg", TULA_DT_INT8, _nfs_shp1(64), 1, cfgv, 64); }
    else { tula_builder_add(b, "cfg", TULA_DT_F64, _nfs_shp1(8), 1, cfgv, 64); }
    if (mode == 3) { tula_builder_add(b, "base.nf4", TULA_DT_F64, _nfs_shp1(np), 1, t_alloc(np), np * 8); }
    else {
        tula_builder_add(b, "base.nf4", TULA_DT_NF4, _nfs_shp1(np), 1, alloc(tula_nf4_bytes(np)),
          tula_nf4_bytes(np));
    }
    tula_builder_add(b, "base.nf4.scale.q8", TULA_DT_INT8, _nfs_shp1(nb), 1, alloc(nb), nb);
    if (mode == 1) { tula_builder_add(b, "base.nf4.scale.sup", TULA_DT_F64, _nfs_shp1(1), 1, t_alloc(1), 8); }
    else { tula_builder_add(b, "base.nf4.scale.sup", TULA_DT_F64, _nfs_shp1(2), 1, t_alloc(2), 16); }
    return _mf_write(b, sk, path);
}

# 1.2.2: signed files are read only if every tensor is exactly what the layout
# says. Through 1.2.1 each of these was accepted and read past a payload.
fn test_malformed_files(): i64 {
    var sk = alloc(64);
    var pk = alloc(32);
    _mf_keys(sk, pk);
    var A = t_alloc(8); var B = t_alloc(6); var out = t_alloc(2);
    var path = "/tmp/anuk_nf4_store_mf.tula";
    _mf_adapter(sk, path, 0);
    assert_eq(anuk_adapter_load(path, pk, A, B, 4, 2, 3, out), 0, "well-formed adapter loads");
    _mf_adapter(sk, path, 1);
    assert_eq(anuk_adapter_load(path, pk, A, B, 4, 2, 3, out), 0 - 1, "adapter with lora.meta [1] rejected");
    _mf_adapter(sk, path, 2);
    assert_eq(anuk_adapter_load(path, pk, A, B, 4, 2, 3, out), 0 - 1, "adapter with an INT8 lora.A rejected");
    _mf_adapter(sk, path, 3);
    assert_eq(anuk_adapter_load(path, pk, A, B, 4, 2, 3, out), 0 - 1,
      "adapter with two lora.A entries rejected (strict validation)");
    _mf_adapter(sk, path, 4);
    assert_eq(anuk_adapter_load(path, pk, A, B, 4, 2, 3, out), 0 - 1, "adapter whose meta rank differs rejected");
    var cfg2 = alloc(64);
    _mf_ckpt(sk, path, 0);
    assert_nonnull(anuk_nf4_load(path, pk, cfg2), "well-formed two-superblock checkpoint loads");
    _mf_ckpt(sk, path, 1);
    assert_eq(anuk_nf4_load(path, pk, cfg2), 0, "checkpoint with one superblock max where two are needed rejected");
    _mf_ckpt(sk, path, 2);
    assert_eq(anuk_nf4_load(path, pk, cfg2), 0, "checkpoint with an INT8 cfg rejected");
    _mf_ckpt(sk, path, 3);
    assert_eq(anuk_nf4_load(path, pk, cfg2), 0, "checkpoint whose base.nf4 is F64 rejected");
    # a cfg rupantara rejects is refused at save time too
    var bad = alloc(64);
    ru_cfg_init(bad, 11, 4, 2, 0, 0, 1, 16, 1);
    assert_eq(anuk_nf4_save(path, bad, t_alloc(8), sk), 0 - 1, "nf4_save with nh = 0 refused");
    return 0;
}

# 1.2.2: a key file must be exactly seed||pk, with pk derived from the seed
fn test_sk_file_checks(): i64 {
    var sk = alloc(96);
    var pk = alloc(32);
    _mf_keys(sk, pk);
    file_write_all("/tmp/anuk_sk_96.sk", sk, 96);
    assert_eq(anuk_sk_load("/tmp/anuk_sk_96.sk"), 0, "96-byte key file rejected");
    file_write_all("/tmp/anuk_sk_63.sk", sk, 63);
    assert_eq(anuk_sk_load("/tmp/anuk_sk_63.sk"), 0, "63-byte key file rejected");
    file_write_all("/tmp/anuk_sk_ok.sk", sk, 64);
    assert_nonnull(anuk_sk_load("/tmp/anuk_sk_ok.sk"), "a consistent 64-byte key loads");
    store8(sk + 40, load8(sk + 40) ^ 0xFF);
    file_write_all("/tmp/anuk_sk_bad.sk", sk, 64);
    assert_eq(anuk_sk_load("/tmp/anuk_sk_bad.sk"), 0, "a key whose pk half isn't derive(seed) rejected");
    return 0;
}

# read a whole file into a fresh buffer; its length via out_len
fn _mf_slurp(path, out_len): i64 {
    var cap = 128 * 1024 * 1024;
    var buf = mmap_anon(cap);
    var n = file_read_all(path, buf, cap);
    store64(out_len, n);
    return buf;
}
fn _mf_meta_is(r, key, want): i64 {
    var v = tula_meta_get(r, key);
    if (v == 0) { return 0; }
    return streq(v, want);
}

# 1.4.0: both savers write signed metadata through tula's checked, streaming
# writer; the _src variants record the input file and its SHA-256.
fn test_metadata(): i64 {
    var cfg = alloc(64);
    ru_cfg_init(cfg, 11, 4, 2, 1, 1, 1, 16, 1);
    var np = ru_params_count(cfg);
    var params = t_alloc(np);
    _fillp(params, np);
    var sk = alloc(64);
    var pk = alloc(32);
    _mf_keys(sk, pk);
    # a source "model": a few bytes that look like safetensors (u64 hlen, then '{')
    var src = alloc(64);
    store64(src, 2);
    store8(src + 8, 123); store8(src + 9, 125);
    var j = 10;
    while (j < 64) { store8(src + j, j); j = j + 1; }
    file_write_all("/tmp/anuk_meta_src.safetensors", src, 64);
    var want_sha = sha256_hex(src, 64);
    var path = "/tmp/anuk_meta_ckpt.tula";
    assert_eq(anuk_nf4_save_src(path, cfg, params, sk, "/tmp/anuk_meta_src.safetensors"), 0, "nf4_save_src ok");
    var r = tula_read_file(path);
    assert_nonnull(r, "checkpoint with metadata opens");
    assert_eq(tula_validate_strict(r, tula_total_len(r)), TULA_OK, "and is strictly valid (checked adds)");
    assert_eq(_mf_meta_is(r, "anukulana.kind", "nf4-checkpoint"), 1, "meta kind");
    assert_eq(_mf_meta_is(r, "anukulana.version", _nfs_version_str()), 1, "meta version");
    assert_eq(_mf_meta_is(r, "anukulana.layout", "rupantara-gpt2"), 1, "meta layout");
    assert_eq(_mf_meta_is(r, "anukulana.config",
        "{\"V\":11,\"C\":4,\"T\":2,\"nh\":1,\"nkv\":1,\"NL\":1,\"F\":16,\"attn_bias\":1}"), 1, "meta config JSON");
    assert_eq(_mf_meta_is(r, "anukulana.source.sha256", want_sha), 1, "meta source sha256 = sha256 of the source");
    assert_eq(_mf_meta_is(r, "anukulana.source.bytes", "64"), 1, "meta source bytes");
    assert_eq(_mf_meta_is(r, "anukulana.source.name", "anuk_meta_src.safetensors"), 1, "meta source basename");
    assert_eq(_mf_meta_is(r, "anukulana.source.format", "safetensors"), 1, "meta source format sniffed");
    var cfg2 = alloc(64);
    assert_nonnull(anuk_nf4_load(path, pk, cfg2), "a checkpoint with metadata still loads through the cfg tensor");
    # no timestamps: the same inputs give the same bytes
    var path2 = "/tmp/anuk_meta_ckpt2.tula";
    anuk_nf4_save_src(path2, cfg, params, sk, "/tmp/anuk_meta_src.safetensors");
    var l1 = alloc(8); var l2 = alloc(8);
    var f1 = _mf_slurp(path, l1);
    var f2 = _mf_slurp(path2, l2);
    assert_eq(load64(l1), load64(l2), "two saves: same length");
    assert_eq(memeq(f1, f2, load64(l1)), 1, "two saves of the same inputs are byte-identical");
    # the plain saver writes everything but the source keys
    anuk_nf4_save(path2, cfg, params, sk);
    var rp = tula_read_file(path2);
    assert_eq(_mf_meta_is(rp, "anukulana.kind", "nf4-checkpoint"), 1, "plain save: meta kind");
    assert_eq(tula_meta_get(rp, "anukulana.source.sha256"), 0, "plain save: no source keys");
    # the adapter records its base checkpoint
    var C = 4; var rr = 2; var V = 3;
    var apath = "/tmp/anuk_meta_adapter.tula";
    assert_eq(anuk_adapter_save_src(apath, t_alloc(C * rr), t_alloc(rr * V), C, rr, V, f64_from(2), sk, path), 0,
      "adapter_save_src ok");
    var ra = tula_read_file(apath);
    assert_eq(tula_validate_strict(ra, tula_total_len(ra)), TULA_OK, "adapter is strictly valid");
    assert_eq(_mf_meta_is(ra, "anukulana.kind", "lora-adapter"), 1, "adapter meta kind");
    assert_eq(_mf_meta_is(ra, "anukulana.adapter", "{\"C\":4,\"r\":2,\"V\":3,\"target\":\"lm_head\"}"), 1,
      "adapter meta shape JSON");
    assert_eq(_mf_meta_is(ra, "anukulana.base.sha256", sha256_hex(f1, load64(l1))), 1,
      "adapter meta base sha256 = sha256 of the checkpoint");
    assert_eq(_mf_meta_is(ra, "anukulana.base.format", "tula"), 1, "adapter meta base format sniffed as tula");
    var A2 = t_alloc(C * rr); var B2 = t_alloc(rr * V); var o = t_alloc(2);
    assert_eq(anuk_adapter_load(apath, pk, A2, B2, C, rr, V, o), 0, "adapter with metadata still loads");
    # a write that can't happen fails cleanly, and a missing source fails the save
    assert_eq(anuk_nf4_save("/nonexistent-dir/x.tula", cfg, params, sk), 0 - 1, "unwritable path -> -1");
    assert_eq(anuk_nf4_save_src(path2, cfg, params, sk, "/tmp/anuk_no_such_source"), 0 - 1,
      "missing source file -> -1");
    return 0;
}

fn main(): i64 {
    alloc_init();
    test_store();
    test_sk_load();
    test_bad_cfg_rejected();
    test_malformed_files();
    test_sk_file_checks();
    test_metadata();
    return assert_summary();
}

var rc = main();
sys_exit(rc);
