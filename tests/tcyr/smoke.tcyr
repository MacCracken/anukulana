# tests/tcyr/smoke.tcyr — anukulana scaffold smoke (M0).
include "src/lib.cyr"
include "lib/assert.cyr"

fn test_version() {
    assert_eq(anukulana_version(), 10201, "version 1.2.1 packs to 10201");
    return 0;
}

fn main(): i64 {
    alloc_init();
    test_version();
    return assert_summary();
}

var rc = main();
syscall(60, rc);
