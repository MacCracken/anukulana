# tests/tcyr/convert.tcyr — 1.5.0: `convert` at source precision, and the loader.
#
# A tiny GPT-2 exported through both foreign doors (tests/common.cyr), converted to
# a signed tula file, and loaded back:
#   * each door's converted file loads onto params bit-identical to that door's
#     direct import (the roadmap's acceptance gate)
#   * the two doors' files hold byte-identical tensors (GGUF's [out, in] weights
#     transposed back exactly), in their source dtype
#   * the metadata, the provenance digest, hf.config and n_head from config.json
#   * same inputs -> byte-identical files
#   * the loader rejects a wrong key, an unsigned file, an NF4 checkpoint, a T_run
#     past the file's context and a misshapen tensor; convert rejects a misshapen
#     source
include "src/lib.cyr"
include "lib/assert.cyr"
include "tests/common.cyr"

# f32-exact fill (small ints over 32)
fn _cv_fill(p, n, seed): i64 {
    var i = 0;
    while (i < n) {
        var m = ((i * 131 + seed * 17 + 7) % 101) - 50;
        store64(p + i * 8, f64_div(f64_from(m), f64_from(32)));
        i = i + 1;
    }
    return 0;
}
fn _cv_slurp(path, out_len): i64 {
    var cap = 16 * 1024 * 1024;
    var buf = alloc(cap);
    store64(out_len, file_read_all(path, buf, cap));
    return buf;
}
fn _cv_meta_is(path, key, want): i64 {
    var r = tula_read_file(path);
    if (r == 0) { return 0; }
    var v = tula_meta_get(r, key);
    if (v == 0) { return 0; }
    return streq(v, want);
}
fn _cv_same_params(a, b, n): i64 {
    if (a == 0 || b == 0) { return n + 1; }          # a failed load: never "identical"
    var d = 0;
    var i = 0;
    while (i < n) { if (load64(a + i * 8) != load64(b + i * 8)) { d = d + 1; } i = i + 1; }
    return d;
}

var _cv_V = 7;
var _cv_C = 8;
var _cv_T = 6;
var _cv_NH = 2;
var _cv_NL = 2;

fn _cv_cfg(): i64 {
    var cfg = alloc(64);
    ru_cfg_init(cfg, _cv_V, _cv_C, _cv_T, _cv_NH, _cv_NH, _cv_NL, 4 * _cv_C, 1);
    return cfg;
}

fn test_convert_doors(): i64 {
    var sk = alloc(64);
    var pk = alloc(32);
    anuk_demo_keypair(sk, pk);
    var cfg = _cv_cfg();
    var np = ru_params_count(cfg);
    var P = t_alloc(np);
    _cv_fill(P, np, 3);
    sys_mkdir("/tmp/anuk_cv_st", 448);
    sys_mkdir("/tmp/anuk_cv_gg", 448);
    # the safetensors door (F32), with a config.json beside it
    var lp = alloc(8);
    var st = _export_gpt2_dt(cfg, P, lp, 1);
    file_write_all("/tmp/anuk_cv_st/model.safetensors", st, load64(lp));
    var cj = "{\"n_head\": 2, \"n_layer\": 2, \"model_type\": \"gpt2\"}";
    file_write_all("/tmp/anuk_cv_st/config.json", cj, strlen(cj));
    var hf = _cv_hf_config("/tmp/anuk_cv_st/model.safetensors");
    assert_nonnull(hf, "config.json beside the model is read");
    assert_eq(anuk_hf_n_head(hf, 12), 2, "n_head read from config.json");
    assert_eq(anuk_hf_n_head(0, 12), 12, "no config.json: the fallback");
    var out_st = "/tmp/anuk_cv_st.tula";
    assert_eq(anuk_convert_safetensors("/tmp/anuk_cv_st/model.safetensors", 2, out_st, sk), 0,
      "safetensors door converts");
    # the converted file loads onto exactly the directly imported params
    var cA = alloc(64);
    var pA = anuk_gpt2_import("/tmp/anuk_cv_st/model.safetensors", 2, 4, cA);
    var cB = alloc(64);
    var pB = anuk_tula_import(out_st, pk, 4, cB);
    assert_nonnull(pB, "the converted file loads");
    assert_eq(_cv_same_params(pA, pB, ru_params_count(cA)), 0, "safetensors door: reload bit-identical");
    var r = tula_read_file(out_st);
    assert_eq(tula_validate_strict(r, tula_total_len(r)), TULA_OK, "converted file is strictly valid");
    assert_eq(tula_entry_dtype(tula_find_name(r, "h.1.mlp.c_fc.weight")), TULA_DT_F32, "source dtype kept (F32)");
    assert_eq(_cv_meta_is(out_st, "anukulana.kind", "model"), 1, "meta kind model");
    assert_eq(_cv_meta_is(out_st, "anukulana.layout", "hf-gpt2"), 1, "meta layout hf-gpt2");
    assert_eq(_cv_meta_is(out_st, "hf.config", cj), 1, "hf.config holds config.json's text");
    var sl = alloc(8);
    var sb = _cv_slurp("/tmp/anuk_cv_st/model.safetensors", sl);
    assert_eq(_cv_meta_is(out_st, "anukulana.source.sha256", sha256_hex(sb, load64(sl))), 1,
      "meta source sha256 = sha256 of the source");
    assert_eq(_cv_meta_is(out_st, "anukulana.config",
        "{\"V\":7,\"C\":8,\"T\":6,\"nh\":2,\"nkv\":2,\"NL\":2,\"F\":32,\"attn_bias\":1}"), 1,
      "meta config keeps the full context (T = 6)");
    # the GGUF door
    var gb = _export_gguf(cfg, P, lp);
    file_write_all("/tmp/anuk_cv_gg/model.gguf", gb, load64(lp));
    var out_gg = "/tmp/anuk_cv_gg.tula";
    assert_eq(anuk_convert_gguf("/tmp/anuk_cv_gg/model.gguf", out_gg, sk), 0, "GGUF door converts");
    var cG = alloc(64);
    var pG = anuk_ggpt2_import("/tmp/anuk_cv_gg/model.gguf", 4, cG);
    var cH = alloc(64);
    var pH = anuk_tula_import(out_gg, pk, 4, cH);
    assert_nonnull(pH, "the GGUF-converted file loads");
    assert_eq(_cv_same_params(pG, pH, ru_params_count(cG)), 0, "GGUF door: reload bit-identical");
    assert_eq(_cv_meta_is(out_gg, "anukulana.source.format", "gguf"), 1, "meta source format gguf");
    # both doors: the same tensors, byte for byte
    var ra = tula_read_file(out_st);
    var rb = tula_read_file(out_gg);
    var name = alloc(64);
    var dims = alloc(16);
    var diff = 0;
    var i = 0;
    while (i < 4 + 12 * _cv_NL) {
        _gpt2_spec(cfg, i, name, dims);
        var ea = tula_find_name(ra, name);
        var eb = tula_find_name(rb, name);
        if (ea == 0 || eb == 0) { diff = diff + 1; }
        elif (tula_entry_data_len(ea) != tula_entry_data_len(eb)) { diff = diff + 1; }
        elif (memeq(tula_entry_data(ra, ea), tula_entry_data(rb, eb), tula_entry_data_len(ea)) != 1) {
            diff = diff + 1;
        }
        i = i + 1;
    }
    assert_eq(diff, 0, "the two doors' files hold byte-identical tensors");
    # same inputs, same bytes
    var out2 = "/tmp/anuk_cv_st2.tula";
    anuk_convert_safetensors("/tmp/anuk_cv_st/model.safetensors", 2, out2, sk);
    var l1 = alloc(8);
    var l2 = alloc(8);
    var f1 = _cv_slurp(out_st, l1);
    var f2 = _cv_slurp(out2, l2);
    assert_eq(load64(l1), load64(l2), "two converts: same length");
    assert_eq(memeq(f1, f2, load64(l1)), 1, "two converts of the same source are byte-identical");
    return 0;
}

fn test_convert_rejects(): i64 {
    var sk = alloc(64);
    var pk = alloc(32);
    anuk_demo_keypair(sk, pk);
    var cfg2 = alloc(64);
    var out_st = "/tmp/anuk_cv_st.tula";
    var bad = alloc(32);
    var k = 0;
    while (k < 32) { store8(bad + k, (k + 61) & 0xFF); k = k + 1; }
    assert_eq(anuk_tula_import(out_st, bad, 4, cfg2), 0, "a wrong key is rejected");
    assert_eq(anuk_tula_import(out_st, pk, 7, cfg2), 0, "T_run past the file's context is rejected");
    # 1.5.1: T_run = 0 is the file's full context (test_full_context); below 0 is refused
    assert_eq(anuk_tula_import(out_st, pk, 0 - 1, cfg2), 0, "a negative T_run is rejected");
    # an NF4 checkpoint is not a converted model
    var cfg = _cv_cfg();
    var np = ru_params_count(cfg);
    var P = t_alloc(np);
    _cv_fill(P, np, 4);
    anuk_nf4_save("/tmp/anuk_cv_nf4.tula", cfg, P, sk);
    assert_eq(anuk_tula_import("/tmp/anuk_cv_nf4.tula", pk, 4, cfg2), 0, "an NF4 checkpoint is rejected");
    # an unsigned file that claims to be a converted model
    var b = tula_builder_new();
    var cfgv = t_alloc(8);
    tula_builder_add_checked(b, "cfg", TULA_DT_F64, _shp1(8), 1, cfgv, 64);
    tula_builder_set_meta(b, "anukulana.kind", "model");
    tula_builder_set_meta(b, "anukulana.layout", "hf-gpt2");
    tula_builder_write_file(b, "/tmp/anuk_cv_unsigned.tula");
    assert_eq(anuk_tula_import("/tmp/anuk_cv_unsigned.tula", pk, 4, cfg2), 0, "an unsigned file is rejected");
    # a signed "model" whose wte has the wrong shape
    var b2 = tula_builder_new();
    store64(cfgv, f64_from(7)); store64(cfgv + 8, f64_from(8)); store64(cfgv + 16, f64_from(6));
    store64(cfgv + 24, f64_from(2)); store64(cfgv + 32, f64_from(2)); store64(cfgv + 40, f64_from(2));
    store64(cfgv + 48, f64_from(32)); store64(cfgv + 56, f64_from(1));
    tula_builder_add_checked(b2, "cfg", TULA_DT_F64, _shp1(8), 1, cfgv, 64);
    tula_builder_add_checked(b2, "wte.weight", TULA_DT_F64, _shp2(8, 7), 2, t_alloc(56), 448);
    tula_builder_set_meta(b2, "anukulana.kind", "model");
    tula_builder_set_meta(b2, "anukulana.layout", "hf-gpt2");
    tula_builder_write_file_signed(b2, "/tmp/anuk_cv_misshapen.tula", sk);
    assert_eq(anuk_tula_import("/tmp/anuk_cv_misshapen.tula", pk, 4, cfg2), 0,
      "a signed model with a misshapen tensor is rejected");
    # convert refuses a source the importer would refuse
    assert_eq(anuk_convert_safetensors("/tmp/anuk_cv_no_such.safetensors", 2, "/tmp/anuk_cv_x.tula", sk), 0 - 1,
      "a missing source fails the convert");
    assert_eq(anuk_convert_safetensors("/tmp/anuk_cv_st/model.safetensors", 3, "/tmp/anuk_cv_x.tula", sk), 0 - 1,
      "nh not dividing C fails the convert");
    assert_eq(anuk_convert_gguf("/tmp/anuk_cv_st/model.safetensors", "/tmp/anuk_cv_x.tula", sk), 0 - 1,
      "a safetensors file given to the GGUF door fails");
    return 0;
}

# 1.5.1: T_run = 0 imports at the file's own context through every door, and that one
# import serves every run length through rupantara 0.6's ru_model_fwd_n: at each n its
# rows are bit-identical to the 1.5.0 path, a repack for T_run = n run by ru_model_fwd.
# Uses the files test_convert_doors wrote.
fn test_full_context(): i64 {
    var sk = alloc(64);
    var pk = alloc(32);
    anuk_demo_keypair(sk, pk);
    var stp = "/tmp/anuk_cv_st/model.safetensors";
    var cS = alloc(64);
    var pS = anuk_gpt2_import(stp, 2, 0, cS);
    var cG = alloc(64);
    var pG = anuk_ggpt2_import("/tmp/anuk_cv_gg/model.gguf", 0, cG);
    var cT = alloc(64);
    var pT = anuk_tula_import("/tmp/anuk_cv_st.tula", pk, 0, cT);
    assert(pS != 0 && pG != 0 && pT != 0, "T_run = 0 imports through all three doors");
    if (pS == 0 || pG == 0 || pT == 0) { return 0; }
    assert_eq(_cfg_T(cS), _cv_T, "safetensors: T_run = 0 keeps the file's context");
    assert_eq(_cfg_T(cG), _cv_T, "GGUF: T_run = 0 keeps the file's context");
    assert_eq(_cfg_T(cT), _cv_T, "tula: T_run = 0 keeps the file's context");
    var np = ru_params_count(cS);
    assert_eq(_cv_same_params(pS, pG, np) + _cv_same_params(pS, pT, np), 0,
      "the three full-context imports are bit-identical, every position row included");
    var V = _cv_V;
    var tokens = _anuk_demo_tokens(_cv_T, V);
    var diffs = 0;
    var rcs = 0;
    var n = 1;
    while (n <= _cv_T) {
        var cN = alloc(64);
        var pN = anuk_gpt2_import(stp, 2, n, cN);         # the 1.5.0 per-length repack
        var LN = alloc(n * V * 8);
        var LF = alloc(n * V * 8);
        rcs = rcs + ru_model_fwd(cN, pN, tokens, LN, 0);
        rcs = rcs + ru_model_fwd_n(cS, pS, tokens, n, LF, 0);
        var i = 0;
        while (i < n * V) { if (load64(LN + i * 8) != load64(LF + i * 8)) { diffs = diffs + 1; } i = i + 1; }
        n = n + 1;
    }
    assert_eq(rcs, 0, "both forwards ran at every run length");
    assert_eq(diffs, 0, "one full-context import + ru_model_fwd_n == a repack per run length, bit for bit");
    var Lb = alloc(_cv_T * V * 8);
    assert_eq(anuk_decode_check_n(cS, pS, tokens, 3, Lb), 0, "decode check over 3 of the 6 positions");
    assert_eq(anuk_decode_check_n(cS, pS, tokens, _cv_T + 1, Lb), RU_ERR_POS(), "n past the context -> RU_ERR_POS");
    assert_eq(anuk_decode_check_n(cS, pS, tokens, 0, Lb), RU_ERR_ARG(), "n = 0 -> RU_ERR_ARG");
    assert_eq(anuk_decode_check(cS, pS, tokens, Lb), 0, "the whole-window decode check, unchanged");
    return 0;
}

# 1.6.0: a quantized GGUF (token_embd and the block weights in type qt) converts to
# F32 tensors holding exactly the dequantized values. Its file loads onto the
# direct import bit for bit, records the type as anukulana.source.quant, and holds
# the same tensors, byte for byte, as the F32 safetensors export of the same params.
fn _cv_quant(qt, lo, hi, qname): i64 { return _cv_quant_c(qt, lo, hi, qname, 32); }
# the same at width C (256 for a K-quant)
fn _cv_quant_c(qt, lo, hi, qname, C): i64 {
    var sk = alloc(64);
    var pk = alloc(32);
    anuk_demo_keypair(sk, pk);
    var cfg = alloc(64);
    ru_cfg_init(cfg, 7, C, 6, 2, 2, 1, 4 * C, 1);
    var np = ru_params_count(cfg);
    var P = t_alloc(np);
    _fillq(P, np, qt, lo, hi);
    sys_mkdir("/tmp/anuk_cvq", 448);
    var lp = alloc(8);
    var gb = _export_gguf_q(cfg, P, lp, qt);
    file_write_all("/tmp/anuk_cvq/model.gguf", gb, load64(lp));
    var st = _export_gpt2_dt(cfg, P, lp, 1);
    file_write_all("/tmp/anuk_cvq/model.safetensors", st, load64(lp));
    var out_q = "/tmp/anuk_cvq_q.tula";
    var out_s = "/tmp/anuk_cvq_s.tula";
    assert_eq(anuk_convert_gguf("/tmp/anuk_cvq/model.gguf", out_q, sk), 0, "a quantized GGUF converts");
    assert_eq(anuk_convert_safetensors("/tmp/anuk_cvq/model.safetensors", 2, out_s, sk), 0,
      "its F32 safetensors twin converts");
    var cG = alloc(64);
    var pG = anuk_ggpt2_import("/tmp/anuk_cvq/model.gguf", 0, cG);
    var cH = alloc(64);
    var pH = anuk_tula_import(out_q, pk, 0, cH);
    assert_nonnull(pH, "the converted quantized file loads");
    assert_eq(_cv_same_params(pG, pH, ru_params_count(cG)), 0, "quantized door: reload bit-identical");
    assert_eq(_cv_same_params(P, pH, np), 0, "and equal to the exported params");
    assert_eq(_cv_meta_is(out_q, "anukulana.source.quant", qname), 1, "meta source.quant names the type");
    assert_eq(_cv_meta_is(out_s, "anukulana.source.quant", qname), 0, "an unquantized source has no source.quant");
    var ra = tula_read_file(out_q);
    var rb = tula_read_file(out_s);
    var packed = 0;
    if (qt == GG_T_Q8_0()) { packed = 1; }
    if (packed == 1) {
        # 1.6.1: Q8_0 stays packed, INT8 codes + an F16 .scale sidecar per weight
        assert_eq(tula_entry_dtype(tula_find_name(ra, "h.0.mlp.c_proj.weight")), TULA_DT_INT8, "Q8_0 kept as INT8");
        var sc = tula_find_name(ra, "h.0.mlp.c_proj.weight.scale");
        assert_nonnull(sc, "with its .scale sidecar");
        assert_eq(tula_entry_dtype(sc), TULA_DT_F16, "the sidecar is F16");
        assert_eq(tula_entry_dim(sc, 0), 4 * C / 32, "c_proj [F, C]: blocks down dim 0 ([F / 32, C])");
        assert_eq(tula_entry_dim(sc, 1), C, "and C wide");
        var ws = tula_find_name(ra, "wte.weight.scale");
        assert_eq(tula_entry_dim(ws, 1), C / 32, "wte [V, C]: blocks along dim 1 ([V, C / 32])");
        assert_eq(tula_entry_dtype(tula_find_name(ra, "h.0.ln_1.weight")), TULA_DT_F32, "norms stay F32");
        assert_eq(_cv_meta_is(out_q, "anukulana.packed", "Q8_0"), 1, "meta packed names Q8_0");
    } else {
        assert_eq(tula_entry_dtype(tula_find_name(ra, "h.0.mlp.c_proj.weight")), TULA_DT_F32, "dequantized to F32");
        assert_eq(_cv_meta_is(out_q, "anukulana.packed", qname), 0, "nothing is packed");
    }
    var name = alloc(64);
    var dims = alloc(16);
    var diff = 0;
    var i = 0;
    while (i < 4 + 12) {
        _gpt2_spec(cfg, i, name, dims);
        var ea = tula_find_name(ra, name);
        var eb = tula_find_name(rb, name);
        var skip = 0;                                # packed: the reload check covers it
        if (ea != 0 && tula_entry_dtype(ea) == TULA_DT_INT8) { skip = 1; }
        if (ea == 0 || eb == 0) { diff = diff + 1; }
        elif (skip == 1) { skip = 0; }
        elif (tula_entry_data_len(ea) != tula_entry_data_len(eb)) { diff = diff + 1; }
        elif (memeq(tula_entry_data(ra, ea), tula_entry_data(rb, eb), tula_entry_data_len(ea)) != 1) {
            diff = diff + 1;
        }
        i = i + 1;
    }
    assert_eq(diff, 0, "the quantized GGUF and the F32 safetensors convert to the same tensors");
    return 0;
}

# 1.6.1: the packed Q8_0 convention read back directly: a [64, 4] INT8 code tensor
# with one scale per 32 codes down dim 0 ([2, 4] scales), a [4, 64] one with them
# along dim 1 ([4, 2]), and a [64] vector ([2]). Codes cycle -3..3 and scales are
# 2^-(s + 1), so each value must be its code times its block's scale. Refused: no
# sidecar, an F32 sidecar, a sidecar of neither shape.
fn _pk_codes(n): i64 {
    var c = alloc(n);
    var i = 0;
    while (i < n) { store8(c + i, ((i % 7) - 3) & 0xFF); i = i + 1; }
    return c;
}
fn _pk_scales(n): i64 {
    var h = alloc(n * 2);
    var i = 0;
    while (i < n) { store16(h + i * 2, 0x3C00 - (i + 1) * 0x400); i = i + 1; }   # 2^-(i+1)
    return h;
}
# the value tensor `nm` should decode to: (k % 7 - 3) * 2^-(si + 1), si per axis
fn _pk_bad(r, nm, d0, d1, axis): i64 {
    var e = tula_find_name(r, nm);
    var n = d0;
    if (d1 != 0) { n = d0 * d1; }
    var out = t_alloc(n);
    if (anuk_tula_read_f64_range(r, e, 0, n, out) != 0) { return n + 1; }
    var w = d1;
    if (d1 == 0) { w = 1; }
    var bad = 0;
    var k = 0;
    while (k < n) {
        var i = k / w;
        var j = k % w;
        var si = (i / 32) * w + j;
        if (axis == 1) { si = i * (w / 32) + j / 32; }
        var want = f64_div(f64_from((k % 7) - 3), f64_from(1 << (si + 1)));
        if (load64(out + k * 8) != want) { bad = bad + 1; }
        k = k + 1;
    }
    var mid = t_alloc(5);                            # an unaligned sub-range
    if (anuk_tula_read_f64_range(r, e, 30, 5, mid) != 0) { return n + 2; }
    var m = 0;
    while (m < 5) { if (load64(mid + m * 8) != load64(out + (30 + m) * 8)) { bad = bad + 1; } m = m + 1; }
    return bad;
}
fn test_packed_q8_convention(): i64 {
    var b = tula_builder_new_cap(16);
    tula_builder_add_checked(b, "a0", TULA_DT_INT8, _nfs_shp2(64, 4), 2, _pk_codes(256), 256);
    tula_builder_add_checked(b, "a0.scale", TULA_DT_F16, _nfs_shp2(2, 4), 2, _pk_scales(8), 16);
    tula_builder_add_checked(b, "a1", TULA_DT_INT8, _nfs_shp2(4, 64), 2, _pk_codes(256), 256);
    tula_builder_add_checked(b, "a1.scale", TULA_DT_F16, _nfs_shp2(4, 2), 2, _pk_scales(8), 16);
    tula_builder_add_checked(b, "v", TULA_DT_INT8, _nfs_shp1(64), 1, _pk_codes(64), 64);
    tula_builder_add_checked(b, "v.scale", TULA_DT_F16, _nfs_shp1(2), 1, _pk_scales(2), 4);
    tula_builder_add_checked(b, "none", TULA_DT_INT8, _nfs_shp1(64), 1, _pk_codes(64), 64);
    tula_builder_add_checked(b, "f32s", TULA_DT_INT8, _nfs_shp1(64), 1, _pk_codes(64), 64);
    tula_builder_add_checked(b, "f32s.scale", TULA_DT_F32, _nfs_shp1(2), 1, _pk_scales(4), 8);
    tula_builder_add_checked(b, "odd", TULA_DT_INT8, _nfs_shp2(64, 4), 2, _pk_codes(256), 256);
    tula_builder_add_checked(b, "odd.scale", TULA_DT_F16, _nfs_shp2(4, 2), 2, _pk_scales(8), 16);
    assert_gt(tula_builder_write_file(b, "/tmp/anuk_pk.tula"), 0, "the packed-convention file writes");
    var r = tula_read_file("/tmp/anuk_pk.tula");
    assert_nonnull(r, "and reads");
    assert_eq(_pk_bad(r, "a0", 64, 4, 0), 0, "[64, 4] with [2, 4] scales: blocks down dim 0");
    assert_eq(_pk_bad(r, "a1", 4, 64, 1), 0, "[4, 64] with [4, 2] scales: blocks along dim 1");
    assert_eq(_pk_bad(r, "v", 64, 0, 0), 0, "a [64] vector with [2] scales");
    var out = t_alloc(256);
    assert_eq(anuk_tula_read_f64_range(r, tula_find_name(r, "none"), 0, 64, out), 0 - 1,
      "INT8 without a sidecar is refused");
    assert_eq(anuk_tula_read_f64_range(r, tula_find_name(r, "f32s"), 0, 64, out), 0 - 1, "an F32 sidecar is refused");
    assert_eq(anuk_tula_read_f64_range(r, tula_find_name(r, "odd"), 0, 256, out), 0 - 1,
      "a sidecar of neither shape is refused");
    return 0;
}

fn test_convert_quant(): i64 {
    _cv_quant(GG_T_Q8_0(), 0 - 50, 50, "Q8_0");
    _cv_quant(GG_T_Q4_0(), 0 - 8, 7, "Q4_0");
    _cv_quant(GG_T_Q4_1(), 0 - 8, 7, "Q4_1");
    _cv_quant(GG_T_Q5_0(), 0 - 16, 15, "Q5_0");
    _cv_quant(GG_T_Q5_1(), 0 - 16, 15, "Q5_1");
    _cv_quant_c(GG_T_Q4_K(), 0 - 8, 7, "Q4_K", 256);       # 1.6.1
    _cv_quant_c(GG_T_Q6_K(), 0 - 32, 31, "Q6_K", 256);
    var mask = (1 << GG_T_Q8_0()) | (1 << GG_T_Q4_0());
    assert(streq(_cv_quant_list(mask), "Q4_0,Q8_0") == 1, "a mixed file lists its types");
    var km = (1 << GG_T_Q6_K()) | (1 << GG_T_Q4_K());
    assert(streq(_cv_quant_list(km), "Q4_K,Q6_K") == 1, "Q4_K_M lists its two types");
    return 0;
}

# 1.6.1: _cv_gg_q8_pack against the GGUF reader, with a different scale per block
# (the GPT-2 round trips use one fixed scale, which no ordering slip would show). A
# raw Q8_0 tensor ne = [64, 3] (3 ggml rows of 64) packs as a Conv1D weight (tr = 1,
# HF [64, 3], scales [2, 3]) and as an embedding (tr = 0, HF [3, 64], scales [3, 2]);
# each must read back through the tula door as the GGUF door reads it.
fn _pk_gg_check(r, e, d0, d1, tr): i64 {
    var codes = alloc(192);
    var scales = alloc(12);
    _cv_gg_q8_pack(r, e, codes, scales, d0, d1, tr);
    var b = tula_builder_new_cap(4);
    tula_builder_add_checked(b, "w", TULA_DT_INT8, _nfs_shp2(d0, d1), 2, codes, 192);
    var ssh = _nfs_shp2(d0 / 32, d1);
    if (tr == 0) { ssh = _nfs_shp2(d0, d1 / 32); }
    tula_builder_add_checked(b, "w.scale", TULA_DT_F16, ssh, 2, scales, 12);
    tula_builder_write_file(b, "/tmp/anuk_pkgg.tula");
    var t = tula_read_file("/tmp/anuk_pkgg.tula");
    if (t == 0) { return 1000; }
    var got = t_alloc(192);
    if (anuk_tula_read_f64_range(t, tula_find_name(t, "w"), 0, 192, got) != 0) { return 1001; }
    var gg = t_alloc(192);                           # ggml order: row o, element i
    gg_read_f64(r, e, gg);
    var bad = 0;
    var i = 0;
    while (i < d0) {
        var j = 0;
        while (j < d1) {
            var want = load64(gg + (i * d1 + j) * 8);            # tr = 0: HF rows are ggml rows
            if (tr == 1) { want = load64(gg + (j * d0 + i) * 8); } # tr = 1: HF (i, o) = ggml (o, i)
            if (load64(got + (i * d1 + j) * 8) != want) { bad = bad + 1; }
            j = j + 1;
        }
        i = i + 1;
    }
    return bad;
}
fn test_q8_pack_orders(): i64 {
    var raw = alloc(6 * 34);
    var bk = 0;
    while (bk < 6) {                                 # scale 2^-(bk + 1), codes (bk * 5 + k) % 9 - 4
        store16(raw + bk * 34, 0x3C00 - (bk + 1) * 0x400);
        var k = 0;
        while (k < 32) { store8(raw + bk * 34 + 2 + k, (((bk * 5 + k) % 9) - 4) & 0xFF); k = k + 1; }
        bk = bk + 1;
    }
    var w = _ggw_new();
    _ggw_add_raw(w, "w", raw, 64, 3, 2, GG_T_Q8_0(), 6 * 34);
    var lp = alloc(8);
    var buf = _ggw_finish(w, 0, 32, 0, lp);
    var r = gg_open(buf, load64(lp));
    assert_nonnull(r, "the raw Q8_0 tensor opens");
    var e = gg_find(r, "w");
    assert_eq(_pk_gg_check(r, e, 64, 3, 1), 0, "packed as a Conv1D weight, it reads as the GGUF door does");
    assert_eq(_pk_gg_check(r, e, 3, 64, 0), 0, "packed as an embedding, likewise");
    return 0;
}

fn main(): i64 {
    alloc_init();
    test_q8_pack_orders();
    test_packed_q8_convention();
    test_convert_quant();
    test_convert_doors();
    test_full_context();
    test_convert_rejects();
    return assert_summary();
}

var rc = main();
sys_exit(rc);
