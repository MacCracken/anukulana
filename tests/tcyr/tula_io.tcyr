# tests/tcyr/tula_io.tcyr — M1: consume tula (weight-file I/O).
# Build a signed tula checkpoint, then load it as untrusted input and exercise
# anukulana's M1 surface: enumerate tensors, verify the signature (and reject a
# wrong key), and confirm a tensor round-trips bit-exact.
include "src/lib.cyr"
include "lib/assert.cyr"

fn test_tula_io(): i64 {
    # ---- a tiny "checkpoint": a 2x2 f64 weight + a length-2 f64 bias ----
    var n = 4;
    var w = alloc(n * 8);
    store64(w + 0 * 8, f64_from(1)); store64(w + 1 * 8, f64_from(2));
    store64(w + 2 * 8, f64_from(3)); store64(w + 3 * 8, f64_from(4));
    var bn = 2;
    var bias = alloc(bn * 8);
    store64(bias + 0 * 8, f64_from(5)); store64(bias + 1 * 8, f64_from(6));

    # ---- Ed25519 keypair (deterministic seed) ----
    var sk = alloc(64);
    var pk = alloc(32);
    var seed = alloc(32);
    var k = 0;
    while (k < 32) { store8(seed + k, (k + 3) & 0xFF); k = k + 1; }
    ed25519_keypair(seed, sk, pk);

    # ---- build + sign ----
    var shapeW = alloc(16);
    store64(shapeW, 2); store64(shapeW + 8, 2);      # 2 x 2
    var shapeB = alloc(8);
    store64(shapeB, bn);
    var b = tula_builder_new();
    tula_builder_add(b, "layer.w", TULA_DT_F64, shapeW, 2, w, n * 8);
    tula_builder_add(b, "layer.b", TULA_DT_F64, shapeB, 1, bias, bn * 8);
    var buf = tula_builder_finish_signed(b, sk);
    var total = tula_total_len(buf);
    var path = "/tmp/anuk_m1_test.tula";
    assert_eq(tula_write_file(path, buf, total), total, "wrote signed tula file");

    # ---- load as untrusted (fresh reader) ----
    var r = tula_read_file(path);
    assert(r != 0, "tula_read_file opened + validated the file");

    # enumerate via anukulana's M1 surface
    assert_eq(anuk_enumerate(r), 2, "anuk_enumerate found 2 tensors");

    # verify: correct pubkey OK, wrong pubkey rejected (tamper/authenticity gate)
    assert_eq(anuk_verify(r, pk), TULA_SIG_OK, "anuk_verify OK with correct pubkey");
    var badpk = alloc(32);
    k = 0;
    while (k < 32) { store8(badpk + k, (k + 99) & 0xFF); k = k + 1; }
    assert(anuk_verify(r, badpk) != TULA_SIG_OK, "anuk_verify rejects a wrong pubkey");

    # tensor round-trips bit-exact through the validated reader
    var ew = tula_find(r, "layer.w");
    assert(ew != 0, "tula_find located layer.w");
    assert_eq(tula_entry_payload_ok(ew), 1, "payload-ok guard passes for layer.w");
    var wp = tula_entry_data(r, ew);
    var ok = 1;
    var i = 0;
    while (i < n) {
        if (load64(wp + i * 8) != load64(w + i * 8)) { ok = 0; }
        i = i + 1;
    }
    assert_eq(ok, 1, "layer.w round-trips bit-exact");
    return 0;
}

# 1.2.2: the print helpers — itoa over every i64 (INT64_MIN printed just "-"
# through 1.2.1), and tula 1.3.0's dtypes named (they printed "?")
fn _itoa_is(n, want): i64 {
    var buf = alloc(32);
    var len = _anuk_itoa(n, buf);
    if (len != strlen(want)) { return 0; }
    return memeq(buf, want, len);
}
fn test_print_helpers(): i64 {
    assert_eq(_itoa_is(0, "0"), 1, "itoa 0");
    assert_eq(_itoa_is(7, "7"), 1, "itoa 7");
    assert_eq(_itoa_is(0 - 42, "-42"), 1, "itoa -42");
    assert_eq(_itoa_is(1234567890123, "1234567890123"), 1, "itoa 1234567890123");
    assert_eq(_itoa_is(0x7FFFFFFFFFFFFFFF, "9223372036854775807"), 1, "itoa INT64_MAX");
    assert_eq(_itoa_is(0x8000000000000000, "-9223372036854775808"), 1, "itoa INT64_MIN");
    assert_eq(streq(_anuk_dtype_name(TULA_DT_F32), "f32"), 1, "dtype name f32");
    assert_eq(streq(_anuk_dtype_name(TULA_DT_F16), "f16"), 1, "dtype name f16");
    assert_eq(streq(_anuk_dtype_name(TULA_DT_BF16), "bf16"), 1, "dtype name bf16");
    return 0;
}

# 1.4.0: `inspect --pk` — the key file loader, verification through
# anuk_inspect_pk, and tula's metadata table kept out of the tensor listing
fn test_inspect_pk(): i64 {
    var sk = alloc(64);
    var pk = alloc(32);
    var seed = alloc(32);
    var k = 0;
    while (k < 32) { store8(seed + k, (k * 9 + 5) & 0xFF); k = k + 1; }
    ed25519_keypair(seed, sk, pk);
    # key files: 32 B public key, 64 B seed||pk, and two bad ones
    file_write_all("/tmp/anuk_pk32.pub", pk, 32);
    file_write_all("/tmp/anuk_pk64.sk", sk, 64);
    file_write_all("/tmp/anuk_pk63.bad", sk, 63);
    var p32 = anuk_pk_load("/tmp/anuk_pk32.pub");
    assert_nonnull(p32, "32-byte public key file loads");
    assert_eq(memeq(p32, pk, 32), 1, "and is the key");
    var p64 = anuk_pk_load("/tmp/anuk_pk64.sk");
    assert_nonnull(p64, "64-byte seed||pk loads");
    assert_eq(memeq(p64, pk, 32), 1, "and yields its public half");
    assert_eq(anuk_pk_load("/tmp/anuk_pk63.bad"), 0, "63-byte file rejected");
    store8(sk + 40, load8(sk + 40) ^ 0xFF);
    file_write_all("/tmp/anuk_pk64bad.sk", sk, 64);
    assert_eq(anuk_pk_load("/tmp/anuk_pk64bad.sk"), 0, "64-byte file whose halves disagree rejected");
    store8(sk + 40, load8(sk + 40) ^ 0xFF);
    # a signed file with metadata, and an unsigned one
    var w = t_alloc(4);
    var shp = alloc(8);
    store64(shp, 4);
    var b = tula_builder_new();
    tula_builder_add_checked(b, "w", TULA_DT_F64, shp, 1, w, 32);
    tula_builder_set_meta(b, "anukulana.kind", "test");
    assert(tula_builder_write_file_signed(b, "/tmp/anuk_pk_signed.tula", sk) > 0, "signed test file written");
    var b2 = tula_builder_new();
    tula_builder_add_checked(b2, "w", TULA_DT_F64, shp, 1, w, 32);
    assert(tula_builder_write_file(b2, "/tmp/anuk_pk_unsigned.tula") > 0, "unsigned test file written");
    assert_eq(anuk_inspect_pk("/tmp/anuk_pk_signed.tula", pk), 1,
      "inspect --pk with the right key: 1 tensor (the metadata table isn't one)");
    var bad = alloc(32);
    k = 0;
    while (k < 32) { store8(bad + k, (k + 77) & 0xFF); k = k + 1; }
    assert_eq(anuk_inspect_pk("/tmp/anuk_pk_signed.tula", bad), 0 - 2, "inspect --pk with a wrong key: -2");
    assert_eq(anuk_inspect_pk("/tmp/anuk_pk_unsigned.tula", pk), 0 - 2, "inspect --pk on an unsigned file: -2");
    assert_eq(anuk_inspect_pk("/tmp/anuk_pk_unsigned.tula", 0), 1, "inspect without --pk still lists it");
    assert_eq(anuk_inspect_pk("/tmp/anuk_no_such_file.tula", 0), 0 - 1, "a missing file: -1");
    return 0;
}

fn main(): i64 {
    alloc_init();
    test_tula_io();
    test_print_helpers();
    test_inspect_pk();
    return assert_summary();
}

var rc = main();
sys_exit(rc);
